diff --git a/chrome/browser/ui/views/frame/browser_view.cc b/chrome/browser/ui/views/frame/browser_view.cc
--- a/chrome/browser/ui/views/frame/browser_view.cc
+++ b/chrome/browser/ui/views/frame/browser_view.cc
@@ -1,5 +1,8 @@
 // SANCHALA: Vertical Tabs and Sidebar Patch

+#include "browser/src/ui/vertical_tabs.h"
+#include "browser/src/ui/sidebar.h"
+
 // Add vertical tabs support
@@ -200,6 +203,20 @@ void BrowserView::InitViews() {
+#ifdef SANCHALA_BROWSER
+  // Initialize vertical tabs
+  if (sanchala_prefs_->GetBoolean(prefs::kVerticalTabsEnabled)) {
+    vertical_tabs_ = std::make_unique<sanchala::VerticalTabs>();
+    vertical_tabs_->SetExpanded(true);
+    AddChildView(vertical_tabs_.get());
+  }
+  
+  // Initialize sidebar
+  if (sanchala_prefs_->GetBoolean(prefs::kSidebarEnabled)) {
+    sidebar_ = std::make_unique<sanchala::Sidebar>();
+    sidebar_->SetPosition(true);  // Left side
+    AddChildView(sidebar_.get());
+  }
+#endif
 }
