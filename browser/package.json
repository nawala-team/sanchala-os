{
  "name": "sanchala-browser",
  "version": "1.0.0",
  "description": "Sanchala Browser - Maximum Security Chromium-based Browser",
  "author": "Sanchala OS Project",
  "license": "MPL-2.0",
  "homepage": "https://sanchala.org/browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/sanchala-os/sanchala-browser"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "./scripts/build.sh",
    "build:release": "./scripts/build.sh --release",
    "build:debug": "./scripts/build.sh --debug",
    "patch": "./scripts/apply-patches.sh",
    "brand": "./scripts/apply-branding.sh",
    "test": "npm run test:unit && npm run test:security",
    "test:unit": "jest --config tests/jest.config.js",
    "test:security": "./tests/security/run-tests.sh",
    "lint": "eslint src/",
    "clean": "./scripts/clean.sh"
  },
  "dependencies": {
    "@aspect-build/aspect": "^1.0.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "typescript": "^5.3.0"
  },
  "browser": {
    "name": "Sanchala",
    "codename": "sanchala",
    "vendor": "Sanchala OS",
    "chromiumVersion": "122.0.6261.0",
    "braveVersion": "1.62.0"
  }
}
