// Plymouth Script for Sanchala OS
// Theme: sanchala | Version: 1.0

// ============================================
// BACKGROUND
// ============================================
Window.SetBackgroundTopColor(0.07, 0.07, 0.07);     // #121212
Window.SetBackgroundBottomColor(0.07, 0.07, 0.07);

// ============================================
// LOGO SETUP
// ============================================
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40);
logo.sprite.SetOpacity(0);

// ============================================
// PROGRESS BAR
// ============================================
progress_box.image = Image("progress-bar-bg.png");
progress_box.sprite = Sprite(progress_box.image);
progress_box.x = Window.GetWidth() / 2 - progress_box.image.GetWidth() / 2;
progress_box.y = Window.GetHeight() / 2 + 60;
progress_box.sprite.SetPosition(progress_box.x, progress_box.y, 0);

progress_bar.original_image = Image("progress-bar.png");
progress_bar.sprite = Sprite();
progress_bar.sprite.SetPosition(progress_box.x, progress_box.y, 1);

// ============================================
// ANIMATION STATE
// ============================================
global.progress = 0;
global.fade_in = 0;
global.glow = 0;

// ============================================
// REFRESH CALLBACK
// ============================================
fun refresh_callback() {
    // Logo fade-in
    if (global.fade_in < 1) {
        global.fade_in += 0.02;
        logo.sprite.SetOpacity(global.fade_in);
    }
    
    // Glow pulse
    global.glow += 0.05;
}

Plymouth.SetRefreshFunction(refresh_callback);

// ============================================
// PROGRESS CALLBACK
// ============================================
fun progress_callback(duration, progress) {
    global.progress = progress;
    
    if (progress_bar.original_image) {
        progress_bar.image = progress_bar.original_image.Scale(
            progress_bar.original_image.GetWidth() * progress,
            progress_bar.original_image.GetHeight()
        );
        progress_bar.sprite.SetImage(progress_bar.image);
    }
}

Plymouth.SetBootProgressFunction(progress_callback);

// ============================================
// MESSAGE DISPLAY
// ============================================
message_sprite = Sprite();
message_sprite.SetPosition(Window.GetWidth() / 2, Window.GetHeight() - 50, 1);

fun message_callback(text) {
    message.image = Image.Text(text, 0.88, 0.88, 0.88, "Inter");
    message_sprite.SetImage(message.image);
    message_sprite.SetX(Window.GetWidth() / 2 - message.image.GetWidth() / 2);
}

Plymouth.SetMessageFunction(message_callback);

// ============================================
// PASSWORD DIALOG
// ============================================
fun display_password_callback(prompt, bullets) {
    progress_box.sprite.SetOpacity(0);
    progress_bar.sprite.SetOpacity(0);
    // Password entry implementation
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
