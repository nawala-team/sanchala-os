#!/bin/bash
# ══════════════════════════════════════════════════════════════════════════════
# SANCHALA OS - Channel Management Tool
# ══════════════════════════════════════════════════════════════════════════════
# Switch between stable, beta, and nightly release channels
# Usage: sanchala-channel {stable|beta|nightly|status}

set -euo pipefail

CONFIG="/etc/pacman.d/sanchala-repos.conf"
MIRRORLIST="/etc/pacman.d/mirrorlist-sanchala"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

print_banner() {
    echo -e "${BLUE}"
    echo "  संञ्चल - Sanchala OS Channel Manager"
    echo -e "${NC}"
}

check_root() {
    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}Error: This script must be run as root${NC}"
        echo "Try: sudo sanchala-channel $*"
        exit 1
    fi
}

get_current_channel() {
    if [[ -f "$CONFIG" ]]; then
        grep -oP 'sanchala-\K[a-z]+' "$CONFIG" 2>/dev/null | head -1 || echo "unknown"
    else
        echo "not-configured"
    fi
}

set_channel() {
    local channel="$1"
    local current
    current=$(get_current_channel)
    
    if [[ "$current" == "$channel" ]]; then
        echo -e "${YELLOW}Already on $channel channel${NC}"
        return 0
    fi
    
    echo -e "${BLUE}Switching from $current to $channel channel...${NC}"
    
    # Update repository configuration
    if [[ -f "$CONFIG" ]]; then
        sed -i "s/sanchala-[a-z]*/sanchala-$channel/g" "$CONFIG"
    else
        # Create config if it doesn't exist
        cat > "$CONFIG" << EOF
# Sanchala OS Repository Configuration
# Channel: $channel
# Generated: $(date -Iseconds)

[sanchala-$channel]
SigLevel = Required DatabaseOptional
Server = https://repo.sanchala.id/$channel/\$arch
Server = https://cdn.sanchala.id/$channel/\$arch
EOF
    fi
    
    # Update mirrorlist
    if [[ -f "$MIRRORLIST" ]]; then
        sed -i "s|\$channel|$channel|g" "$MIRRORLIST"
    fi
    
    # Update /etc/sanchala-release
    if [[ -f /etc/sanchala-release ]]; then
        sed -i "s/SANCHALA_CHANNEL=.*/SANCHALA_CHANNEL=\"$channel\"/" /etc/sanchala-release
    fi
    
    echo -e "${GREEN}✓ Switched to $channel channel${NC}"
    echo ""
    echo "Run 'sudo pacman -Syu' to update your system"
}

show_status() {
    local channel
    channel=$(get_current_channel)
    
    echo "Current channel: ${channel}"
    echo ""
    echo "Channel information:"
    case "$channel" in
        stable)
            echo "  ✓ Stable - Production ready, thoroughly tested"
            echo "  • Updates: Security patches and critical fixes"
            echo "  • Support: Full support available"
            ;;
        beta)
            echo "  ⚡ Beta - Feature complete, community testing"
            echo "  • Updates: Weekly with new features"
            echo "  • Support: Community support"
            ;;
        nightly)
            echo "  ⚠ Nightly - Development builds, may break"
            echo "  • Updates: Daily automated builds"
            echo "  • Support: None (use at own risk)"
            ;;
        *)
            echo "  ? Unknown or not configured"
            ;;
    esac
}

show_help() {
    cat << 'EOF'
Sanchala OS Channel Manager

Usage: sanchala-channel <command> [options]

Commands:
  stable              Switch to stable channel (recommended)
  beta                Switch to beta channel (testing)
  nightly [--force]   Switch to nightly channel (development)
  status              Show current channel
  help                Show this help

Options:
  --i-understand-the-risks    Required for nightly channel

Examples:
  sudo sanchala-channel stable
  sudo sanchala-channel beta
  sudo sanchala-channel nightly --i-understand-the-risks
  sanchala-channel status

After switching channels, run: sudo pacman -Syu
EOF
}

# Main
print_banner

case "${1:-}" in
    stable)
        check_root
        set_channel "stable"
        ;;
    beta)
        check_root
        echo -e "${YELLOW}Note: Beta channel may contain bugs${NC}"
        set_channel "beta"
        ;;
    nightly)
        check_root
        if [[ "${2:-}" != "--i-understand-the-risks" ]]; then
            echo -e "${RED}Error: Nightly channel requires acknowledgment${NC}"
            echo ""
            echo "Nightly builds:"
            echo "  • May break your system"
            echo "  • Have no stability guarantees"
            echo "  • Receive no support"
            echo ""
            echo "To proceed, run:"
            echo "  sudo sanchala-channel nightly --i-understand-the-risks"
            exit 1
        fi
        echo -e "${YELLOW}Warning: Nightly is for developers only${NC}"
        set_channel "nightly"
        ;;
    status)
        show_status
        ;;
    help|--help|-h)
        show_help
        ;;
    "")
        show_status
        echo ""
        echo "Use 'sanchala-channel help' for usage information"
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        echo "Use 'sanchala-channel help' for usage information"
        exit 1
        ;;
esac
