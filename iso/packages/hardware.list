# Printer drivers - comprehensive coverage
gutenprint
foomatic-db
foomatic-db-engine
foomatic-db-gutenprint-ppds
foomatic-db-nonfree
foomatic-db-nonfree-ppds

# HP printers (very common)
hplip

# Brother printers
# brother-mfc (AUR - manual install)

# Canon printers
# cnijfilter2 (AUR - manual install)

# Epson printers
# epson-inkjet-printer-escpr (AUR)
# epson-inkjet-printer-escpr2 (AUR)

# IPP Everywhere (driverless printing)
ipp-usb

# Avahi for network printer discovery
avahi
nss-mdns

