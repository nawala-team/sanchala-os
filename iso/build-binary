# ══════════════════════════════════════════════════════════════════════════
# MAIN
# ══════════════════════════════════════════════════════════════════════════

main() {
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -v|--version)
                ISO_VERSION="$2"
                shift 2
                ;;
            -o|--output)
                OUT_DIR="$2"
                shift 2
                ;;
            -c|--clean)
                CLEAN=true
                shift
                ;;
            -s|--skip-aur)
                SKIP_AUR=true
                shift
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            *)
                log_error "Unknown option: $1\nUse --help for usage information."
                ;;
        esac
    done
    
    print_banner
    
    log_info "Building Sanchala OS ${ISO_VERSION} (${CODENAME})"
    log_info "Architecture: ${ARCH}"
    log_info "Output: ${OUT_DIR}"
    
    local start_time
    start_time=$(date +%s)
    
    # Trap for cleanup on error
    trap 'log_error "Build failed. Check output above for errors."' ERR
    
    check_root
    check_arch_system
    check_dependencies
    prepare_workdir
    install_base_system
    configure_system
    apply_security_hardening
    create_squashfs
    setup_bootloader
    create_iso
    cleanup
    
    local end_time
    end_time=$(date +%s)
    local duration=$((end_time - start_time))
    
    echo ""
    echo -e "${GREEN}══════════════════════════════════════════════════════════════${NC}"
    echo -e "${GREEN}  BUILD COMPLETE!${NC}"
    echo -e "${GREEN}══════════════════════════════════════════════════════════════${NC}"
    echo ""
    echo -e "  ISO: ${OUT_DIR}/${ISO_NAME}-${ISO_VERSION}-${CODENAME}-${ARCH}.iso"
    echo -e "  Time: $((duration / 60)) minutes $((duration % 60)) seconds"
    echo ""
    echo -e "  ${CYAN}संञ्चल - Set Your System in Motion${NC}"
    echo -e "  ${CYAN}Website: https://sanchala.id${NC}"
    echo ""
}

