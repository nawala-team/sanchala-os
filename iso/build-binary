#!/bin/bash
#
# ╔═══════════════════════════════════════════════════════════════════════╗
# ║                    SANCHALA OS - ISO Builder                          ║
# ║                    "Set Your System in Motion"                        ║
# ╚═══════════════════════════════════════════════════════════════════════╝
#
# Usage: sudo ./build-binary [options]
# Options:
#   -v, --version    Set version (default: rolling)
#   -o, --output     Output directory (default: ./out)
#   -c, --clean      Clean build directory before building
#   -s, --skip-aur   Skip AUR packages (for CI builds)
#   -h, --help       Show this help
#
# Requirements:
#   - Arch Linux or Arch-based system
#   - arch-install-scripts, mtools, squashfs-tools, xorriso
#   - e2fsprogs, dosfstools, git, pv, grub, libisoburn
#
# Build artifacts go to OUT_DIR (default: ../out)
#

set -euo pipefail

# ══════════════════════════════════════════════════════════════════════════
# CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════

ISO_NAME="sanchala"
ISO_LABEL="SANCHALA"
ISO_PUBLISHER="Sanchala OS <https://sanchala.id>"
ISO_APPLICATION="Sanchala OS Live/Installer"
ISO_VERSION="${ISO_VERSION:-$(date +%Y.%m.%d)}"
CODENAME="gati"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
WORK_DIR="${WORK_DIR:-/tmp/sanchala-build}"
OUT_DIR="${OUT_DIR:-${PROJECT_ROOT}/out}"
AIROOTFS="${WORK_DIR}/airootfs"

ARCH="x86_64"
CLEAN=false
SKIP_AUR=false
VERBOSE=false

# Sanchala custom repo (if available)
SANCHALA_REPO_URL="${SANCHALA_REPO_URL:-}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# AUR packages that need special handling (not in official repos)
AUR_PACKAGES=(
    "brave-bin"
    "plasma5-applets-window-buttons"
)

# ══════════════════════════════════════════════════════════════════════════
# FUNCTIONS
# ══════════════════════════════════════════════════════════════════════════

print_banner() {
    echo -e "${BLUE}"
    echo "╔═══════════════════════════════════════════════════════════════════════╗"
    echo "║                                                                       ║"
    echo "║            संञ्चल    S A N C H A L A   O S                             ║"
    echo "║                                                                       ║"
    echo "║                    ISO Builder v1.0                                   ║"
    echo "║                    \"Set Your System in Motion\"                       ║"
    echo "║                                                                       ║"
    echo "╚═══════════════════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
}

log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
    exit 1
}

log_step() {
    echo -e "\n${PURPLE}══════════════════════════════════════════════════════════════${NC}"
    echo -e "${PURPLE}  $1${NC}"
    echo -e "${PURPLE}══════════════════════════════════════════════════════════════${NC}\n"
}

check_root() {
    if [[ $EUID -ne 0 ]]; then
        log_error "This script must be run as root (use sudo)"
    fi
}

check_arch_system() {
    if [[ ! -f /etc/arch-release ]]; then
        log_warn "This script is designed for Arch Linux. Proceed with caution on other systems."
    fi
}

check_dependencies() {
    log_step "Checking Dependencies"
    
    local deps=("pacstrap" "arch-chroot" "mksquashfs" "xorriso" "mkfs.fat" "grub-mkrescue" "git")
    local optional_deps=("pv")
    local missing=()
    local missing_optional=()
    
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" &> /dev/null; then
            missing+=("$dep")
        fi
    done
    
    for dep in "${optional_deps[@]}"; do
        if ! command -v "$dep" &> /dev/null; then
            missing_optional+=("$dep")
        fi
    done
    
    if [[ ${#missing[@]} -gt 0 ]]; then
        log_error "Missing required dependencies: ${missing[*]}\nInstall with: sudo pacman -S arch-install-scripts mtools squashfs-tools xorriso dosfstools grub libisoburn git"
    fi
    
    if [[ ${#missing_optional[@]} -gt 0 ]]; then
        log_warn "Missing optional dependencies (build will continue): ${missing_optional[*]}"
    fi
    
    # Check for sufficient disk space (need at least 15GB free in WORK_DIR parent)
    local work_parent
    work_parent="$(dirname "$WORK_DIR")"
    local free_space
    free_space=$(df -BG "$work_parent" 2>/dev/null | awk 'NR==2 {print $4}' | tr -d 'G')
    if [[ -n "$free_space" && "$free_space" -lt 15 ]]; then
        log_warn "Less than 15GB free space in $work_parent. Build may fail."
    fi
    
    log_success "All required dependencies satisfied"
}

is_aur_package() {
    local pkg="$1"
    for aur_pkg in "${AUR_PACKAGES[@]}"; do
        if [[ "$pkg" == "$aur_pkg" ]]; then
            return 0
        fi
    done
    return 1
}

prepare_workdir() {
    log_step "Preparing Work Directory"
    
    if [[ "$CLEAN" == true && -d "$WORK_DIR" ]]; then
        log_warn "Removing existing work directory (--clean specified)..."
        rm -rf "$WORK_DIR"
    elif [[ -d "$WORK_DIR" ]]; then
        log_warn "Work directory exists. Use --clean to start fresh."
        log_info "Continuing with existing work directory..."
    fi
    
    mkdir -p "$WORK_DIR"/{airootfs,iso/{boot/grub,sanchala/${ARCH},EFI/BOOT},work}
    mkdir -p "$OUT_DIR"
    
    log_success "Work directory prepared: $WORK_DIR"
}

install_base_system() {
    log_step "Installing Base System"
    
    log_info "Running pacstrap (this may take a while)..."
    
    # Read package lists, filtering out AUR packages
    local packages=()
    local aur_packages_found=()
    
    for list in "${SCRIPT_DIR}/packages/"*.list; do
        if [[ -f "$list" ]]; then
            while IFS= read -r line || [[ -n "$line" ]]; do
                # Skip comments and empty lines
                line="${line%%#*}"  # Remove inline comments
                line="${line// /}"  # Remove whitespace
                [[ -z "$line" ]] && continue
                
                if is_aur_package "$line"; then
                    aur_packages_found+=("$line")
                    log_warn "Skipping AUR package: $line (must be in Sanchala repo or installed post-build)"
                else
                    packages+=("$line")
                fi
            done < "$list"
        fi
    done
    
    # Remove duplicates
    local unique_packages
    mapfile -t unique_packages < <(printf '%s\n' "${packages[@]}" | sort -u)
    
    log_info "Installing ${#unique_packages[@]} packages from official repos..."
    if [[ ${#aur_packages_found[@]} -gt 0 ]]; then
        log_warn "Skipped ${#aur_packages_found[@]} AUR packages: ${aur_packages_found[*]}"
    fi
    
    # Setup pacman.conf with Sanchala repo if available
    local pacman_conf="/etc/pacman.conf"
    if [[ -n "$SANCHALA_REPO_URL" ]]; then
        log_info "Using Sanchala repository: $SANCHALA_REPO_URL"
        pacman_conf="${WORK_DIR}/pacman.conf"
        cp /etc/pacman.conf "$pacman_conf"
        cat >> "$pacman_conf" << EOF

[sanchala]
SigLevel = Optional TrustAll
Server = ${SANCHALA_REPO_URL}
EOF
    fi
    
    # Run pacstrap with progress indication
    if command -v pv &> /dev/null; then
        pacstrap -C "$pacman_conf" -c -G -M "$AIROOTFS" "${unique_packages[@]}" 2>&1 | pv -l > /dev/null
    else
        pacstrap -C "$pacman_conf" -c -G -M "$AIROOTFS" "${unique_packages[@]}"
    fi
    
    log_success "Base system installed"
}

configure_system() {
    log_step "Configuring System"
    
    # Copy airootfs overlay
    if [[ -d "${SCRIPT_DIR}/airootfs" ]]; then
        log_info "Copying airootfs overlay..."
        cp -af "${SCRIPT_DIR}/airootfs/"* "$AIROOTFS/" 2>/dev/null || true
    fi
    
    # Copy filesystem branding (with existence checks)
    log_info "Installing Sanchala branding..."
    local fs_dir="${PROJECT_ROOT}/filesystem"
    [[ -f "${fs_dir}/os-release" ]] && cp -f "${fs_dir}/os-release" "$AIROOTFS/etc/os-release"
    [[ -f "${fs_dir}/lsb-release" ]] && cp -f "${fs_dir}/lsb-release" "$AIROOTFS/etc/lsb-release"
    [[ -f "${fs_dir}/sanchala-release" ]] && cp -f "${fs_dir}/sanchala-release" "$AIROOTFS/etc/sanchala-release"
    [[ -f "${fs_dir}/issue" ]] && cp -f "${fs_dir}/issue" "$AIROOTFS/etc/issue"
    [[ -f "${fs_dir}/motd" ]] && cp -f "${fs_dir}/motd" "$AIROOTFS/etc/motd"
    
    # Configure locale
    log_info "Configuring locale..."
    echo "en_US.UTF-8 UTF-8" > "$AIROOTFS/etc/locale.gen"
    arch-chroot "$AIROOTFS" locale-gen
    echo "LANG=en_US.UTF-8" > "$AIROOTFS/etc/locale.conf"
    
    # Set timezone (UTC for live, installer will set user's timezone)
    arch-chroot "$AIROOTFS" ln -sf /usr/share/zoneinfo/UTC /etc/localtime
    
    # Set hostname
    echo "sanchala" > "$AIROOTFS/etc/hostname"
    
    # Configure hosts
    cat > "$AIROOTFS/etc/hosts" << EOF
127.0.0.1   localhost
::1         localhost
127.0.1.1   sanchala.localdomain sanchala
EOF
    
    # Enable services (with checks to handle missing services gracefully)
    log_info "Enabling services..."
    local services=(
        "NetworkManager"
        "sddm"
        "apparmor"
        "firewalld"
        "fstrim.timer"
        "bluetooth"
    )
    for service in "${services[@]}"; do
        if arch-chroot "$AIROOTFS" systemctl list-unit-files "${service}*" &>/dev/null; then
            arch-chroot "$AIROOTFS" systemctl enable "$service" 2>/dev/null || \
                log_warn "Could not enable $service (may not be installed)"
        fi
    done
    
    # Create live user
    log_info "Creating live user..."
    arch-chroot "$AIROOTFS" useradd -m -G wheel,audio,video,storage,optical,network,power -s /bin/zsh sanchala 2>/dev/null || \
        log_warn "User 'sanchala' may already exist"
    echo "sanchala:sanchala" | arch-chroot "$AIROOTFS" chpasswd
    echo "root:sanchala" | arch-chroot "$AIROOTFS" chpasswd
    
    # Configure sudo
    mkdir -p "$AIROOTFS/etc/sudoers.d"
    echo "%wheel ALL=(ALL:ALL) NOPASSWD: ALL" > "$AIROOTFS/etc/sudoers.d/wheel"
    chmod 440 "$AIROOTFS/etc/sudoers.d/wheel"
    
    # Set default shell to zsh
    arch-chroot "$AIROOTFS" chsh -s /bin/zsh sanchala 2>/dev/null || true
    
    # Install Calamares installer configuration
    install_calamares_config
    
    log_success "System configured"
}

install_calamares_config() {
    log_info "Installing Calamares configuration..."
    
    local calamares_dir="$AIROOTFS/etc/calamares"
    mkdir -p "$calamares_dir"/{modules,branding/sanchala}
    
    # Copy installer config if available
    if [[ -d "${PROJECT_ROOT}/installer" ]]; then
        [[ -d "${PROJECT_ROOT}/installer/modules" ]] && \
            cp -rf "${PROJECT_ROOT}/installer/modules/"* "$calamares_dir/modules/" 2>/dev/null || true
        [[ -d "${PROJECT_ROOT}/installer/branding/sanchala" ]] && \
            cp -rf "${PROJECT_ROOT}/installer/branding/sanchala/"* "$calamares_dir/branding/sanchala/" 2>/dev/null || true
        [[ -f "${PROJECT_ROOT}/installer/settings.conf" ]] && \
            cp -f "${PROJECT_ROOT}/installer/settings.conf" "$calamares_dir/" 2>/dev/null || true
    fi
}

apply_security_hardening() {
    log_step "Applying Security Hardening"
    
    local sec_dir="${PROJECT_ROOT}/security"
    
    # Copy security configurations
    if [[ -d "$sec_dir" ]]; then
        log_info "Copying security configurations..."
        
        # Kernel hardening sysctl
        if [[ -d "${sec_dir}/kernel" ]]; then
            mkdir -p "$AIROOTFS/etc/sysctl.d"
            cp -f "${sec_dir}/kernel/"*.conf "$AIROOTFS/etc/sysctl.d/" 2>/dev/null || true
        fi
        
        # Module blacklist
        if [[ -d "${sec_dir}/kernel" ]]; then
            mkdir -p "$AIROOTFS/etc/modprobe.d"
            cp -f "${sec_dir}/kernel/"*blacklist*.conf "$AIROOTFS/etc/modprobe.d/" 2>/dev/null || true
        fi
        
        # AppArmor profiles
        if [[ -d "${sec_dir}/apparmor/profiles" ]]; then
            mkdir -p "$AIROOTFS/etc/apparmor.d"
            cp -rf "${sec_dir}/apparmor/profiles/"* "$AIROOTFS/etc/apparmor.d/" 2>/dev/null || true
        fi
        
        # Firewall rules
        if [[ -d "${sec_dir}/firewall" ]]; then
            mkdir -p "$AIROOTFS/etc/firewalld"
            cp -f "${sec_dir}/firewall/"*.conf "$AIROOTFS/etc/firewalld/" 2>/dev/null || true
        fi
    else
        log_warn "Security directory not found at ${sec_dir}"
    fi
    
    # Apply basic hardening even without security configs
    log_info "Applying baseline security settings..."
    mkdir -p "$AIROOTFS/etc/sysctl.d"
    cat > "$AIROOTFS/etc/sysctl.d/99-sanchala-baseline.conf" << 'EOF'
# Sanchala OS baseline security
kernel.dmesg_restrict = 1
fs.suid_dumpable = 0
EOF
    
    log_success "Security hardening applied"
}

create_squashfs() {
    log_step "Creating SquashFS Image"
    
    local squashfs_file="${WORK_DIR}/iso/sanchala/${ARCH}/airootfs.sfs"
    
    # Clean up before creating squashfs
    log_info "Cleaning up temporary files..."
    rm -rf "$AIROOTFS/var/cache/pacman/pkg/"* 2>/dev/null || true
    rm -rf "$AIROOTFS/var/log/"* 2>/dev/null || true
    rm -rf "$AIROOTFS/tmp/"* 2>/dev/null || true
    
    log_info "Compressing root filesystem (this may take a while)..."
    
    mksquashfs "$AIROOTFS" "$squashfs_file" \
        -comp zstd \
        -Xcompression-level 19 \
        -b 1M \
        -noappend \
        -progress
    
    # Create checksum
    log_info "Creating squashfs checksum..."
    sha512sum "$squashfs_file" | cut -d' ' -f1 > "${squashfs_file}.sha512"
    
    log_success "SquashFS image created ($(du -h "$squashfs_file" | cut -f1))"
}

setup_bootloader() {
    log_step "Setting Up Bootloader"
    
    # Copy kernel and initramfs
    log_info "Copying kernel and initramfs..."
    
    # Support both linux-hardened and regular linux kernel
    if [[ -f "$AIROOTFS/boot/vmlinuz-linux-hardened" ]]; then
        cp "$AIROOTFS/boot/vmlinuz-linux-hardened" "${WORK_DIR}/iso/boot/vmlinuz"
        cp "$AIROOTFS/boot/initramfs-linux-hardened.img" "${WORK_DIR}/iso/boot/initramfs.img"
    elif [[ -f "$AIROOTFS/boot/vmlinuz-linux" ]]; then
        log_warn "linux-hardened not found, using standard linux kernel"
        cp "$AIROOTFS/boot/vmlinuz-linux" "${WORK_DIR}/iso/boot/vmlinuz"
        cp "$AIROOTFS/boot/initramfs-linux.img" "${WORK_DIR}/iso/boot/initramfs.img"
    else
        log_error "No kernel found in $AIROOTFS/boot/"
    fi
    
    # Create GRUB config
    log_info "Creating GRUB configuration..."
    mkdir -p "${WORK_DIR}/iso/boot/grub"
    
    cat > "${WORK_DIR}/iso/boot/grub/grub.cfg" << 'GRUBCFG'
# Sanchala OS GRUB Configuration

set default=0
set timeout=10
set pager=1

insmod all_video
insmod gfxterm
insmod png
insmod part_gpt
insmod part_msdos
insmod fat
insmod iso9660

if loadfont /boot/grub/fonts/unicode.pf2; then
    set gfxmode=auto
    terminal_output gfxterm
fi

set color_normal=white/black
set color_highlight=yellow/blue

menuentry "Sanchala OS (Live)" --class sanchala --class gnu-linux {
    set gfxpayload=keep
    linux /boot/vmlinuz archisobasedir=sanchala archisolabel=SANCHALA cow_spacesize=2G quiet splash
    initrd /boot/initramfs.img
}

menuentry "Sanchala OS (Safe Mode)" --class sanchala --class recovery {
    set gfxpayload=keep
    linux /boot/vmlinuz archisobasedir=sanchala archisolabel=SANCHALA nomodeset
    initrd /boot/initramfs.img
}

menuentry "Sanchala OS (Accessibility)" --class sanchala {
    set gfxpayload=keep
    linux /boot/vmlinuz archisobasedir=sanchala archisolabel=SANCHALA accessibility=on
    initrd /boot/initramfs.img
}

menuentry "Boot from first hard disk" --class os {
    insmod chain
    set root=(hd0)
    chainloader +1
}

menuentry "UEFI Firmware Settings" --class settings {
    fwsetup
}

menuentry "Restart" { reboot }
menuentry "Shutdown" { halt }
GRUBCFG
    
    # Setup BIOS boot
    log_info "Setting up BIOS boot..."
    mkdir -p "${WORK_DIR}/iso/boot/grub/i386-pc"
    
    if command -v grub-mkimage &> /dev/null; then
        grub-mkimage -O i386-pc -o "${WORK_DIR}/iso/boot/grub/i386-pc/core.img" \
            -p /boot/grub biosdisk iso9660 part_gpt part_msdos fat normal search configfile linux echo
        
        cat /usr/lib/grub/i386-pc/cdboot.img "${WORK_DIR}/iso/boot/grub/i386-pc/core.img" > \
            "${WORK_DIR}/iso/boot/grub/i386-pc/eltorito.img"
    else
        log_warn "grub-mkimage not found, BIOS boot may not work"
    fi
    
    # Setup EFI
    log_info "Setting up UEFI boot..."
    mkdir -p "${WORK_DIR}/iso/EFI/BOOT"
    
    if command -v grub-mkstandalone &> /dev/null; then
        grub-mkstandalone -O x86_64-efi \
            --modules="part_gpt part_msdos fat iso9660 linux normal search configfile" \
            --locales="" --themes="" --fonts="" \
            -o "${WORK_DIR}/iso/EFI/BOOT/BOOTX64.EFI" \
            "boot/grub/grub.cfg=${WORK_DIR}/iso/boot/grub/grub.cfg"
    else
        log_error "grub-mkstandalone not found. Install grub package."
    fi
    
    # Create efi.img for UEFI boot
    log_info "Creating EFI image..."
    truncate -s 64M "${WORK_DIR}/iso/boot/efi.img"
    mkfs.fat -F 32 -n "SANCHALA_EFI" "${WORK_DIR}/iso/boot/efi.img"
    mmd -i "${WORK_DIR}/iso/boot/efi.img" ::/EFI ::/EFI/BOOT
    mcopy -i "${WORK_DIR}/iso/boot/efi.img" "${WORK_DIR}/iso/EFI/BOOT/BOOTX64.EFI" ::/EFI/BOOT/
    
    log_success "Bootloader setup complete"
}

create_iso() {
    log_step "Creating ISO Image"
    
    local iso_file="${OUT_DIR}/${ISO_NAME}-${ISO_VERSION}-${CODENAME}-${ARCH}.iso"
    
    log_info "Building ISO: ${iso_file}"
    mkdir -p "$OUT_DIR"
    
    xorriso -as mkisofs \
        -iso-level 3 \
        -full-iso9660-filenames \
        -joliet \
        -joliet-long \
        -rational-rock \
        -volid "${ISO_LABEL}" \
        -publisher "${ISO_PUBLISHER}" \
        -appid "${ISO_APPLICATION}" \
        -preparer "Sanchala OS Build System" \
        -eltorito-boot boot/grub/i386-pc/eltorito.img \
        -no-emul-boot \
        -boot-load-size 4 \
        -boot-info-table \
        --eltorito-catalog boot/grub/boot.cat \
        -eltorito-alt-boot \
        -e boot/efi.img \
        -no-emul-boot \
        -isohybrid-gpt-basdat \
        -output "${iso_file}" \
        "${WORK_DIR}/iso"
    
    # Create checksums
    log_info "Creating checksums..."
    pushd "$OUT_DIR" > /dev/null
    local iso_basename
    iso_basename="$(basename "$iso_file")"
    sha256sum "$iso_basename" > "${iso_basename}.sha256"
    sha512sum "$iso_basename" > "${iso_basename}.sha512"
    popd > /dev/null
    
    local iso_size
    iso_size=$(du -h "$iso_file" | cut -f1)
    
    log_success "ISO created: ${iso_file}"
    log_info "ISO Size: ${iso_size}"
}

cleanup() {
    log_step "Cleanup"
    
    # Unmount any lingering mounts
    for mp in proc sys dev; do
        if mountpoint -q "${AIROOTFS}/${mp}" 2>/dev/null; then
            umount -l "${AIROOTFS}/${mp}" 2>/dev/null || true
        fi
    done
    
    if [[ -d "$WORK_DIR" ]]; then
        log_info "Removing work directory..."
        rm -rf "$WORK_DIR"
    fi
    
    log_success "Cleanup complete"
}

