# ============================================================================
# SANCHALA OS - Plasma Notification Center Configuration
# ============================================================================
# Location: ~/.config/plasmanotifyrc
# iOS/macOS-quality notification management system
# Privacy-first, beautiful, non-intrusive notifications
# ============================================================================

[Notifications]
PopupPosition=TopRight
PopupTimeout=5000
MaxPopups=3
LowPriorityPopups=false
LowPriorityHistory=true
BadgesInTaskManager=true
CriticalPopupsInDoNotDisturbMode=true
NormalPopupsInDoNotDisturbMode=false
PopupAnimationDuration=200
GroupNotifications=true
ShowPreviewText=true
MaxBodyLines=3

[Appearance]
UseSystemColors=true
PopupCornerRadius=12
PopupBlurEnabled=true
PopupBlurStrength=40
PopupShadowEnabled=true
PopupShadowSize=8
IconSize=48
CompactModeThreshold=4
ShowAppName=true
ShowTimestamp=true
TimestampFormat=relative

[DoNotDisturb]
Enabled=false
Until=
NotificationSoundsMuted=true
ShowSilently=true
WhenScreensMirrored=true
WhenFullScreen=true
ScheduleEnabled=false
ScheduleStartTime=22:00
ScheduleEndTime=07:00
ScheduleDays=Mon,Tue,Wed,Thu,Fri,Sat,Sun
AllowRepeatedCalls=true
RepeatedCallWindow=180
AllowedContacts=

[FocusModes]
ActiveMode=
AvailableModes=Work,Personal,Sleep,Gaming,Meeting,Driving

[FocusMode][Work]
Enabled=true
DisplayName=Work
Icon=briefcase
Color=#3949AB
AllowedApps=org.kde.kalendar,org.kde.kmail2,slack,microsoft-teams
SilencedApps=discord,telegram,signal
ScheduleEnabled=false
ScheduleStartTime=09:00
ScheduleEndTime=17:00
ScheduleDays=Mon,Tue,Wed,Thu,Fri
ShareFocusStatus=false

[FocusMode][Personal]
Enabled=true
DisplayName=Personal
Icon=user
Color=#00C853
AllowedApps=telegram,signal,discord,whatsapp
SilencedApps=slack,microsoft-teams,org.kde.kmail2
ScheduleEnabled=false
ShareFocusStatus=false

[FocusMode][Sleep]
Enabled=true
DisplayName=Sleep
Icon=moon
Color=#7C4DFF
AllowedApps=
SilencedApps=all
AllowAlarms=true
AllowCriticalAlerts=true
DimLockScreen=true
ScheduleEnabled=true
ScheduleStartTime=22:00
ScheduleEndTime=07:00
ShareFocusStatus=true

[FocusMode][Gaming]
Enabled=true
DisplayName=Gaming
Icon=gamepad
Color=#FF5722
AllowedApps=discord,steam
SilencedApps=all
AutoEnableApps=steam,lutris,heroic
FullScreenOnly=true
ShareFocusStatus=false

[FocusMode][Meeting]
Enabled=true
DisplayName=Meeting
Icon=video
Color=#2196F3
AllowedApps=zoom,microsoft-teams,slack,google-meet
SilencedApps=all
AutoEnableApps=zoom,microsoft-teams,google-meet
AutoDisableOnCallEnd=true
ShareFocusStatus=true

[FocusMode][Driving]
Enabled=true
DisplayName=Driving
Icon=car
Color=#FF9800
AllowedApps=
SilencedApps=all
AllowCriticalAlerts=true
AutoReplyEnabled=true
AutoReplyMessage=I'm driving. I'll respond when I arrive.
ShareFocusStatus=true

[History]
Enabled=true
MaxNotifications=500
MaxAgeDays=7
GroupByApplication=true
ShowActionsInHistory=true
PersistHistory=true
HistoryPath=~/.local/share/sanchala/notifications/history.db
ClearOnLogout=false
ExcludeLowPriority=false
ShowUnreadBadge=true

[Sounds]
Enabled=true
Volume=80
DefaultSound=/usr/share/sounds/sanchala/notifications/default.ogg
CriticalSound=/usr/share/sounds/sanchala/notifications/critical.ogg
MessageSound=/usr/share/sounds/sanchala/notifications/message.ogg
ReminderSound=/usr/share/sounds/sanchala/notifications/reminder.ogg
SystemSound=/usr/share/sounds/sanchala/notifications/system.ogg
UseSystemVolume=true
CriticalBypassMute=true

[CriticalAlerts]
Enabled=true
AlwaysShowPopup=true
BypassDoNotDisturb=true
BypassFocusModes=true
PersistentPopup=true
PlaySound=true
HapticFeedback=true
WakeScreen=true
RepeatSound=false
RepeatInterval=30000
CriticalCategories=security,battery,disk,system-error,emergency

# Per-Application Settings
[Applications][org.kde.plasma-systemmonitor]
ShowPopups=true
ShowInHistory=true
Priority=high
Sounds=true
Category=system

[Applications][org.kde.discover]
ShowPopups=true
ShowInHistory=true
Priority=normal
Sounds=true
Category=system

[Applications][org.kde.powerdevil]
ShowPopups=true
ShowInHistory=true
Priority=high
Sounds=true
Category=battery
CriticalBelowPercent=10

[Applications][org.kde.dolphin]
ShowPopups=true
ShowInHistory=true
Priority=normal
Sounds=false
Category=files

[Applications][org.kde.konsole]
ShowPopups=false
ShowInHistory=true
Priority=low
Sounds=false
Category=development

[Applications][brave-browser]
ShowPopups=true
ShowInHistory=true
Priority=normal
Sounds=true
Category=web
GroupNotifications=true
MaxNotificationsPerSite=3

[Applications][firefox]
ShowPopups=true
ShowInHistory=true
Priority=normal
Sounds=true
Category=web
GroupNotifications=true

[Applications][telegram-desktop]
ShowPopups=true
ShowInHistory=true
Priority=high
Sounds=true
Category=messaging
ShowMessagePreview=true
HideOnLockScreen=true

[Applications][signal-desktop]
ShowPopups=true
ShowInHistory=true
Priority=high
Sounds=true
Category=messaging
HideOnLockScreen=true

[Applications][discord]
ShowPopups=true
ShowInHistory=true
Priority=normal
Sounds=true
Category=messaging

[Applications][slack]
ShowPopups=true
ShowInHistory=true
Priority=normal
Sounds=true
Category=work
HideOnLockScreen=true

[Applications][org.kde.kmail2]
ShowPopups=true
ShowInHistory=true
Priority=normal
Sounds=true
Category=email
HideOnLockScreen=true

[Applications][org.kde.kalendar]
ShowPopups=true
ShowInHistory=true
Priority=high
Sounds=true
Category=calendar

[Applications][steam]
ShowPopups=true
ShowInHistory=true
Priority=low
Sounds=true
Category=gaming
HideInFullScreen=true

# Notification Rules
[Rules]
Enabled=true

[Rules][CriticalSystem]
Enabled=true
Condition=category.equals(system) AND priority.equals(critical)
Action=show
BypassDND=true
PlaySound=true

[Rules][LowBattery]
Enabled=true
Condition=category.equals(battery) AND body.contains(low)
Action=critical
BypassDND=true

[Rules][SecurityAlerts]
Enabled=true
Condition=category.equals(security)
Action=critical
BypassDND=true

[Rules][AntiSpam]
Enabled=true
Condition=app.notificationsInLastMinute > 5
Action=collapse
CollapseMessage={count} notifications from {app}

# Action Buttons
[Actions]
Enabled=true
MaxVisibleActions=3

[Actions][messaging]
DefaultActions=reply,markRead,mute

[Actions][email]
DefaultActions=reply,archive,delete

[Actions][calendar]
DefaultActions=snooze,dismiss,join

[Actions][QuickReply]
Enabled=true
SuggestReplies=true
MaxSuggestions=3

# Notification Grouping
[Grouping]
Enabled=true
GroupByApp=true
GroupByConversation=true
AutoExpandThreshold=3
SummaryFormat={count} notifications
AllowExpand=true

# Privacy Settings
[Privacy]
HideContentOnLockScreen=true
ShowSourceOnLockScreen=true
HideSensitiveOnLockScreen=true
SensitiveCategories=messaging,email,banking,health
ShowScreenShareIndicator=true
HidePreviewsDuringScreenShare=true

# Accessibility
[Accessibility]
ExtendedTimeout=false
ExtendedTimeoutDuration=15000
HighContrast=false
LargeText=false
TextScaleFactor=1.0
ScreenReaderAnnounce=true
ReduceMotion=false
FlashScreen=false

# Integration
[Integration]
KDEConnectEnabled=true
SyncNotificationsFromPhone=true
SyncNotificationsToPhone=false
PhoneCallsAsCritical=true
CalendarRemindersEnabled=true
BrowserNotificationsEnabled=true
