# ============================================
# SANCHALA OS - Krita Quick Edit Profile
# ============================================
# Optimized for screenshot annotation
# ============================================

[General]
# Start in annotation mode
defaultToolOnDocumentCreation=KritaShape/KisToolBrush
# Auto-save disabled for quick edits
autoSaveInterval=0

[Tools]
# Default brush for annotations
defaultPreset=b) Basic-5 Size
# Arrow tool settings
arrowHeadLength=20
arrowHeadWidth=15

[Colors]
# Sanchala accent colors for annotation
foregroundColor=#1a237e
backgroundColor=#ffffff
# Quick palette for annotations
quickPalette=#1a237e,#e91e63,#4caf50,#ff9800,#f44336,#2196f3

[View]
# Clean interface for quick edits
showDockers=false
showScrollbars=false
# Fit to window
defaultZoom=fit
