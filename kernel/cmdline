# ============================================================================
# SANCHALA OS - Kernel Boot Parameters
# ============================================================================
# Version: 1.0 | Kernel: linux-hardened
# Install: Add to GRUB_CMDLINE_LINUX_DEFAULT in /etc/default/grub
# ============================================================================

# ============================================================================
# PRODUCTION CMDLINE (Default for Sanchala OS)
# ============================================================================
CMDLINE_DEFAULT="quiet loglevel=3 rd.systemd.show_status=auto rd.udev.log_priority=3 splash slab_nomerge init_on_alloc=1 init_on_free=1 page_alloc.shuffle=1 pti=on vsyscall=none debugfs=off oops=panic lockdown=confidentiality iommu=force randomize_kstack_offset=on"

# ============================================================================
# PARAMETER REFERENCE
# ============================================================================
# BOOT: quiet loglevel=3 splash         - Clean boot experience
# MEMORY: slab_nomerge init_on_alloc=1  - Memory security
#         init_on_free=1 page_alloc.shuffle=1
# CPU: pti=on                           - Meltdown mitigation
# KERNEL: vsyscall=none debugfs=off     - Attack surface reduction
#         oops=panic lockdown=confidentiality
# DMA: iommu=force                      - DMA attack protection

# ============================================================================
# PRESET CONFIGURATIONS
# ============================================================================

# --- MAXIMUM SECURITY (All hardening) ---
CMDLINE_MAXIMUM="quiet splash slab_nomerge init_on_alloc=1 init_on_free=1 page_alloc.shuffle=1 pti=on vsyscall=none debugfs=off oops=panic module.sig_enforce=1 lockdown=confidentiality iommu=force intel_iommu=on randomize_kstack_offset=on"

# --- PERFORMANCE (Reduced hardening) ---
CMDLINE_PERFORMANCE="quiet splash mitigations=auto pti=on vsyscall=none iommu=force nowatchdog"

# --- DEBUG (Troubleshooting) ---
CMDLINE_DEBUG="loglevel=7 systemd.log_level=debug"

# ============================================================================
# ENCRYPTED ROOT (LUKS2 + Btrfs)
# ============================================================================
