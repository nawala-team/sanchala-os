# ============================================
# SANCHALA OS - WireGuard VPN Template
# ============================================
# Template for WireGuard connections
# Copy and customize for your VPN provider
# ============================================
# Location: /etc/NetworkManager/system-connections/
# Permissions: chmod 600, owned by root
# ============================================

[connection]
id=Sanchala-VPN-Template
uuid=GENERATE-NEW-UUID-HERE
type=wireguard
autoconnect=false
interface-name=wg-sanchala

[wireguard]
# Your WireGuard private key (keep secret!)
private-key=YOUR_PRIVATE_KEY_HERE

# Optional: Listen port (0 = random)
listen-port=0

# MTU setting (adjust for your network)
# Common values: 1420 (default), 1280 (conservative)
mtu=1420

# Firewall mark for policy routing (optional)
# fwmark=0x00

[wireguard-peer.YOUR_PEER_PUBLIC_KEY]
# VPN server's public key
public-key=YOUR_SERVER_PUBLIC_KEY_HERE

# Pre-shared key for post-quantum security (optional but recommended)
# preshared-key=YOUR_PRESHARED_KEY_HERE

# VPN server endpoint
endpoint=vpn.example.com:51820

# What traffic to route through VPN
# 0.0.0.0/0, ::/0 = All traffic (full tunnel)
# 10.0.0.0/8 = Only specific networks (split tunnel)
allowed-ips=0.0.0.0/0;::/0;

# Keepalive for NAT traversal (seconds)
# 25 is a good default for most NAT configurations
persistent-keepalive=25

[ipv4]
# VPN-assigned IPv4 address
address1=10.x.x.x/32
method=manual

# Use VPN's DNS servers
dns=10.x.x.1;
dns-search=

# Route all IPv4 traffic through VPN
never-default=false

[ipv6]
# VPN-assigned IPv6 address (if available)
# address1=fd00::x/128
method=disabled

# Route all IPv6 traffic through VPN
# never-default=false

[proxy]
