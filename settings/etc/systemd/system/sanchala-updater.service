[Unit]
Description=Sanchala OS Update Daemon
Documentation=man:sanchala-updater(8)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/sanchala-updater daemon
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=30

# Security hardening
NoNewPrivileges=no
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/var/lib/sanchala-updater /var/cache/sanchala-updater /var/log

# Resource limits
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle

[Install]
WantedBy=multi-user.target
