[Unit]
Description=Sanchala Backup - Remote Backup Service
Documentation=man:restic(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/sanchala-backup remote backup
User=root
Nice=19
IOSchedulingClass=idle

# Security hardening
ProtectSystem=strict
ReadWritePaths=/var/lib/sanchala /var/log/sanchala /etc/sanchala
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
