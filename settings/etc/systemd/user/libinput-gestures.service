[Unit]
Description=libinput-gestures Gesture Daemon
Documentation=https://github.com/bulletmark/libinput-gestures
After=graphical-session.target
ConditionPathExists=%h/.config/libinput-gestures/libinput-gestures.conf

[Service]
Type=simple
ExecStart=/usr/bin/libinput-gestures
ExecStop=/usr/bin/libinput-gestures --kill
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
