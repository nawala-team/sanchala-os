# ============================================================
# SANCHALA OS - KRunner Configuration
# ============================================================
# Spotlight-like unified search and command launcher
# Meta+Space to activate (macOS-style)
# ============================================================

[General]
FreeFloating=true
ActivateWhenTypingOnDesktop=true
historyBehavior=ImmediateCompletion
RetainPriorSearch=false
historyLength=50

[Appearance]
useSystemTheme=true
maxResults=10
showIcons=true
showDescriptions=true
animationSpeed=150

[Plugins]
applicationsEnabled=true
servicesEnabled=true
baloosearchEnabled=true
locationsEnabled=true
placesEnabled=true
recentdocumentsEnabled=true
calculatorEnabled=true
unitconverterEnabled=true
dictionaryEnabled=true
datetimeEnabled=true
webshortcutsEnabled=true
bookmarksEnabled=true
browserhistoryEnabled=false
plasma-runnerwikipediaEnabled=false
PowerDevilEnabled=true
desktopsessionsEnabled=true
windowsEnabled=true
activitiesEnabled=true
killEnabled=true
shellEnabled=true
appstreamEnabled=false
sshEnabled=true
kdeconnectEnabled=false
plasma-runner-bingEnabled=false

[Plugins][Favorites]
plugins=krunner_services,krunner_systemsettings,krunner_sessions,krunner_powerdevil,krunner_calculator,baloosearch

[Plugins][recentdocuments]
MaximumResults=8

[Plugins][applications]
MaximumResults=10
SearchInDescription=true
SearchInKeywords=true

[Plugins][baloosearch]
MaximumResults=15
SearchInContent=true
SearchInPath=true

[Plugins][calculator]
CopyResultToClipboard=true
DecimalPrecision=10
SupportBaseConversion=true

[Plugins][unitconverter]
EnableCurrency=false

[Plugins][webshortcuts]
DefaultWebShortcut=ddg

[Plugins][shell]
CommandPrefix=>
RunInTerminal=false

[Plugins][kill]
kill-signal=SIGTERM
TriggerWord=kill

[History]
EnableHistory=true
MaxEntries=100
ClearOnLogout=false

[Shortcuts]
RunAction=Return
SecondaryAction=Ctrl+Return
CopyAction=Ctrl+C
