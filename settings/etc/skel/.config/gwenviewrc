# ============================================================
# SANCHALA OS - Gwenview Image Viewer Configuration
# ============================================================
# KDE's powerful image viewer with editing capabilities
# Fast, elegant photo browsing like macOS Preview
# ============================================================

[General]
BackgroundColorMode=1
ThumbnailBarIsVisible=true
ThumbnailBarOrientation=1
FullScreenColorScheme=
HistoryEnabled=true
PercentageOfMemoryUsageWarning=0.5
LastUsedVersion=23
ViewBackgroundValue=100
SortDescending=false
SortKey=Name
ThumbnailDetails=1

[FullScreen]
ShowSideBar=false
ShowToolBar=true
InformationVisible=true
BarHeight=75
SlideShow[$e]=false
SlideShowInterval=5
SlideShowLoop=true
SlideShowRandom=false

[ImageView]
AnimationMethod=DocumentView
AlphaBackgroundColor=#ffffff
AlphaBackgroundMode=1
EnlargeSmallerImages=false
MouseWheelBehavior=0
ZoomMode=1
ThumbnailMargin=5
RenderingIntent=1
ShowLockZoomButton=true

[SideBar]
IsVisible=true
PreferredMetaInfoKeyList=Exif.Image.Make,Exif.Image.Model,Exif.Photo.DateTimeOriginal,Exif.Photo.ExposureTime,Exif.Photo.FNumber,Exif.Photo.ISOSpeedRatings,Exif.Photo.FocalLength,Exif.Photo.Flash,Exif.GPSInfo.GPSLatitude,Exif.GPSInfo.GPSLongitude
ActivePage=information

[Print]
PrintPosition=8
PrintScaleMode=0
PrintEnlargeSmallerImages=false
PrintWidth=15
PrintHeight=10
PrintUnit=1
PrintKeepRatio=true

[ThumbnailView]
ThumbnailSize=160
ThumbnailAspectRatio=3
Spacing=8
GroupByTimezone=true

[StatusBar]
IsVisible=true

[RedEyeReduction]
Diameter=48
UseCustomColor=false
CustomColor=#000000

[Crop]
CropAdvancedSettingsEnabled=true
CropRatioIsConstrained=true
CropRatio=1.33333

[MainWindow]

ToolBarsMovable=Disabled
MenuBar=Disabled
Width 1920=500
Height 1080=700

[Shortcuts]
FileQuit=Ctrl+Q
EditUndo=Ctrl+Z
EditRedo=Ctrl+Shift+Z
ViewZoomIn=Ctrl++
ViewZoomOut=Ctrl+-
ViewActualSize=Ctrl+0
ViewZoomToFit=F
ViewZoomToFill=Shift+F
ViewToggleFullScreen=F11
FileSave=Ctrl+S
FileSaveAs=Ctrl+Shift+S
FilePrint=Ctrl+P
FileOpenContainingFolder=Ctrl+O
GoFirstDocument=Home
GoLastDocument=End
GoPreviousDocument=Left
GoNextDocument=Right
EditCopy=Ctrl+C
EditPaste=Ctrl+V
EditRename=F2
EditMoveToTrash=Del
ViewToggleSideBar=F4
ViewToggleThumbnailBar=F6

[RecentFiles]
maxItems=20

[Semantic Info]
labelVisibility=0
ratingVisibility=1
descriptionVisibility=0

[Exiv2]
EnableMetadataWriting=true

[Slideshow]
Interval=5000
Loop=true
Random=false
StopAtEnd=false
