# ============================================================================
# SANCHALA OS - GDM Fingerprint Login Configuration
# ============================================================================
# Dedicated fingerprint-only login flow for GDM
# ============================================================================

auth        requisite     pam_nologin.so
auth        required      pam_env.so

# Fingerprint authentication only
auth        required      pam_fprintd.so max_tries=5 timeout=30

# Unlock GNOME Keyring (requires password cache or TPM backing)
auth        optional      pam_gnome_keyring.so

# Account verification
account     include       system-auth

# No password change via fingerprint
password    required      pam_deny.so

# Session initialization
session     required      pam_loginuid.so
session     optional      pam_keyinit.so force revoke
session     include       system-auth
session     optional      pam_gnome_keyring.so auto_start
-session    optional      pam_systemd.so
