# Sanchala OS Guest Session PAM
# /etc/pam.d/sanchala-guest

# Authentication - allow guest without password
auth       required   pam_succeed_if.so user = guest quiet
auth       required   pam_permit.so

# Account - allow guest account
account    required   pam_permit.so

# Session setup
session    required   pam_limits.so
session    required   pam_systemd.so
session    required   pam_exec.so /usr/lib/sanchala/guest-session-start
session    optional   pam_umask.so umask=077
session    optional   pam_env.so

# Password - deny password changes for guest
password   required   pam_deny.so
