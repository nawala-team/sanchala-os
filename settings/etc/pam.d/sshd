# ============================================================================
# SANCHALA OS - SSH Authentication
# ============================================================================
# Secure shell access with FIDO2 and password
# Note: Fingerprint not available for remote SSH
# ============================================================================

# FIDO2 hardware key (if forwarded or local)
auth        sufficient    pam_u2f.so cue authfile=/etc/sanchala/identity/u2f_keys

# Standard password authentication
auth        required      pam_faillock.so preauth silent deny=5 unlock_time=900
auth        required      pam_unix.so try_first_pass
auth        required      pam_faillock.so authfail deny=5 unlock_time=900
auth        required      pam_env.so

# Deny access during maintenance
auth        required      pam_nologin.so

# Account management
account     required      pam_faillock.so
account     required      pam_unix.so
account     required      pam_time.so

# Password changes
password    include       system-auth

# Session
session     required      pam_loginuid.so
session     required      pam_limits.so
session     required      pam_unix.so
session     optional      pam_motd.so
session     optional      pam_mail.so standard
-session    optional      pam_systemd.so
