# ============================================================================
# SANCHALA OS - SDDM Login Configuration
# ============================================================================
# KDE/SDDM display manager with biometric support
# ============================================================================

auth        requisite     pam_nologin.so
auth        required      pam_env.so

# Fingerprint authentication
auth        sufficient    pam_fprintd.so max_tries=3 timeout=15

# FIDO2 key support
auth        sufficient    pam_u2f.so cue authfile=/etc/sanchala/identity/u2f_keys

# Password with lockout
auth        required      pam_faillock.so preauth silent deny=5 unlock_time=900
auth        required      pam_unix.so try_first_pass nullok
auth        required      pam_faillock.so authfail deny=5 unlock_time=900

# KWallet unlock
auth        optional      pam_kwallet5.so

# Account management
account     required      pam_faillock.so
account     include       system-auth

# Password
password    include       system-auth

# Session
session     required      pam_loginuid.so
session     include       system-auth
session     optional      pam_kwallet5.so auto_start
-session    optional      pam_systemd.so
