# ============================================
# SANCHALA OS - GPU udev Rules
# ============================================
# Proper permissions and configuration for GPUs
# ============================================

# ===========================================
# DRM (Direct Rendering Manager) Access
# ===========================================
# Allow video group access to GPU render nodes
KERNEL=="renderD[0-9]*", SUBSYSTEM=="drm", MODE="0666"
KERNEL=="card[0-9]*", SUBSYSTEM=="drm", MODE="0666"

# ===========================================
# AMD GPU
# ===========================================
# AMD GPU power management
ACTION=="add", SUBSYSTEM=="drm", KERNEL=="card[0-9]*", DRIVERS=="amdgpu", ATTR{device/power_dpm_force_performance_level}="auto"

# ===========================================
# Intel GPU
# ===========================================
# Intel GPU enable GuC/HuC firmware
ACTION=="add", SUBSYSTEM=="drm", KERNEL=="card[0-9]*", DRIVERS=="i915", RUN+="/usr/bin/sh -c 'echo 3 > /sys/module/i915/parameters/enable_guc 2>/dev/null || true'"

# ===========================================
# NVIDIA GPU
# ===========================================
# NVIDIA power management for laptops
ACTION=="add", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{class}=="0x030000", TEST=="power/control", ATTR{power/control}="auto"

# ===========================================
# Backlight Control
# ===========================================
# Allow video group to control backlight
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness"
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"

# ===========================================
# DDC/CI for Monitor Control
# ===========================================
# Allow i2c access for ddcutil
KERNEL=="i2c-[0-9]*", GROUP="i2c", MODE="0660"
