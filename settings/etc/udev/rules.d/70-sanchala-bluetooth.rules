# ============================================================================
# SANCHALA OS - Bluetooth udev Rules
# ============================================================================
# Fast device detection, proper permissions, power management
# ============================================================================

# -----------------------------------------------------------------------------
# Bluetooth Adapter Power Management
# -----------------------------------------------------------------------------
# Keep Bluetooth adapter awake for instant connection
ACTION=="add", SUBSYSTEM=="bluetooth", KERNEL=="hci*", \
    RUN+="/usr/bin/btmgmt --index %n power on"

# Disable autosuspend for USB Bluetooth adapters (prevents connection issues)
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="*", ATTR{bDeviceClass}=="e0", ATTR{bDeviceSubClass}=="01", \
    ATTR{power/autosuspend}="-1", ATTR{power/control}="on"

# Intel Bluetooth adapters
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="8087", \
    ATTR{power/autosuspend}="-1"

# Realtek Bluetooth adapters
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0bda", \
    ATTR{power/autosuspend}="-1"

# Qualcomm/Atheros Bluetooth adapters
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0cf3", \
    ATTR{power/autosuspend}="-1"

# Broadcom Bluetooth adapters
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0a5c", \
    ATTR{power/autosuspend}="-1"

# MediaTek Bluetooth adapters
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0e8d", \
    ATTR{power/autosuspend}="-1"

# -----------------------------------------------------------------------------
# Bluetooth Device Permissions
# -----------------------------------------------------------------------------
# Allow users in 'bluetooth' group to access BT devices
SUBSYSTEM=="bluetooth", GROUP="bluetooth", MODE="0660"

# uinput for Bluetooth input devices
KERNEL=="uinput", SUBSYSTEM=="misc", MODE="0660", GROUP="input"

# rfkill for enabling/disabling Bluetooth
KERNEL=="rfkill", SUBSYSTEM=="misc", MODE="0664", GROUP="rfkill"

# -----------------------------------------------------------------------------
# Fast Reconnection
# -----------------------------------------------------------------------------
# Trigger reconnection attempt when adapter is ready
ACTION=="add", SUBSYSTEM=="bluetooth", KERNEL=="hci*", \
    TAG+="systemd", ENV{SYSTEMD_WANTS}="sanchala-bt-autoconnect@%k.service"

# -----------------------------------------------------------------------------
# Game Controllers via Bluetooth
# -----------------------------------------------------------------------------
# Sony DualShock 4
ACTION=="add", SUBSYSTEM=="input", ATTRS{name}=="*Wireless Controller*", \
    MODE="0666", TAG+="uaccess"

# Sony DualSense (PS5)
ACTION=="add", SUBSYSTEM=="input", ATTRS{name}=="*DualSense*", \
    MODE="0666", TAG+="uaccess"

# Xbox Wireless Controller
ACTION=="add", SUBSYSTEM=="input", ATTRS{name}=="*Xbox*Controller*", \
    MODE="0666", TAG+="uaccess"

# Nintendo Switch Pro Controller
ACTION=="add", SUBSYSTEM=="input", ATTRS{name}=="*Pro Controller*", \
    MODE="0666", TAG+="uaccess"

# 8BitDo Controllers
ACTION=="add", SUBSYSTEM=="input", ATTRS{name}=="*8BitDo*", \
    MODE="0666", TAG+="uaccess"
