[%General]
author=Sanchala OS Team
comment=Sanchala Dark Kvantum theme for Qt applications
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
mirror_doc_tabs=true
composite=true
menu_shadow_depth=8
tooltip_shadow_depth=6
splitter_width=1
scroll_width=12
scroll_arrows=false
slider_width=6
slider_handle_width=22
slider_handle_length=22
check_size=18
progressbar_thickness=6
menubar_mouse_tracking=true
toolbutton_style=1
translucent_windows=true
blurring=true
popup_blurring=true
animate_states=true
button_contents_shift=false
combo_menu=true
scrollable_menu=true
transient_scrollbar=true
joined_inactive_tabs=true
layout_spacing=3
layout_margin=6
reduce_window_opacity=10
reduce_menu_opacity=5
