#!/bin/bash
# ============================================
# SANCHALA OS - Screenshot Share Tool
# ============================================
# Quick share screenshots to various destinations
# Usage: sanchala-share [image_file] [--destination]
# ============================================

set -euo pipefail

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/sanchala/screenshot-share.conf"
SCREENSHOT_DIR="${HOME}/Pictures/Screenshots"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

usage() {
    cat << EOF
SANCHALA OS - Screenshot Share Tool

Usage: $(basename "$0") [OPTIONS] [IMAGE_FILE]

Options:
    -c, --clipboard     Copy to clipboard (default)
    -f, --file          Save to file
    -i, --imgur         Upload to Imgur (anonymous)
    -e, --email         Send via email
    -p, --print         Print screenshot
    -d, --destination   Show destination picker
    -h, --help          Show this help

Examples:
    $(basename "$0") screenshot.png -c    # Copy to clipboard
    $(basename "$0") -i screenshot.png    # Upload to Imgur
EOF
    exit 0
}

check_deps() {
    local missing=()
    command -v wl-copy >/dev/null 2>&1 || missing+=("wl-clipboard")
    command -v notify-send >/dev/null 2>&1 || missing+=("libnotify")
    command -v curl >/dev/null 2>&1 || missing+=("curl")
    
    if [[ ${#missing[@]} -gt 0 ]]; then
        echo -e "${RED}Error: Missing dependencies: ${missing[*]}${NC}" >&2
        exit 1
    fi
}

notify() {
    local title="$1" message="$2" icon="${3:-emblem-shared}"
    command -v notify-send >/dev/null 2>&1 && \
        notify-send -i "$icon" -a "Sanchala Share" "$title" "$message"
}

share_clipboard() {
    local image="$1"
    if [[ "$XDG_SESSION_TYPE" == "wayland" ]]; then
        wl-copy -t image/png < "$image"
    else
        xclip -selection clipboard -t image/png < "$image"
    fi
    echo -e "${GREEN}✓ Image copied to clipboard${NC}"
    notify "Copied to Clipboard" "Screenshot ready to paste" "edit-copy"
}

share_file() {
    local image="$1"
    local filename=$(date +"%Y-%m-%d_%H-%M-%S").png
    local dest="$SCREENSHOT_DIR/$filename"
    
    if command -v kdialog >/dev/null 2>&1; then
        dest=$(kdialog --getsavefilename "$dest" "*.png|Images" 2>/dev/null) || return 0
    fi
    
    mkdir -p "$(dirname "$dest")"
    cp "$image" "$dest"
    echo -e "${GREEN}✓ Saved to: $dest${NC}"
    notify "Screenshot Saved" "$dest" "document-save"
    echo -n "$dest" | wl-copy
}

share_imgur() {
    local image="$1"
    echo -e "${BLUE}Uploading to Imgur...${NC}"
    
    local response=$(curl -s -X POST \
        -H "Authorization: Client-ID c9a6efb3d7932fd" \
        -F "image=@$image" "https://api.imgur.com/3/upload" 2>/dev/null)
    
    local success=$(echo "$response" | grep -o '"success":[^,]*' | cut -d: -f2)
    
    if [[ "$success" == "true" ]]; then
        local link=$(echo "$response" | grep -o '"link":"[^"]*"' | cut -d'"' -f4 | sed 's/\\//g')
        echo -n "$link" | wl-copy
        echo -e "${GREEN}✓ Uploaded: $link${NC}"
        notify "Uploaded to Imgur" "Link copied: $link" "internet-services"
    else
        echo -e "${RED}✗ Upload failed${NC}"
        notify "Upload Failed" "Could not upload to Imgur" "dialog-error"
        return 1
    fi
}

share_email() {
    local image="$1"
    if command -v xdg-email >/dev/null 2>&1; then
        xdg-email --attach "$image" --subject "Screenshot: $(basename "$image")"
        notify "Email" "Opening email client" "mail-send"
    else
        echo -e "${YELLOW}No email client found${NC}"
        return 1
    fi
}

share_print() {
    local image="$1"
    if command -v lp >/dev/null 2>&1; then
        lp "$image"
        notify "Printing" "Sent to printer" "printer"
    else
        echo -e "${RED}No print command available${NC}"
        return 1
    fi
}

show_picker() {
    local image="$1"
    if command -v kdialog >/dev/null 2>&1; then
        local choice=$(kdialog --menu "Share Screenshot" \
            "clipboard" "Copy to Clipboard" \
            "file" "Save to File" \
            "imgur" "Upload to Imgur" \
            "email" "Send via Email" \
            "print" "Print" 2>/dev/null) || return 0
        
        case "$choice" in
            clipboard) share_clipboard "$image" ;;
            file) share_file "$image" ;;
            imgur) share_imgur "$image" ;;
            email) share_email "$image" ;;
            print) share_print "$image" ;;
        esac
    fi
}

main() {
    local image_file="" destination="clipboard" show_picker_flag=false
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -c|--clipboard) destination="clipboard"; shift ;;
            -f|--file) destination="file"; shift ;;
            -i|--imgur) destination="imgur"; shift ;;
            -e|--email) destination="email"; shift ;;
            -p|--print) destination="print"; shift ;;
            -d|--destination) show_picker_flag=true; shift ;;
            -h|--help) usage ;;
            -*) echo -e "${RED}Unknown option: $1${NC}" >&2; usage ;;
            *) image_file="$1"; shift ;;
        esac
    done
    
    check_deps
    
    if [[ -z "$image_file" ]]; then
        image_file=$(mktemp --suffix=.png)
        wl-paste -t image/png > "$image_file" 2>/dev/null || {
            echo -e "${RED}Error: No image provided${NC}" >&2
            rm -f "$image_file"; exit 1
        }
    fi
    
    [[ ! -f "$image_file" ]] && { echo -e "${RED}Error: File not found${NC}" >&2; exit 1; }
    
    if [[ "$show_picker_flag" == true ]]; then
        show_picker "$image_file"
    else
        case "$destination" in
            clipboard) share_clipboard "$image_file" ;;
            file) share_file "$image_file" ;;
            imgur) share_imgur "$image_file" ;;
            email) share_email "$image_file" ;;
            print) share_print "$image_file" ;;
        esac
    fi
}

main "$@"
