{
  "_comment": "SANCHALA OS - Network Service Seccomp Profile",
  "_version": "2.0", 
  "_description": "Restrictive seccomp filter for network daemons",
  "defaultAction": "SCMP_ACT_ERRNO",
  "defaultErrnoRet": 1,
  "archMap": [
    {
      "architecture": "SCMP_ARCH_X86_64",
      "subArchitectures": ["SCMP_ARCH_X86", "SCMP_ARCH_X32"]
    },
    {
      "architecture": "SCMP_ARCH_AARCH64", 
      "subArchitectures": ["SCMP_ARCH_ARM"]
    }
  ],
  "syscalls": [
    {
      "names": [
        "read", "write", "readv", "writev", "pread64", "pwrite64",
        "open", "openat", "close",
        "stat", "fstat", "lstat", "newfstatat",
        "poll", "ppoll", "select", "pselect6",
        "lseek", "mmap", "mprotect", "munmap", "brk",
        "ioctl", "access", "faccessat",
        "pipe", "pipe2", "dup", "dup2",
        "socket", "connect", "accept", "accept4",
        "sendto", "recvfrom", "sendmsg", "recvmsg",
        "shutdown", "bind", "listen", "getsockname", "getpeername",
        "setsockopt", "getsockopt",
        "clone", "fork", "execve",
        "exit", "exit_group", "wait4",
        "kill", "tgkill",
        "uname", "getuid", "getgid", "geteuid", "getegid",
        "getpid", "getppid", "gettid",
        "fcntl", "flock", "fsync",
        "getdents", "getdents64", "getcwd", "chdir",
        "umask", "gettimeofday", "getrlimit",
        "rt_sigaction", "rt_sigprocmask", "rt_sigreturn",
        "nanosleep", "clock_gettime",
        "futex", "set_robust_list",
        "epoll_create1", "epoll_ctl", "epoll_wait", "epoll_pwait",
        "eventfd2", "timerfd_create", "timerfd_settime",
        "prctl", "arch_prctl", "set_tid_address",
        "sched_yield", "getrandom", "statfs"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "names": ["socket"],
      "action": "SCMP_ACT_ALLOW",
      "args": [
        {"index": 0, "value": 2, "op": "SCMP_CMP_EQ"},
        {"index": 1, "value": 1, "op": "SCMP_CMP_EQ"}
      ],
      "comment": "Allow AF_INET SOCK_STREAM only"
    },
    {
      "names": ["socket"],
      "action": "SCMP_ACT_ALLOW",
      "args": [
        {"index": 0, "value": 10, "op": "SCMP_CMP_EQ"},
        {"index": 1, "value": 1, "op": "SCMP_CMP_EQ"}
      ],
      "comment": "Allow AF_INET6 SOCK_STREAM only"
    }
  ]
}
