#!/bin/bash
# ============================================
# SANCHALA OS - Gaming Mode Manager
# ============================================
# Manage gaming optimizations and game mode
# ============================================

set -euo pipefail

VERSION="1.0.0"
CONFIG_DIR="/etc/sanchala/gaming"
USER_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/sanchala/gaming"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/sanchala-gaming"
LOG_FILE="/var/log/sanchala-gaming.log"
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Logging
log() {
    local level="$1"; shift
    local message="$*"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    echo "[$timestamp] [$level] $message" >> "$LOG_FILE" 2>/dev/null || true
    
    case "$level" in
        INFO)  echo -e "${GREEN}[INFO]${NC} $message" ;;
        WARN)  echo -e "${YELLOW}[WARN]${NC} $message" ;;
        ERROR) echo -e "${RED}[ERROR]${NC} $message" ;;
        DEBUG) [[ "${DEBUG:-0}" == "1" ]] && echo -e "${CYAN}[DEBUG]${NC} $message" ;;
    esac
}

# Source library functions
for lib in "$SCRIPT_DIR/../lib"/*.sh; do
    [[ -f "$lib" ]] && source "$lib"
done

# Ensure directories exist
mkdir -p "$USER_CONFIG_DIR" "$CACHE_DIR"

# Main command handler
case "${1:-help}" in
    start)          gamemode_start ;;
    stop)           gamemode_stop ;;
    status)         gamemode_status ;;
    toggle)         pgrep -x gamemoded &>/dev/null && gamemode_stop || gamemode_start ;;
    launch)         shift; game_launch "$@" ;;
    gamescope)      shift; launch_gamescope "$@" ;;
    proton-config)  proton_configure "${2:-}" ;;
    proton-ge)      proton_ge_install ;;
    wine-prefix)    wine_create_prefix "${2:-default}" "${3:-win64}" ;;
    controllers)    controller_status ;;
    gpu|gpu-info)   gpu_info ;;
    steam-optimize) steam_optimize ;;
    overlay)        overlay_help ;;
    help|--help|-h) show_help ;;
    *)              echo "Unknown command: $1"; show_help; exit 1 ;;
esac
