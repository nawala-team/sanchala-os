#!/bin/bash
# ============================================
# SANCHALA OS - Audio Mode Switcher
# ============================================
# Switch between desktop, pro-audio, and
# power-saving audio configurations
# ============================================

set -e

PIPEWIRE_CONF_DIR="/etc/pipewire/pipewire.conf.d"
SANCHALA_AUDIO_STATE="/var/lib/sanchala/audio-mode"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

print_status() {
    echo -e "${GREEN}[✓]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[!]${NC} $1"
}

print_error() {
    echo -e "${RED}[✗]${NC} $1"
}

print_info() {
    echo -e "${BLUE}[i]${NC} $1"
}

usage() {
    cat << EOF
SANCHALA OS Audio Mode Switcher

Usage: sanchala-audio-mode [MODE]

Modes:
  desktop     Standard desktop mode (5.33ms latency, balanced)
  pro         Pro audio mode (1.33ms latency, ultra-low)
  powersave   Power saving mode (10.67ms latency, efficient)
  gaming      Gaming mode (2.67ms latency, optimized)
  status      Show current audio mode and stats

Examples:
  sanchala-audio-mode pro        # Switch to pro audio mode
  sanchala-audio-mode status     # Show current configuration

EOF
}

get_current_mode() {
    if [[ -f "$SANCHALA_AUDIO_STATE" ]]; then
        cat "$SANCHALA_AUDIO_STATE"
    else
        echo "desktop"
    fi
}

get_current_quantum() {
    pw-metadata -n settings 2>/dev/null | grep clock.force-quantum | awk '{print $4}' | tr -d "'" || echo "256"
}

get_current_rate() {
    pw-metadata -n settings 2>/dev/null | grep clock.force-rate | awk '{print $4}' | tr -d "'" || echo "48000"
}

calculate_latency() {
    local quantum=$1
    local rate=$2
    echo "scale=2; $quantum / $rate * 1000" | bc
}

set_mode_desktop() {
    print_info "Switching to Desktop mode..."
    
    # Set quantum to 256 (5.33ms @ 48kHz)
    pw-metadata -n settings 0 clock.force-quantum 256
    pw-metadata -n settings 0 clock.force-rate 48000
    
    # Standard RT priority
    pw-metadata -n settings 0 clock.rate 48000
    
    echo "desktop" | sudo tee "$SANCHALA_AUDIO_STATE" > /dev/null
    
    print_status "Desktop mode active"
    print_info "Quantum: 256, Rate: 48000Hz, Latency: ~5.33ms"
}

set_mode_pro() {
    print_info "Switching to Pro Audio mode..."
    print_warning "This mode requires low-latency kernel or realtime privileges"
    
    # Check for realtime privileges
    if ! groups | grep -q "realtime\|audio"; then
        print_warning "User not in 'realtime' or 'audio' group - latency may be higher"
    fi
    
    # Set quantum to 64 (1.33ms @ 48kHz)
    pw-metadata -n settings 0 clock.force-quantum 64
    pw-metadata -n settings 0 clock.force-rate 48000
    pw-metadata -n settings 0 clock.min-quantum 16
    pw-metadata -n settings 0 clock.max-quantum 256
    
    echo "pro" | sudo tee "$SANCHALA_AUDIO_STATE" > /dev/null
    
    print_status "Pro Audio mode active"
    print_info "Quantum: 64, Rate: 48000Hz, Latency: ~1.33ms"
    print_info "For best results, use a USB audio interface"
}

set_mode_powersave() {
    print_info "Switching to Power Saving mode..."
    
    # Set quantum to 512 (10.67ms @ 48kHz)
    pw-metadata -n settings 0 clock.force-quantum 512
    pw-metadata -n settings 0 clock.force-rate 48000
    
    echo "powersave" | sudo tee "$SANCHALA_AUDIO_STATE" > /dev/null
    
    print_status "Power Saving mode active"
    print_info "Quantum: 512, Rate: 48000Hz, Latency: ~10.67ms"
}

set_mode_gaming() {
    print_info "Switching to Gaming mode..."
    
    # Set quantum to 128 (2.67ms @ 48kHz)
    pw-metadata -n settings 0 clock.force-quantum 128
    pw-metadata -n settings 0 clock.force-rate 48000
    
    echo "gaming" | sudo tee "$SANCHALA_AUDIO_STATE" > /dev/null
    
    print_status "Gaming mode active"
    print_info "Quantum: 128, Rate: 48000Hz, Latency: ~2.67ms"
}

show_status() {
    echo "============================================"
    echo "SANCHALA OS Audio Status"
    echo "============================================"
    echo ""
    
    local mode=$(get_current_mode)
    local quantum=$(get_current_quantum)
    local rate=$(get_current_rate)
    local latency=$(calculate_latency "$quantum" "$rate")
    
    echo -e "Current Mode:    ${GREEN}${mode}${NC}"
    echo -e "Sample Rate:     ${rate} Hz"
    echo -e "Quantum:         ${quantum} samples"
    echo -e "Buffer Latency:  ${latency} ms"
    echo ""
    
    # PipeWire status
    echo "PipeWire Status:"
    if systemctl --user is-active pipewire.service &>/dev/null; then
        echo -e "  pipewire.service:      ${GREEN}active${NC}"
    else
        echo -e "  pipewire.service:      ${RED}inactive${NC}"
    fi
    
    if systemctl --user is-active pipewire-pulse.service &>/dev/null; then
        echo -e "  pipewire-pulse.service: ${GREEN}active${NC}"
    else
        echo -e "  pipewire-pulse.service: ${RED}inactive${NC}"
    fi
    
    if systemctl --user is-active wireplumber.service &>/dev/null; then
        echo -e "  wireplumber.service:   ${GREEN}active${NC}"
    else
        echo -e "  wireplumber.service:   ${RED}inactive${NC}"
    fi
    
    echo ""
    
    # Audio devices
    echo "Audio Devices:"
    pw-cli list-objects Node 2>/dev/null | grep -E "node.nick|node.description" | head -10 || echo "  (none detected)"
    
    echo ""
    echo "============================================"
}

# Ensure state directory exists
sudo mkdir -p "$(dirname "$SANCHALA_AUDIO_STATE")" 2>/dev/null || true

# Main
case "${1:-}" in
    desktop)
        set_mode_desktop
        ;;
    pro)
        set_mode_pro
        ;;
    powersave)
        set_mode_powersave
        ;;
    gaming)
        set_mode_gaming
        ;;
    status)
        show_status
        ;;
    -h|--help|help)
        usage
        ;;
    "")
        usage
        show_status
        ;;
    *)
        print_error "Unknown mode: $1"
        usage
        exit 1
        ;;
esac
