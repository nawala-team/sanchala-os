#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0
# Sanchala Lock Screen Settings - Configure lock screen appearance
"""Customize lock screen with wallpaper, clock style, and widgets"""

import sys, json, argparse, subprocess
from pathlib import Path

VERSION = "1.0.0"
CONFIG_DIR = Path.home() / ".config" / "sanchala" / "lockscreen"

class LockScreenConfig:
    def __init__(self):
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        self.file = CONFIG_DIR / "config.json"
        self.data = self._load()
    
    def _load(self):
        defaults = {
            "wallpaper": "", "blur": True, "blur_strength": 20,
            "clock_style": "digital", "clock_format": "24h",
            "show_date": True, "show_media": True, "show_weather": False,
            "timeout": 5, "lock_on_sleep": True, "lock_on_lid": True
        }
        if self.file.exists():
            try: defaults.update(json.load(open(self.file)))
            except: pass
        return defaults
    
    def save(self):
        with open(self.file, 'w') as f: json.dump(self.data, f, indent=2)
        self._apply()
    
    def _apply(self):
        # Apply to KDE lock screen
        subprocess.run(["kwriteconfig5", "--file", "kscreenlockerrc", "--group", "Greeter",
                       "--key", "WallpaperPlugin", "org.kde.image"], capture_output=True)

def cmd_status(args):
    config = LockScreenConfig()
    print(f"\n🔒 Lock Screen Settings\n" + "━"*40)
    print(f"  Wallpaper:    {config.data['wallpaper'] or 'Default'}")
    print(f"  Blur:         {'On' if config.data['blur'] else 'Off'} ({config.data['blur_strength']}%)")
    print(f"  Clock:        {config.data['clock_style']} ({config.data['clock_format']})")
    print(f"  Show Date:    {'Yes' if config.data['show_date'] else 'No'}")
    print(f"  Media Player: {'Yes' if config.data['show_media'] else 'No'}")
    print(f"  Timeout:      {config.data['timeout']} minutes")
    print()
    return 0

def cmd_wallpaper(args):
    config = LockScreenConfig()
    if args.path:
        path = Path(args.path).resolve()
        if not path.exists():
            print(f"❌ File not found: {args.path}")
            return 1
        config.data["wallpaper"] = str(path)
        config.save()
        print(f"✅ Lock screen wallpaper set")
    else:
        print(f"Current: {config.data['wallpaper'] or 'Default'}")
    return 0

def cmd_blur(args):
    config = LockScreenConfig()
    if args.action == "on":
        config.data["blur"] = True
        if args.strength: config.data["blur_strength"] = args.strength
    elif args.action == "off":
        config.data["blur"] = False
    config.save()
    print(f"✅ Blur: {'On' if config.data['blur'] else 'Off'}")
    return 0

def cmd_clock(args):
    config = LockScreenConfig()
    if args.style: config.data["clock_style"] = args.style
    if args.format: config.data["clock_format"] = args.format
    config.save()
    print(f"✅ Clock: {config.data['clock_style']} ({config.data['clock_format']})")
    return 0

def cmd_timeout(args):
    config = LockScreenConfig()
    config.data["timeout"] = args.minutes
    config.save()
    print(f"✅ Timeout set to {args.minutes} minutes")
    return 0

def cmd_test(args):
    print("🔒 Testing lock screen...")
    subprocess.run(["loginctl", "lock-session"])
    return 0

def main():
    p = argparse.ArgumentParser(prog="sanchala-lockscreen-settings", description="🔒 Lock Screen")
    p.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    sub = p.add_subparsers(dest="cmd")
    
    sub.add_parser("status", help="Show settings")
    s = sub.add_parser("wallpaper", help="Set wallpaper"); s.add_argument("path", nargs="?")
    s = sub.add_parser("blur", help="Blur settings")
    s.add_argument("action", choices=["on","off"])
    s.add_argument("-s", "--strength", type=int)
    s = sub.add_parser("clock", help="Clock settings")
    s.add_argument("-s", "--style", choices=["digital","analog","minimal"])
    s.add_argument("-f", "--format", choices=["12h","24h"])
    s = sub.add_parser("timeout", help="Set timeout"); s.add_argument("minutes", type=int)
    sub.add_parser("test", help="Test lock screen")
    sub.add_parser("gui", help="Open GUI settings")
    
    args = p.parse_args()
    cmds = {"status": cmd_status, "wallpaper": cmd_wallpaper, "blur": cmd_blur,
            "clock": cmd_clock, "timeout": cmd_timeout, "test": cmd_test,
            "gui": lambda a: subprocess.run(["kcmshell5", "screenlocker"]) or 0}
    if args.cmd in cmds: return cmds[args.cmd](args)
    return cmd_status(args)

if __name__ == "__main__": sys.exit(main())
