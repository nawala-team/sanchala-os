#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0
# Sanchala Overview - macOS Mission Control-style window overview
"""Show all windows, workspaces, and quick actions in a beautiful overview"""

import sys, json, argparse, subprocess
from pathlib import Path

VERSION = "1.0.0"
CONFIG_DIR = Path.home() / ".config" / "sanchala" / "overview"

class OverviewConfig:
    def __init__(self):
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        self.file = CONFIG_DIR / "config.json"
        self.data = self._load()
    
    def _load(self):
        defaults = {"animation_duration": 200, "blur_background": True,
                    "show_workspace_bar": True, "grid_columns": 4,
                    "close_on_click": True, "highlight_active": True}
        if self.file.exists():
            try: defaults.update(json.load(open(self.file)))
            except: pass
        return defaults
    
    def save(self):
        with open(self.file, 'w') as f: json.dump(self.data, f, indent=2)

def get_windows():
    """Get list of windows using wmctrl"""
    try:
        result = subprocess.run(["wmctrl", "-l", "-p"], capture_output=True, text=True)
        windows = []
        for line in result.stdout.strip().split('\n'):
            if line:
                parts = line.split(None, 4)
                if len(parts) >= 5:
                    windows.append({
                        "id": parts[0], "desktop": int(parts[1]),
                        "pid": parts[2], "host": parts[3], "title": parts[4]
                    })
        return windows
    except: return []

def get_workspaces():
    """Get workspace info"""
    try:
        result = subprocess.run(["wmctrl", "-d"], capture_output=True, text=True)
        workspaces = []
        for line in result.stdout.strip().split('\n'):
            parts = line.split()
            if len(parts) >= 9:
                workspaces.append({
                    "id": int(parts[0]), "active": parts[1] == "*",
                    "name": parts[8] if len(parts) > 8 else f"Workspace {parts[0]}"
                })
        return workspaces
    except: return []

def cmd_show(args):
    """Show overview (trigger KWin effect)"""
    cmds = [
        "qdbus org.kde.kglobalaccel /component/kwin invokeShortcut 'Overview'",
        "qdbus org.kde.kglobalaccel /component/kwin invokeShortcut 'Expose'",
        "xdotool key super",
    ]
    for cmd in cmds:
        if subprocess.run(cmd, shell=True, capture_output=True).returncode == 0:
            return 0
    print("❌ Could not trigger overview")
    return 1

def cmd_windows(args):
    """List all windows"""
    windows = get_windows()
    workspaces = get_workspaces()
    
    print(f"\n🪟 Windows Overview\n" + "━"*50)
    
    for ws in workspaces:
        marker = "●" if ws["active"] else "○"
        print(f"\n{marker} {ws['name']}:")
        ws_windows = [w for w in windows if w["desktop"] == ws["id"] or w["desktop"] == -1]
        if not ws_windows:
            print("    (empty)")
        for w in ws_windows:
            print(f"    {w['id']}  {w['title'][:45]}")
    print()
    return 0

def cmd_focus(args):
    """Focus a window by ID"""
    subprocess.run(["wmctrl", "-i", "-a", args.window_id])
    return 0

def cmd_close(args):
    """Close a window by ID"""
    subprocess.run(["wmctrl", "-i", "-c", args.window_id])
    print(f"✅ Closed window: {args.window_id}")
    return 0

def cmd_status(args):
    config = OverviewConfig()
    windows = get_windows()
    workspaces = get_workspaces()
    active = next((w for w in workspaces if w["active"]), None)
    
    print(f"\n🖥️  Overview Status\n" + "━"*35)
    print(f"  Windows:    {len(windows)}")
    print(f"  Workspaces: {len(workspaces)}")
    print(f"  Active:     {active['name'] if active else 'Unknown'}")
    print(f"  Animation:  {config.data['animation_duration']}ms")
    print()
    return 0

def main():
    p = argparse.ArgumentParser(prog="sanchala-overview", description="🖥️ Overview")
    p.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    sub = p.add_subparsers(dest="cmd")
    
    sub.add_parser("show", help="Show overview")
    sub.add_parser("windows", help="List windows")
    s = sub.add_parser("focus", help="Focus window"); s.add_argument("window_id")
    s = sub.add_parser("close", help="Close window"); s.add_argument("window_id")
    sub.add_parser("status", help="Status info")
    
    args = p.parse_args()
    cmds = {"show": cmd_show, "windows": cmd_windows, "focus": cmd_focus,
            "close": cmd_close, "status": cmd_status}
    if args.cmd in cmds: return cmds[args.cmd](args)
    return cmd_show(args)

if __name__ == "__main__": sys.exit(main())
