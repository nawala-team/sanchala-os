[Desktop Entry]
Name=FTP Client
GenericName=File Transfer Client
Comment=Transfer files via FTP, SFTP, and FTPS protocols
Exec=sanchala-ftp-client
Icon=folder-remote
Terminal=false
Type=Application
Categories=Network;FileTransfer;
Keywords=ftp;sftp;ftps;transfer;upload;download;remote;
StartupNotify=true
MimeType=x-scheme-handler/ftp;x-scheme-handler/sftp;
