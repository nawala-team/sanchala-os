#!/usr/bin/env python3
"""Sanchala Package Manager GUI"""
import sys, subprocess
from PyQt6.QtWidgets import *
from PyQt6.QtCore import *
from PyQt6.QtGui import *

class PackageWorker(QThread):
    output = pyqtSignal(str)
    finished_signal = pyqtSignal(bool)
    
    def __init__(self, cmd):
        super().__init__()
        self.cmd = cmd
    
    def run(self):
        try:
            proc = subprocess.Popen(self.cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
            for line in proc.stdout:
                self.output.emit(line)
            proc.wait()
            self.finished_signal.emit(proc.returncode == 0)
        except Exception as e:
            self.output.emit(str(e))
            self.finished_signal.emit(False)

class PackageManager(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Sanchala Package Manager")
        self.setMinimumSize(700, 550)
        self.worker = None
        self.init_ui()
    
    def init_ui(self):
        w = QWidget()
        self.setCentralWidget(w)
        layout = QVBoxLayout(w)
        
        # Search bar
        search_row = QHBoxLayout()
        self.search_input = QLineEdit()
        self.search_input.setPlaceholderText("Search packages...")
        self.search_input.returnPressed.connect(self.search_packages)
        search_row.addWidget(self.search_input)
        search_btn = QPushButton("Search")
        search_btn.clicked.connect(self.search_packages)
        search_row.addWidget(search_btn)
        layout.addLayout(search_row)
        
        # Package list
        self.pkg_list = QTreeWidget()
        self.pkg_list.setHeaderLabels(["Package", "Version", "Repository", "Status"])
        self.pkg_list.setAlternatingRowColors(True)
        layout.addWidget(self.pkg_list)
        
        # Action buttons
        btn_row = QHBoxLayout()
        install_btn = QPushButton("Install")
        install_btn.clicked.connect(self.install_selected)
        btn_row.addWidget(install_btn)
        remove_btn = QPushButton("Remove")
        remove_btn.clicked.connect(self.remove_selected)
        btn_row.addWidget(remove_btn)
        update_btn = QPushButton("Update System")
        update_btn.clicked.connect(self.update_system)
        btn_row.addWidget(update_btn)
        btn_row.addStretch()
        layout.addLayout(btn_row)
        
        # Output
        self.output = QTextEdit()
        self.output.setReadOnly(True)
        self.output.setMaximumHeight(150)
        layout.addWidget(self.output)
    
    def search_packages(self):
        query = self.search_input.text()
        if not query:
            return
        self.pkg_list.clear()
        try:
            out = subprocess.check_output(["pacman", "-Ss", query], text=True, stderr=subprocess.DEVNULL)
            lines = out.strip().split("\n")
            i = 0
            while i < len(lines):
                if lines[i].startswith(" "):
                    i += 1
                    continue
                parts = lines[i].split()
                if len(parts) >= 2:
                    name_repo = parts[0]
                    version = parts[1]
                    repo, name = name_repo.split("/") if "/" in name_repo else ("", name_repo)
                    installed = "[installed]" in lines[i]
                    item = QTreeWidgetItem([name, version, repo, "Installed" if installed else ""])
                    if installed:
                        item.setForeground(3, QColor("#27ae60"))
                    self.pkg_list.addTopLevelItem(item)
                i += 1
        except: pass
    
    def get_selected_pkg(self):
        item = self.pkg_list.currentItem()
        return item.text(0) if item else None
    
    def install_selected(self):
        pkg = self.get_selected_pkg()
        if pkg:
            self.run_cmd(["pkexec", "pacman", "-S", pkg, "--noconfirm"])
    
    def remove_selected(self):
        pkg = self.get_selected_pkg()
        if pkg:
            self.run_cmd(["pkexec", "pacman", "-Rs", pkg, "--noconfirm"])
    
    def update_system(self):
        self.run_cmd(["pkexec", "pacman", "-Syu", "--noconfirm"])
    
    def run_cmd(self, cmd):
        self.output.clear()
        self.worker = PackageWorker(cmd)
        self.worker.output.connect(self.output.append)
        self.worker.finished_signal.connect(lambda ok: self.output.append("\n=== Done ==="))
        self.worker.start()

if __name__ == "__main__":
    app = QApplication(sys.argv)
    w = PackageManager()
    w.show()
    sys.exit(app.exec())
