#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0
# Sanchala Gestures Settings - Touchpad and touchscreen gestures
"""Configure multi-touch gestures for touchpad and touchscreen"""

import sys, json, argparse, subprocess
from pathlib import Path

VERSION = "1.0.0"
CONFIG_DIR = Path.home() / ".config" / "sanchala" / "gestures"

DEFAULT_GESTURES = {
    "swipe_3_up": {"action": "overview", "desc": "Show Overview"},
    "swipe_3_down": {"action": "show_desktop", "desc": "Show Desktop"},
    "swipe_3_left": {"action": "workspace_next", "desc": "Next Workspace"},
    "swipe_3_right": {"action": "workspace_prev", "desc": "Previous Workspace"},
    "swipe_4_up": {"action": "maximize", "desc": "Maximize Window"},
    "swipe_4_down": {"action": "minimize", "desc": "Minimize Window"},
    "swipe_4_left": {"action": "snap_left", "desc": "Snap Left"},
    "swipe_4_right": {"action": "snap_right", "desc": "Snap Right"},
    "pinch_in": {"action": "zoom_out", "desc": "Zoom Out"},
    "pinch_out": {"action": "zoom_in", "desc": "Zoom In"},
}

class GesturesConfig:
    def __init__(self):
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        self.file = CONFIG_DIR / "config.json"
        self.data = self._load()
    
    def _load(self):
        defaults = {"enabled": True, "gestures": DEFAULT_GESTURES.copy(),
                    "sensitivity": 1.0, "touchpad": True, "touchscreen": True}
        if self.file.exists():
            try: defaults.update(json.load(open(self.file)))
            except: pass
        return defaults
    
    def save(self):
        with open(self.file, 'w') as f: json.dump(self.data, f, indent=2)
        self._apply()
    
    def _apply(self):
        # Generate libinput-gestures config
        gestures_conf = CONFIG_DIR / "libinput-gestures.conf"
        lines = ["# Generated by sanchala-gestures-settings"]
        action_map = {
            "overview": "qdbus org.kde.kglobalaccel /component/kwin invokeShortcut 'Overview'",
            "show_desktop": "qdbus org.kde.kglobalaccel /component/kwin invokeShortcut 'Show Desktop'",
            "workspace_next": "qdbus org.kde.kglobalaccel /component/kwin invokeShortcut 'Switch One Desktop to the Right'",
            "workspace_prev": "qdbus org.kde.kglobalaccel /component/kwin invokeShortcut 'Switch One Desktop to the Left'",
        }
        for gesture, config in self.data["gestures"].items():
            if config["action"] in action_map:
                cmd = action_map[config["action"]]
                lines.append(f"gesture {gesture.replace('_', ' ')} {cmd}")
        gestures_conf.write_text('\n'.join(lines))

def cmd_status(args):
    config = GesturesConfig()
    print(f"\n👆 Gesture Settings\n" + "━"*45)
    print(f"  Enabled:     {'Yes' if config.data['enabled'] else 'No'}")
    print(f"  Sensitivity: {config.data['sensitivity']}")
    print(f"\n  Configured Gestures:")
    for name, g in config.data["gestures"].items():
        print(f"    {name:20} → {g['desc']}")
    print()
    return 0

def cmd_enable(args):
    config = GesturesConfig()
    config.data["enabled"] = True
    config.save()
    subprocess.run(["libinput-gestures-setup", "start"], capture_output=True)
    print("✅ Gestures enabled")
    return 0

def cmd_disable(args):
    config = GesturesConfig()
    config.data["enabled"] = False
    config.save()
    subprocess.run(["libinput-gestures-setup", "stop"], capture_output=True)
    print("✅ Gestures disabled")
    return 0

def cmd_set(args):
    config = GesturesConfig()
    gesture = args.gesture
    action = args.action
    
    if gesture not in config.data["gestures"]:
        print(f"❌ Unknown gesture. Available: {', '.join(config.data['gestures'].keys())}")
        return 1
    
    config.data["gestures"][gesture]["action"] = action
    config.save()
    print(f"✅ {gesture} → {action}")
    return 0

def cmd_reset(args):
    config = GesturesConfig()
    config.data["gestures"] = DEFAULT_GESTURES.copy()
    config.save()
    print("✅ Gestures reset to defaults")
    return 0

def cmd_sensitivity(args):
    config = GesturesConfig()
    config.data["sensitivity"] = args.value
    config.save()
    print(f"✅ Sensitivity: {args.value}")
    return 0

def main():
    p = argparse.ArgumentParser(prog="sanchala-gestures-settings", description="👆 Gestures")
    p.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    sub = p.add_subparsers(dest="cmd")
    
    sub.add_parser("status", help="Show settings")
    sub.add_parser("enable", help="Enable gestures")
    sub.add_parser("disable", help="Disable gestures")
    s = sub.add_parser("set", help="Set gesture action")
    s.add_argument("gesture"); s.add_argument("action")
    sub.add_parser("reset", help="Reset to defaults")
    s = sub.add_parser("sensitivity", help="Set sensitivity"); s.add_argument("value", type=float)
    sub.add_parser("gui", help="Open GUI")
    
    args = p.parse_args()
    cmds = {"status": cmd_status, "enable": cmd_enable, "disable": cmd_disable,
            "set": cmd_set, "reset": cmd_reset, "sensitivity": cmd_sensitivity,
            "gui": lambda a: subprocess.run(["kcmshell5", "kcm_touchpad"]) or 0}
    if args.cmd in cmds: return cmds[args.cmd](args)
    return cmd_status(args)

if __name__ == "__main__": sys.exit(main())
