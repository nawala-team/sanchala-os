#!/bin/bash
# Sanchala System Info - System Information Tool
set -euo pipefail

show_all() {
    echo "=== Sanchala System Info ==="
    echo
    echo "SYSTEM:"
    echo "  Hostname: $(hostname)"
    echo "  OS: Sanchala OS ($(cat /etc/os-release 2>/dev/null | grep PRETTY_NAME | cut -d= -f2 | tr -d '"'))"
    echo "  Kernel: $(uname -r)"
    echo "  Architecture: $(uname -m)"
    echo "  Uptime: $(uptime -p 2>/dev/null || echo 'N/A')"
    echo
    echo "CPU:"
    echo "  Model: $(grep -m1 'model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2 | xargs || echo 'N/A')"
    echo "  Cores: $(nproc 2>/dev/null || echo 'N/A')"
    echo
    echo "MEMORY:"
    free -h 2>/dev/null | head -2 || echo "  N/A"
    echo
    echo "STORAGE:"
    df -h / /home 2>/dev/null | uniq || echo "  N/A"
}

case "${1:-all}" in
    all|-a) show_all ;;
    cpu) grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 ;;
    memory|mem) free -h ;;
    disk) df -h ;;
    kernel) uname -r ;;
    gui) exec sanchala-sysinfo-gui ;;
    *) show_all ;;
esac
