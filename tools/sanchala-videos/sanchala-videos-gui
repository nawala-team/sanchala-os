#!/usr/bin/env python3
"""Sanchala Videos - Video Player"""
import sys, json
from pathlib import Path
from PyQt6.QtWidgets import *
from PyQt6.QtCore import *
from PyQt6.QtGui import *

class VideosApp(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Sanchala Videos")
        self.setMinimumSize(900, 600)
        self.data_dir = Path.home() / ".local/share/sanchala/videos"
        self.data_dir.mkdir(parents=True, exist_ok=True)
        self.playing = False
        self.init_ui()
    
    def init_ui(self):
        self.setStyleSheet("QMainWindow{background:#0f0f0f;}QLabel{color:#fff;}QPushButton{background:#272727;color:#fff;border:none;padding:10px;border-radius:6px;}QPushButton:hover{background:#3a3a3a;}")
        c = QWidget(); self.setCentralWidget(c); m = QVBoxLayout(c)
        
        # Video display
        self.video = QLabel("🎬\n\nDrag & drop video or click Open")
        self.video.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.video.setStyleSheet("background:#1a1a1a;border-radius:10px;font-size:20px;min-height:350px;")
        self.video.setAcceptDrops(True)
        m.addWidget(self.video)
        
        # Progress bar
        prog = QHBoxLayout()
        self.time_cur = QLabel("0:00"); prog.addWidget(self.time_cur)
        self.slider = QSlider(Qt.Orientation.Horizontal)
        self.slider.setStyleSheet("QSlider::groove:horizontal{background:#272727;height:6px;border-radius:3px;}QSlider::handle:horizontal{background:#ff0000;width:14px;height:14px;margin:-4px 0;border-radius:7px;}")
        prog.addWidget(self.slider, 1)
        self.time_tot = QLabel("0:00"); prog.addWidget(self.time_tot)
        m.addLayout(prog)
        
        # Controls
        ctrl = QHBoxLayout()
        self.play_btn = QPushButton("▶️"); self.play_btn.setFixedSize(50,50); self.play_btn.clicked.connect(self.toggle)
        for w in [QPushButton("⏮️"), QPushButton("⏪"), self.play_btn, QPushButton("⏩"), QPushButton("⏭️")]:
            w.setFixedSize(50,50); ctrl.addWidget(w)
        ctrl.addStretch()
        vol = QSlider(Qt.Orientation.Horizontal); vol.setFixedWidth(100); vol.setValue(70)
        ctrl.addWidget(QLabel("🔊")); ctrl.addWidget(vol)
        ctrl.addWidget(QPushButton("⛶"))  # Fullscreen
        m.addLayout(ctrl)
        
        # Playlist
        pl = QHBoxLayout()
        pl.addWidget(QLabel("📂 Playlist"))
        open_btn = QPushButton("+ Open File"); open_btn.clicked.connect(self.open_file); pl.addWidget(open_btn)
        pl.addStretch()
        m.addLayout(pl)
        
        self.playlist = QListWidget()
        self.playlist.setStyleSheet("background:#1a1a1a;color:#fff;border-radius:6px;max-height:120px;")
        self.playlist.itemDoubleClicked.connect(self.play_item)
        m.addWidget(self.playlist)
        
        self.setAcceptDrops(True)
    
    def toggle(self):
        self.playing = not self.playing
        self.play_btn.setText("⏸️" if self.playing else "▶️")
        if self.playing: self.video.setText("🎬 Playing...")
    
    def open_file(self):
        files, _ = QFileDialog.getOpenFileNames(self, "Open Videos", "", "Videos (*.mp4 *.mkv *.avi *.mov *.webm)")
        for f in files:
            self.playlist.addItem(Path(f).name)
    
    def play_item(self, item):
        self.video.setText(f"🎬 Now Playing:\n{item.text()}")
        self.playing = True; self.play_btn.setText("⏸️")
    
    def dragEnterEvent(self, e):
        if e.mimeData().hasUrls(): e.accept()
    
    def dropEvent(self, e):
        for url in e.mimeData().urls():
            path = url.toLocalFile()
            if path.endswith(('.mp4','.mkv','.avi','.mov','.webm')):
                self.playlist.addItem(Path(path).name)

if __name__ == "__main__":
    app = QApplication(sys.argv); w = VideosApp(); w.show(); sys.exit(app.exec())
