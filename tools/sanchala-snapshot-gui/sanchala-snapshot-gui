#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0
# Sanchala Snapshot GUI - Snapshot Management
set -euo pipefail
VERSION="1.0.0"
PROGRAM_NAME="sanchala-snapshot-gui"
STATE_DIR="/var/lib/sanchala/snapshots"
RED="\033[0;31m" GREEN="\033[0;32m" YELLOW="\033[1;33m" BLUE="\033[0;34m" NC="\033[0m" BOLD="\033[1m"
print_info() { echo -e "${BLUE}i $1${NC}"; }
print_success() { echo -e "${GREEN}ok $1${NC}"; }
print_warning() { echo -e "${YELLOW}! $1${NC}"; }
print_error() { echo -e "${RED}x $1${NC}"; }
check_root() { [[ $EUID -eq 0 ]] || { print_error "Root required"; exit 1; }; }
init_dirs() { mkdir -p "$STATE_DIR" 2>/dev/null || true; }
show_help() {
cat << HELP
SANCHALA SNAPSHOT GUI - Snapshot Management
USAGE: sanchala-snapshot-gui <COMMAND>
COMMANDS:
  list              List all snapshots
  create [DESC]     Create new snapshot
  delete <ID>       Delete snapshot
  restore <ID>      Restore from snapshot
  browse <ID>       Browse snapshot
  cleanup           Remove old snapshots
  gui               Launch GUI
OPTIONS:
  -h, --help        Show this help
HELP
}
get_tool() {
    command -v snapper &>/dev/null && echo "snapper" && return
    command -v timeshift &>/dev/null && echo "timeshift" && return
    echo "none"
}
cmd_list() {
    echo -e "${BOLD}Snapshots:${NC}"
    case $(get_tool) in
        snapper) snapper list ;;
        timeshift) timeshift --list ;;
        *) ls -la "$STATE_DIR" 2>/dev/null || echo "No snapshots" ;;
    esac
}
cmd_create() {
    local desc="${1:-Snapshot $(date +%Y-%m-%d_%H:%M)}"
    print_info "Creating: $desc"
    case $(get_tool) in
        snapper) snapper create -d "$desc" ;;
        timeshift) timeshift --create --comments "$desc" ;;
        *) local s="$STATE_DIR/snap-$(date +%Y%m%d-%H%M%S)"; mkdir -p "$s"; echo "$desc" > "$s/desc" ;;
    esac
    print_success "Created"
}
cmd_delete() { local id="$1"; print_info "Deleting: $id"; case $(get_tool) in snapper) snapper delete "$id";; timeshift) timeshift --delete --snapshot "$id";; *) rm -rf "$STATE_DIR/$id";; esac; print_success "Deleted"; }
cmd_restore() { local id="$1"; print_warning "Restoring: $id"; case $(get_tool) in snapper) snapper undochange "$id"..0;; timeshift) timeshift --restore --snapshot "$id";; *) print_error "Manual restore needed";; esac; }
cmd_browse() { local id="$1"; case $(get_tool) in snapper) ls -la "/.snapshots/$id/snapshot";; *) ls -la "$STATE_DIR/$id";; esac; }
cmd_cleanup() { print_info "Cleaning..."; case $(get_tool) in snapper) snapper cleanup number;; *) ls -t "$STATE_DIR" 2>/dev/null | tail -n +6 | xargs -I{} rm -rf "$STATE_DIR/{}";; esac; print_success "Done"; }
cmd_gui() { command -v snapper-gui &>/dev/null && snapper-gui || command -v timeshift-gtk &>/dev/null && timeshift-gtk || { print_warning "No GUI"; cmd_list; }; }
main() {
    case "${1:-help}" in
        list) cmd_list;; create) check_root; init_dirs; shift; cmd_create "${1:-}";;
        delete) check_root; shift; cmd_delete "$@";; restore) check_root; shift; cmd_restore "$@";;
        browse) shift; cmd_browse "$@";; cleanup) check_root; cmd_cleanup;; gui) cmd_gui;;
        -h|--help|help) show_help;; --version) echo "$PROGRAM_NAME $VERSION";; *) print_error "Unknown: $1"; exit 1;;
    esac
}
main "$@"
