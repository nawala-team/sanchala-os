#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0
# Sanchala Data Wipe - Secure Data Destruction
set -euo pipefail
VERSION="1.0.0"
PROGRAM_NAME="sanchala-data-wipe"
RED="\033[0;31m" GREEN="\033[0;32m" YELLOW="\033[1;33m" BLUE="\033[0;34m" NC="\033[0m" BOLD="\033[1m"
print_info() { echo -e "${BLUE}i $1${NC}"; }
print_success() { echo -e "${GREEN}ok $1${NC}"; }
print_error() { echo -e "${RED}x $1${NC}"; }
check_root() { [[ $EUID -eq 0 ]] || { print_error "Root required"; exit 1; }; }
confirm() { echo -e "${RED}${BOLD}WARNING: $1${NC}"; read -p "Type WIPE: " r; [[ "$r" == "WIPE" ]] || { echo "Cancelled"; exit 0; }; }
show_help() {
cat << HELP
SANCHALA DATA WIPE - Secure Data Destruction
USAGE: sanchala-data-wipe <COMMAND>
COMMANDS:
  file <PATH>       Securely wipe file
  directory <PATH>  Wipe directory
  disk <DEVICE>     Wipe entire disk
  partition <DEV>   Wipe partition
  free-space <MNT>  Wipe free space
  swap              Wipe swap
  ram               Clear RAM caches
METHODS: --zeros, --random, --dod, --gutmann, --passes <N>
HELP
}
cmd_file() {
    local file="$1" passes=3; shift || true
    while [[ $# -gt 0 ]]; do case "$1" in --passes) passes="$2"; shift;; --dod) passes=3;; --gutmann) passes=35;; esac; shift; done
    [[ -f "$file" ]] || { print_error "Not found"; exit 1; }
    print_info "Wiping: $file"
    shred -v -n "$passes" -z -u "$file" 2>/dev/null || { dd if=/dev/urandom of="$file" bs=4k conv=notrunc 2>/dev/null; rm -f "$file"; }
    print_success "Wiped"
}
cmd_directory() {
    local dir="$1"
    [[ -d "$dir" ]] || { print_error "Not found"; exit 1; }
    confirm "Wipe: $dir"
    find "$dir" -type f -exec shred -n 3 -z -u {} \; 2>/dev/null || find "$dir" -type f -delete
    rm -rf "$dir"; print_success "Wiped"
}
cmd_disk() {
    local dev="$1" passes=1 src="/dev/urandom"; shift || true
    while [[ $# -gt 0 ]]; do case "$1" in --zeros) src="/dev/zero";; --passes) passes="$2"; shift;; esac; shift; done
    [[ -b "$dev" ]] || { print_error "Not block device"; exit 1; }
    findmnt "$dev" &>/dev/null && { print_error "Mounted!"; exit 1; }
    confirm "WIPE DISK: $dev"
    for ((i=1;i<=passes;i++)); do print_info "Pass $i/$passes"; dd if="$src" of="$dev" bs=4M status=progress 2>&1||true; done
    sync; print_success "Wiped"
}
cmd_partition() { local dev="$1"; [[ -b "$dev" ]] || { print_error "Not block"; exit 1; }; confirm "Wipe: $dev"; dd if=/dev/urandom of="$dev" bs=4M status=progress 2>&1||true; print_success "Wiped"; }
cmd_free_space() { local m="$1"; [[ -d "$m" ]] || { print_error "Not found"; exit 1; }; confirm "Wipe free: $m"; dd if=/dev/urandom of="$m/.wipe$$" bs=4M 2>/dev/null||true; rm -f "$m/.wipe$$"; print_success "Done"; }
cmd_swap() { confirm "Wipe swap?"; for s in $(swapon --show=NAME --noheadings 2>/dev/null); do swapoff "$s"; dd if=/dev/urandom of="$s" bs=4M 2>/dev/null||true; mkswap "$s"; swapon "$s"; done; print_success "Done"; }
cmd_ram() { sync; echo 3 > /proc/sys/vm/drop_caches 2>/dev/null||true; print_success "RAM cleared"; }
main() {
    case "${1:-help}" in
        file) check_root; shift; cmd_file "$@";; directory|dir) check_root; shift; cmd_directory "$@";;
        disk) check_root; shift; cmd_disk "$@";; partition) check_root; shift; cmd_partition "$@";;
        free-space) check_root; shift; cmd_free_space "$@";; swap) check_root; cmd_swap;; ram) check_root; cmd_ram;;
        -h|--help|help) show_help;; --version) echo "$PROGRAM_NAME $VERSION";; *) print_error "Unknown: $1"; exit 1;;
    esac
}
main "$@"
