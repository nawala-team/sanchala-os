#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0
# Sanchala Color Picker - Professional color tool
"""Color picker with screen sampling and palettes"""

import os, sys, json, argparse, subprocess, re
from pathlib import Path
from typing import Tuple

VERSION = "1.0.0"
DATA_DIR = Path.home() / ".local" / "share" / "sanchala" / "colorpicker"

def hex_to_rgb(h: str) -> Tuple[int,int,int]:
    h = h.lstrip('#')
    return tuple(int(h[i:i+2], 16) for i in (0, 2, 4))

def rgb_to_hex(r: int, g: int, b: int) -> str:
    return f"#{r:02x}{g:02x}{b:02x}"

def rgb_to_hsl(r: int, g: int, b: int) -> Tuple[int,int,int]:
    r, g, b = r/255, g/255, b/255
    mx, mn = max(r,g,b), min(r,g,b)
    l = (mx + mn) / 2
    if mx == mn: return 0, 0, int(l*100)
    d = mx - mn
    s = d/(2-mx-mn) if l > 0.5 else d/(mx+mn)
    if mx == r: h = (g-b)/d + (6 if g < b else 0)
    elif mx == g: h = (b-r)/d + 2
    else: h = (r-g)/d + 4
    return int(h*60), int(s*100), int(l*100)

class Palette:
    def __init__(self):
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        self.file = DATA_DIR / "palettes.json"
        self.data = json.load(open(self.file)) if self.file.exists() else {"history": [], "palettes": {}}
    
    def save(self): 
        with open(self.file, 'w') as f: json.dump(self.data, f, indent=2)
    
    def add_history(self, c: str):
        h = self.data["history"]
        if c in h: h.remove(c)
        h.insert(0, c)


def display_color(hex_color: str):
    r, g, b = hex_to_rgb(hex_color)
    h, s, l = rgb_to_hsl(r, g, b)
    print(f"\n\033[48;2;{r};{g};{b}m{'':^20}\033[0m")
    print("━" * 35)
    print(f"  HEX:  {hex_color.upper()}")
    print(f"  RGB:  rgb({r}, {g}, {b})")
    print(f"  HSL:  hsl({h}, {s}%, {l}%)")
    print()

def pick_screen() -> str:
    for cmd in [["kcolorchooser","--print"],["gpick","-s","-o"],["xcolor"],["grabc"]]:
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
            if r.returncode == 0 and r.stdout.strip(): return r.stdout.strip()
        except: continue
    return None

def cmd_pick(args):
    pal = Palette()
    color = pick_screen()
    if not color: print("❌ Install: kcolorchooser, gpick, or xcolor"); return 1
    if not color.startswith('#'):
        m = re.match(r'rgb\((\d+),\s*(\d+),\s*(\d+)\)', color)
        if m: color = rgb_to_hex(int(m.group(1)), int(m.group(2)), int(m.group(3)))
    display_color(color)
    pal.add_history(color)
    if args.copy:
        try: subprocess.run(["xclip","-selection","clipboard"], input=color.encode())
        except: pass
    return 0

def cmd_convert(args):
    c = args.color
    if c.startswith('#'): hex_c = c
    elif c.startswith('rgb'):
        m = re.match(r'rgb\((\d+),\s*(\d+),\s*(\d+)\)', c)
        hex_c = rgb_to_hex(int(m.group(1)), int(m.group(2)), int(m.group(3))) if m else None
    else: hex_c = f"#{c}" if len(c) == 6 else None
    if not hex_c: print("❌ Invalid color"); return 1
    display_color(hex_c)
    return 0

def cmd_history(args):
    pal = Palette()
    for i, c in enumerate(pal.data.get("history", [])[:20], 1):
        r, g, b = hex_to_rgb(c)
        print(f"  {i:2}. \033[48;2;{r};{g};{b}m  \033[0m {c}")
    return 0

def main():
    p = argparse.ArgumentParser(prog="sanchala-colorpicker", description="🎨 Color Picker")
    p.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    sub = p.add_subparsers(dest="cmd")
    s = sub.add_parser("pick", help="Pick from screen"); s.add_argument("-c","--copy",action="store_true")
    s = sub.add_parser("convert", help="Convert color"); s.add_argument("color")
    sub.add_parser("history", help="Show history")
    args = p.parse_args()
    cmds = {"pick": cmd_pick, "convert": cmd_convert, "history": cmd_history}
    if args.cmd in cmds: return cmds[args.cmd](args)
    return cmd_pick(argparse.Namespace(copy=False))

if __name__ == "__main__": sys.exit(main())
