#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0
# Sanchala Secure Delete - Military-Grade File Shredding
set -euo pipefail

VERSION="1.0.0"
AUDIT_LOG="/var/log/sanchala/secure-delete-audit.log"

RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[1;33m' BLUE='\033[0;34m' NC='\033[0m'

log_audit() { echo "[$(date -Iseconds)] $1: ${2:-}" >> "$AUDIT_LOG" 2>/dev/null || true; }

secure_delete_file() {
    local file="$1" passes="${2:-3}"
    [[ -f "$file" ]] || { echo -e "${RED}✗ File not found: $file${NC}"; return 1; }
    
    local size
    size=$(stat -c%s "$file" 2>/dev/null || stat -f%z "$file")
    echo -e "${BLUE}ℹ Securely deleting: $file ($size bytes, $passes passes)${NC}"
    
    local i
    for ((i=1; i<=passes; i++)); do
        echo -ne "\r  Pass $i/$passes: random data..."
        dd if=/dev/urandom of="$file" bs=4096 count=$((size/4096 + 1)) conv=notrunc 2>/dev/null
        sync
    done
    
    echo -ne "\r  Final pass: zeroing...     "
    dd if=/dev/zero of="$file" bs=4096 count=$((size/4096 + 1)) conv=notrunc 2>/dev/null
    sync; rm -f "$file"
    echo -e "\r${GREEN}✓ Securely deleted: $file${NC}     "
    log_audit "DELETE" "$file ($passes passes)"
}

secure_delete_dir() {
    local dir="$1" passes="${2:-3}"
    [[ -d "$dir" ]] || { echo -e "${RED}✗ Directory not found: $dir${NC}"; return 1; }
    
    echo -e "${YELLOW}⚠ This will permanently destroy: $dir${NC}"
    read -rp "Type 'DELETE' to confirm: " confirm
    [[ "$confirm" == "DELETE" ]] || { echo "Aborted"; return 1; }
    
    find "$dir" -type f | while read -r file; do
        secure_delete_file "$file" "$passes"
    done
    rm -rf "$dir"
    echo -e "${GREEN}✓ Directory securely deleted${NC}"
}

case "${1:-help}" in
    file) shift; for f in "$@"; do secure_delete_file "$f" 3; done ;;
    dir) secure_delete_dir "$2" "${3:-3}" ;;
    wipe-free) dd if=/dev/urandom of="${2:-.}/.wipe$$" bs=1M 2>/dev/null||true; rm -f "${2:-.}/.wipe$$" ;;
    dod) secure_delete_file "$2" 7 ;;
    gutmann) secure_delete_file "$2" 35 ;;
    *) echo "Usage: sanchala-secure-delete {file FILE..|dir DIR|wipe-free [PATH]|dod FILE|gutmann FILE}" ;;
esac
