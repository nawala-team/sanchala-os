#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0
# Sanchala Recovery Mode - Bulletproof System Recovery
set -euo pipefail
VERSION="1.0.0"
SNAPSHOT_DIR="/.snapshots"
RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[1;33m' BLUE='\033[0;34m' NC='\033[0m' BOLD='\033[1m'
info() { echo -e "${BLUE}i${NC} $1"; }
ok() { echo -e "${GREEN}+${NC} $1"; }
warn() { echo -e "${YELLOW}!${NC} $1"; }
err() { echo -e "${RED}x${NC} $1" >&2; }
header() { echo -e "\n${BOLD}=== $1 ===${NC}\n"; }
root_check() { [[ $EUID -eq 0 ]] || { err "Root required"; exit 1; }; }
show_help() { cat << 'EOF'
SANCHALA RECOVERY MODE
USAGE: sanchala-recovery-mode <COMMAND>
COMMANDS:
  enter,exit,status    Recovery mode control
  diagnose             System diagnostics
  repair TARGET        Repair bootloader|fstab|packages|permissions|all
  snapshots            List snapshots
  restore <ID>         Restore snapshot
  rollback             Rollback to last state
  chroot <PATH>        Chroot into system
  mount-all            Mount partitions
  network              Setup network
  shell                Recovery shell
  backup-config        Backup configs
  export-logs          Export logs
EOF
}
cmd_diagnose() {
  header "Diagnostics"; local i=0
  findmnt / &>/dev/null && ok "Root mounted" || { err "Root unmounted"; ((i++)); }
  for d in /bin /usr /etc; do [[ -d "$d" ]] || { err "$d missing"; ((i++)); }; done
  [[ -f /etc/fstab ]] && ok "fstab exists" || { err "fstab missing"; ((i++)); }
  [[ $i -eq 0 ]] && ok "No issues" || err "$i issues"
}
cmd_repair() {
  local t="${1:-all}"; header "Repair: $t"
  case "$t" in
    bootloader) grub-install "$(findmnt -no SOURCE / | sed 's/[0-9]*$//')" 2>/dev/null; grub-mkconfig -o /boot/grub/grub.cfg 2>/dev/null; ok "Done";;
    fstab) cp /etc/fstab /etc/fstab.bak 2>/dev/null; ok "Backed up";;
    packages) rm -f /var/lib/pacman/db.lck; pacman -Syy 2>/dev/null || apt-get update 2>/dev/null; ok "Done";;
    permissions) chmod 755 / /usr /bin /etc; chmod 1777 /tmp; ok "Done";;
    all) for x in fstab packages permissions; do cmd_repair "$x"; done;;
  esac
}
cmd_enter() { systemctl set-default rescue.target; ok "Reboot to enter recovery"; }
cmd_exit() { systemctl set-default graphical.target; ok "Normal boot restored"; }
cmd_status() { echo "Target: $(systemctl get-default 2>/dev/null)"; echo "State: $(systemctl is-system-running 2>/dev/null)"; }
cmd_snapshots() { snapper list 2>/dev/null || ls "$SNAPSHOT_DIR" 2>/dev/null || warn "None"; }
cmd_restore() { snapper undochange "$1..0" && ok "Restored"; }
cmd_chroot() { local t="${1:-/mnt}"; mount --bind /dev "$t/dev"; mount -t proc proc "$t/proc"; chroot "$t" /bin/bash; umount "$t"/{dev,proc}; }
cmd_mount_all() { local t=/mnt/recovery; mkdir -p "$t"; for p in /dev/sd??; do mount "$p" "$t" 2>/dev/null && [[ -d "$t/etc" ]] && { ok "$p"; return; }; umount "$t" 2>/dev/null; done; }
cmd_network() { for i in $(ls /sys/class/net); do [[ "$i" == lo ]] && continue; ip link set "$i" up; dhclient "$i" 2>/dev/null && ok "$i"; done; }
cmd_backup() { tar -czf /tmp/cfg-$(date +%s).tar.gz /etc/fstab /etc/passwd 2>/dev/null; ok "Saved"; }
cmd_export() { journalctl -b > /tmp/j.log; tar -czf /tmp/logs.tar.gz /tmp/j.log; ok "Exported"; }
cmd_shell() { PS1="[recovery]# " exec /bin/bash --norc; }
main() {
  case "${1:-status}" in
    enter) root_check; cmd_enter;; exit) root_check; cmd_exit;; status) cmd_status;;
    diagnose) root_check; cmd_diagnose;; repair) root_check; cmd_repair "${2:-all}";;
    snapshots) cmd_snapshots;; restore) cmd_restore "$2";; chroot) cmd_chroot "${2:-/mnt}";;
    mount-all) cmd_mount_all;; network) cmd_network;; backup-config) cmd_backup;;
    export-logs) cmd_export;; shell) cmd_shell;; -h|--help|help) show_help;;
    *) err "Unknown: $1";;
  esac
}
main "$@"
