#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0
# Sanchala Wallpaper Manager - Beautiful wallpaper management
"""Manage wallpapers with collections, slideshows, and dynamic options"""

import sys, json, argparse, subprocess, os, random
from pathlib import Path
from datetime import datetime

VERSION = "1.0.0"
CONFIG_DIR = Path.home() / ".config" / "sanchala" / "wallpaper"
WALLPAPER_DIRS = [
    Path.home() / "Pictures" / "Wallpapers",
    Path("/usr/share/wallpapers"),
    Path("/usr/share/backgrounds"),
]

class WallpaperConfig:
    def __init__(self):
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        self.file = CONFIG_DIR / "config.json"
        self.data = self._load()
    
    def _load(self):
        defaults = {"current": "", "mode": "fill", "slideshow": False,
                    "interval": 30, "collections": {"favorites": []}, "history": []}
        if self.file.exists():
            try: defaults.update(json.load(open(self.file)))
            except: pass
        return defaults
    
    def save(self):
        with open(self.file, 'w') as f: json.dump(self.data, f, indent=2)

def set_wallpaper(path: str, mode: str = "fill"):
    """Set wallpaper using various backends"""
    backends = [
        f"plasma-apply-wallpaperimage '{path}'",
        f"gsettings set org.gnome.desktop.background picture-uri 'file://{path}'",
        f"feh --bg-{mode} '{path}'",
        f"nitrogen --set-{mode} '{path}'",
        f"swaybg -i '{path}' -m {mode}",
    ]
    for cmd in backends:
        if subprocess.run(cmd, shell=True, capture_output=True).returncode == 0:
            return True
    return False

def get_wallpapers(directory: Path = None):
    """Get list of wallpaper files"""
    dirs = [directory] if directory else WALLPAPER_DIRS
    extensions = {'.jpg', '.jpeg', '.png', '.webp', '.bmp'}
    wallpapers = []
    for d in dirs:
        if d.exists():
            for f in d.rglob("*"):
                if f.suffix.lower() in extensions:
                    wallpapers.append(str(f))
    return wallpapers

def cmd_set(args):
    config = WallpaperConfig()
    path = Path(args.wallpaper).resolve()
    
    if not path.exists():
        print(f"❌ File not found: {args.wallpaper}")
        return 1
    
    mode = args.mode or config.data["mode"]
    if set_wallpaper(str(path), mode):
        config.data["current"] = str(path)
        config.data["mode"] = mode
        config.data["history"].insert(0, str(path))
        config.data["history"] = config.data["history"][:50]
        config.save()
        print(f"✅ Wallpaper set: {path.name}")
        return 0
    
    print("❌ Failed to set wallpaper")
    return 1

def cmd_random(args):
    wallpapers = get_wallpapers(Path(args.directory) if args.directory else None)
    if not wallpapers:
        print("No wallpapers found")
        return 1
    
    choice = random.choice(wallpapers)
    args.wallpaper = choice
    args.mode = None
    return cmd_set(args)

def cmd_list(args):
    wallpapers = get_wallpapers(Path(args.directory) if args.directory else None)
    print(f"\n🖼️  Wallpapers ({len(wallpapers)} found):\n")
    for i, w in enumerate(wallpapers[:30], 1):
        print(f"  {i:2}. {Path(w).name}")
    if len(wallpapers) > 30:
        print(f"  ... and {len(wallpapers) - 30} more")
    print()
    return 0

def cmd_current(args):
    config = WallpaperConfig()
    print(f"\n🖼️  Current Wallpaper\n" + "━"*40)
    print(f"  Path: {config.data['current'] or 'Not set'}")
    print(f"  Mode: {config.data['mode']}")
    print()
    return 0

def cmd_slideshow(args):
    config = WallpaperConfig()
    if args.action == "start":
        config.data["slideshow"] = True
        config.data["interval"] = args.interval or config.data["interval"]
        config.save()
        print(f"✅ Slideshow started (every {config.data['interval']} min)")
    elif args.action == "stop":
        config.data["slideshow"] = False
        config.save()
        print("✅ Slideshow stopped")
    else:
        status = "Running" if config.data["slideshow"] else "Stopped"
        print(f"Slideshow: {status}")
    return 0

def cmd_favorite(args):
    config = WallpaperConfig()
    path = str(Path(args.wallpaper).resolve())
    favs = config.data["collections"]["favorites"]
    if path not in favs:
        favs.append(path)
        config.save()
        print(f"✅ Added to favorites")
    return 0

def main():
    p = argparse.ArgumentParser(prog="sanchala-wallpaper-manager", description="🖼️ Wallpaper Manager")
    p.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    sub = p.add_subparsers(dest="cmd")
    
    s = sub.add_parser("set", help="Set wallpaper"); s.add_argument("wallpaper")
    s.add_argument("-m", "--mode", choices=["fill","fit","stretch","tile","center"])
    sub.add_parser("current", help="Show current")
    s = sub.add_parser("random", help="Random wallpaper"); s.add_argument("-d","--directory")
    s = sub.add_parser("list", help="List wallpapers"); s.add_argument("-d","--directory")
    s = sub.add_parser("slideshow", help="Slideshow control")
    s.add_argument("action", choices=["start","stop","status"])
    s.add_argument("-i", "--interval", type=int)
    s = sub.add_parser("favorite", help="Add to favorites"); s.add_argument("wallpaper")
    
    args = p.parse_args()
    cmds = {"set": cmd_set, "current": cmd_current, "random": cmd_random,
            "list": cmd_list, "slideshow": cmd_slideshow, "favorite": cmd_favorite}
    if args.cmd in cmds: return cmds[args.cmd](args)
    return cmd_current(args)

if __name__ == "__main__": sys.exit(main())
