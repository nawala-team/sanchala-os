{
  "name": "sanchala-clipboard-sync",
  "version": "1.0.0",
  "description": "Sync clipboard across devices securely",
  "author": "Sanchala OS Team",
  "category": "Network",
  "settings": {
    "enabled": true,
    "syncDevices": [],
    "autoSync": true,
    "syncText": true,
    "syncImages": true,
    "syncFiles": false,
    "maxTextLength": 100000,
    "maxImageSize": 10485760,
    "encryption": "aes-256-gcm",
    "historyEnabled": true,
    "historySize": 100,
    "excludePatterns": ["password", "secret", "token"],
    "notifyOnSync": false,
    "syncInterval": 1000
  },
  "permissions": ["clipboard", "network", "encryption"]
}
