#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0
# Sanchala Screen Time - Usage Monitoring & Limits
set -euo pipefail

VERSION="1.0.0"
STATE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/sanchala/screen-time"
CONFIG_DIR="/etc/sanchala/screen-time"

RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[1;33m' BLUE='\033[0;34m' NC='\033[0m'

mkdir -p "$STATE_DIR"

cmd_status() {
    echo -e "${BLUE}Screen Time Summary${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━"
    
    local today
    today=$(date +%Y-%m-%d)
    
    if [[ -f "$STATE_DIR/usage.log" ]]; then
        echo -e "${BLUE}Today's Usage:${NC}"
        grep "^$today" "$STATE_DIR/usage.log" 2>/dev/null | cut -d'|' -f2 | sort | uniq -c | sort -rn | head -10
    fi
    
    echo -e "\n${BLUE}Currently Active:${NC}"
    xdotool getactivewindow getwindowname 2>/dev/null || echo "  Unknown"
    
    local uptime
    uptime=$(uptime -p 2>/dev/null || uptime | grep -oP 'up \K[^,]+')
    echo -e "\n${BLUE}Session Duration:${NC} $uptime"
}

cmd_limit() {
    local app="$1" minutes="$2"
    mkdir -p "$CONFIG_DIR"
    echo "$app|$minutes" >> "$CONFIG_DIR/limits.conf"
    echo -e "${GREEN}✓ Set $minutes minute limit for $app${NC}"
}

cmd_report() {
    local days="${1:-7}"
    echo -e "${BLUE}Screen Time Report (last $days days)${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    
    if [[ -f "$STATE_DIR/usage.log" ]]; then
        echo -e "\n${BLUE}Most Used Apps:${NC}"
        cut -d'|' -f2 "$STATE_DIR/usage.log" | sort | uniq -c | sort -rn | head -10
    else
        echo "No usage data"
    fi
}

cmd_break() {
    local minutes="${1:-20}"
    echo -e "${BLUE}Break reminder set for $minutes minutes${NC}"
    (sleep $((minutes * 60)) && notify-send "Screen Time" "Time for a break!" 2>/dev/null) &
    echo -e "${GREEN}✓ Reminder in $minutes minutes${NC}"
}

case "${1:-status}" in
    status) cmd_status ;; limit) cmd_limit "$2" "$3" ;;
    report) cmd_report "${2:-7}" ;; break) cmd_break "${2:-20}" ;;
    track) echo "$(date -Iseconds)|$2|$3" >> "$STATE_DIR/usage.log" ;;
    *) echo "Usage: sanchala-screen-time {status|limit APP MINS|report [DAYS]|break [MINS]}" ;;
esac
