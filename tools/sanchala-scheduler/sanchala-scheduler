#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0
# Sanchala Scheduler - User-Friendly Task Automation for Sanchala OS

set -euo pipefail

VERSION="1.0.0"
PROGRAM_NAME="sanchala-scheduler"
CONFIG_DIR="/etc/sanchala/scheduler"
USER_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/sanchala/scheduler"
TASKS_DIR="$USER_CONFIG_DIR/tasks"
SYSTEMD_USER_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/sanchala/scheduler"

# Colors
RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[1;33m'
BLUE='\033[0;34m' CYAN='\033[0;36m' NC='\033[0m' BOLD='\033[1m'

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
for lib in tasks timers templates; do
    [[ -f "${SCRIPT_DIR}/lib/${lib}.sh" ]] && source "${SCRIPT_DIR}/lib/${lib}.sh"
done

print_info() { echo -e "${BLUE}ℹ $1${NC}"; }
print_success() { echo -e "${GREEN}✓ $1${NC}"; }
print_warning() { echo -e "${YELLOW}⚠ $1${NC}"; }
print_error() { echo -e "${RED}✗ $1${NC}"; }

show_version() { echo "$PROGRAM_NAME $VERSION - Sanchala OS"; }

show_help() {
    cat << 'EOF'
SANCHALA SCHEDULER - Easy Task Automation for Sanchala OS

USAGE: sanchala-scheduler <COMMAND> [OPTIONS]

TASK MANAGEMENT:
    list                    List all scheduled tasks
    add <NAME>              Create new scheduled task (interactive)
    remove <NAME>           Remove scheduled task
    enable <NAME>           Enable task
    disable <NAME>          Disable task
    run <NAME>              Run task immediately
    status [NAME]           Show task status

QUICK SCHEDULES:
    quick backup            Schedule automatic backups
    quick cleanup           Schedule system cleanup
    quick update            Schedule system updates

TEMPLATES:
    templates               List available task templates
    from-template <TPL>     Create task from template

MAINTENANCE:
    maintenance list        List maintenance schedules
    maintenance status      Show maintenance status

OPTIONS:
    --json                  JSON output format
    -h, --help              Show this help

EXAMPLES:
    sanchala-scheduler add my-backup
    sanchala-scheduler quick backup
    sanchala-scheduler from-template weekly-cleanup
EOF
}

ensure_dirs() {
    mkdir -p "$USER_CONFIG_DIR" "$TASKS_DIR" "$SYSTEMD_USER_DIR" "$LOG_DIR"
}

main() {
    local json=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) json=true; shift ;;
            -h|--help) show_help; exit 0 ;;
            --version) show_version; exit 0 ;;
            -*) print_error "Unknown: $1"; exit 1 ;;
            *) break ;;
        esac
    done
    
    local cmd="${1:-list}"; shift || true
    case "$cmd" in
        list) cmd_list_tasks "$json" ;;
        add) cmd_add_task "$@" ;;
        remove) cmd_remove_task "$@" ;;
        enable) cmd_enable_task "$@" ;;
        disable) cmd_disable_task "$@" ;;
        run) cmd_run_task "$@" ;;
        status) cmd_status_task "$@" ;;
        quick) cmd_quick_schedule "$@" ;;
        templates) cmd_list_templates ;;
        from-template) cmd_from_template "$@" ;;
        maintenance) cmd_maintenance "$@" ;;
        help) show_help ;;
        *) print_error "Unknown: $cmd"; show_help; exit 1 ;;
    esac
}

main "$@"
