#!/bin/bash
# ============================================
# SANCHALA OS - GPU Detection & Configuration
# ============================================
# Automatically detects and configures GPU drivers
# ============================================

set -e

VERSION="1.0.0"
SCRIPT_NAME="sanchala-gpu-detect"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[OK]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Detect GPU vendor
detect_gpus() {
    log_info "Detecting GPUs..."
    
    AMD_GPU=$(lspci | grep -i "VGA\|3D" | grep -i "AMD\|ATI" || true)
    INTEL_GPU=$(lspci | grep -i "VGA\|3D" | grep -i "Intel" || true)
    NVIDIA_GPU=$(lspci | grep -i "VGA\|3D" | grep -i "NVIDIA" || true)
    
    echo ""
    echo "=== Detected GPUs ==="
    
    if [[ -n "$AMD_GPU" ]]; then
        log_success "AMD GPU: $AMD_GPU"
        HAS_AMD=1
    fi
    
    if [[ -n "$INTEL_GPU" ]]; then
        log_success "Intel GPU: $INTEL_GPU"
        HAS_INTEL=1
    fi
    
    if [[ -n "$NVIDIA_GPU" ]]; then
        log_success "NVIDIA GPU: $NVIDIA_GPU"
        HAS_NVIDIA=1
    fi
    
    if [[ -z "$AMD_GPU" && -z "$INTEL_GPU" && -z "$NVIDIA_GPU" ]]; then
        log_warn "No discrete GPU detected, using VESA fallback"
        HAS_VESA=1
    fi
    echo ""
}

# Show current configuration
show_info() {
    detect_gpus
    
    echo "=== Driver Status ==="
    
    # Check loaded modules
    if lsmod | grep -q amdgpu; then
        log_success "amdgpu module loaded"
    fi
    if lsmod | grep -q i915; then
        log_success "i915 module loaded"
    fi
    if lsmod | grep -q nvidia; then
        log_success "nvidia module loaded"
    elif lsmod | grep -q nouveau; then
        log_warn "nouveau module loaded (open source NVIDIA)"
    fi
    
    echo ""
    echo "=== OpenGL Renderer ==="
    if command -v glxinfo &>/dev/null; then
        glxinfo | grep "OpenGL renderer" || log_warn "Could not detect OpenGL renderer"
    else
        log_warn "glxinfo not available"
    fi
    
    echo ""
    echo "=== Vulkan Devices ==="
    if command -v vulkaninfo &>/dev/null; then
        vulkaninfo --summary 2>/dev/null | grep -E "GPU|deviceName" || log_warn "No Vulkan devices"
    else
        log_warn "vulkaninfo not available"
    fi
    
    echo ""
    echo "=== VA-API Status ==="
    if command -v vainfo &>/dev/null; then
        vainfo 2>&1 | head -5 || log_warn "VA-API not available"
    else
        log_warn "vainfo not available"
    fi
}

# Install NVIDIA drivers
install_nvidia() {
    if [[ $EUID -ne 0 ]]; then
        log_error "Must run as root to install drivers"
        exit 1
    fi
    
    log_info "Installing NVIDIA proprietary drivers..."
    
    pacman -S --needed --noconfirm \
        nvidia-dkms \
        nvidia-utils \
        lib32-nvidia-utils \
        nvidia-settings \
        libva-nvidia-driver \
        opencl-nvidia
    
    # Enable DRM modesetting
    if ! grep -q "nvidia-drm.modeset=1" /etc/default/grub 2>/dev/null; then
        log_info "Enabling NVIDIA DRM modesetting..."
        sed -i 's/GRUB_CMDLINE_LINUX_DEFAULT="/GRUB_CMDLINE_LINUX_DEFAULT="nvidia-drm.modeset=1 /' /etc/default/grub
        grub-mkconfig -o /boot/grub/grub.cfg
    fi
    
    # Enable services
    systemctl enable nvidia-suspend nvidia-resume nvidia-hibernate 2>/dev/null || true
    
    log_success "NVIDIA drivers installed. Please reboot."
}

# Configure hybrid graphics
configure_hybrid() {
    log_info "Configuring hybrid graphics (PRIME)..."
    
    if [[ -n "$HAS_NVIDIA" ]] && [[ -n "$HAS_INTEL" || -n "$HAS_AMD" ]]; then
        log_info "NVIDIA Optimus detected"
        echo "Use: __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia <app>"
    elif [[ -n "$HAS_AMD" ]] && [[ -n "$HAS_INTEL" ]]; then
        log_info "AMD + Intel hybrid detected"
        echo "Use: DRI_PRIME=1 <app>"
    else
        log_info "Single GPU configuration, no PRIME needed"
    fi
}

# Main
usage() {
    echo "Usage: $SCRIPT_NAME [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  --info              Show detected GPUs and driver status"
    echo "  --install-nvidia    Install NVIDIA proprietary drivers"
    echo "  --configure         Configure detected GPUs"
    echo "  --version           Show version"
    echo "  --help              Show this help"
}

case "${1:-}" in
    --info|-i)
        show_info
        ;;
    --install-nvidia)
        detect_gpus
        if [[ -z "$HAS_NVIDIA" ]]; then
            log_error "No NVIDIA GPU detected"
            exit 1
        fi
        install_nvidia
        ;;
    --configure|-c)
        detect_gpus
        configure_hybrid
        ;;
    --version|-v)
        echo "$SCRIPT_NAME version $VERSION"
        ;;
    --help|-h|"")
        usage
        ;;
    *)
        log_error "Unknown option: $1"
        usage
        exit 1
        ;;
esac
