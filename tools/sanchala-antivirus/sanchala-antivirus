# Sanchala Antivirus - Malware Detection & Protection
set -euo pipefail

VERSION="1.0.0"
STATE_DIR="/var/lib/sanchala/antivirus"
QUARANTINE_DIR="$STATE_DIR/quarantine"
AUDIT_LOG="/var/log/sanchala/antivirus-audit.log"

RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[1;33m' BLUE='\033[0;34m' NC='\033[0m'

log_audit() { echo "[$(date -Iseconds)] $1: ${2:-}" >> "$AUDIT_LOG" 2>/dev/null || true; }
check_root() { [[ $EUID -eq 0 ]] || { echo -e "${RED}✗ Root required${NC}"; exit 1; }; }
init_dirs() { mkdir -p "$STATE_DIR" "$QUARANTINE_DIR"; chmod 700 "$QUARANTINE_DIR"; }

cmd_status() {
    echo -e "${BLUE}Antivirus Status${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━"
    if command -v clamscan &>/dev/null; then
        echo -e "Engine: ${GREEN}ClamAV${NC}"
        clamscan --version 2>/dev/null | head -1
    else
        echo -e "Engine: ${YELLOW}Basic scanner${NC}"
    fi
    echo "Quarantine: $(find "$QUARANTINE_DIR" -type f 2>/dev/null | wc -l) items"
    [[ -f "$STATE_DIR/last_scan" ]] && echo "Last scan: $(cat "$STATE_DIR/last_scan")"
}

cmd_scan() {
    local target="${1:-/home}"
    echo -e "${BLUE}Scanning: $target${NC}"
    init_dirs
    local threats=0
    if command -v clamscan &>/dev/null; then
        clamscan -r --infected "$target" 2>/dev/null | tee "$STATE_DIR/scan.log"
        threats=$(grep -c "FOUND" "$STATE_DIR/scan.log" 2>/dev/null || echo 0)
    else
        echo "Running basic pattern scan..."
        while IFS= read -r -d '' f; do
            if grep -lqE '(eval\s*\(base64|curl.*\|.*sh|/dev/tcp/)' "$f" 2>/dev/null; then
                echo -e "${RED}⚠ Suspicious: $f${NC}"
                ((threats++)) || true
            fi
        done < <(find "$target" -type f \( -name "*.sh" -o -executable \) -print0 2>/dev/null)
    fi
    date -Iseconds > "$STATE_DIR/last_scan"
    log_audit "SCAN" "Target: $target, Threats: $threats"
    ((threats > 0)) && echo -e "${RED}✗ Found $threats threats${NC}" || echo -e "${GREEN}✓ No threats${NC}"
}

cmd_quarantine() {
    check_root; init_dirs
    local file="$1"
    [[ -f "$file" ]] || { echo -e "${RED}✗ Not found${NC}"; exit 1; }
    local hash
    hash=$(sha256sum "$file" | cut -d' ' -f1)
    mv "$file" "$QUARANTINE_DIR/${hash}_$(basename "$file")"
    chmod 000 "$QUARANTINE_DIR/${hash}_$(basename "$file")"
    log_audit "QUARANTINE" "$file"
    echo -e "${GREEN}✓ Quarantined: $file${NC}"
}

case "${1:-status}" in
    status) cmd_status ;; scan) cmd_scan "${2:-/home}" ;; quick) cmd_scan "$HOME" ;;
    full) check_root; cmd_scan "/" ;; quarantine) cmd_quarantine "$2" ;;
    update) check_root; freshclam 2>/dev/null && echo -e "${GREEN}✓ Updated${NC}" || echo "Install clamav" ;;
    *) echo "Usage: sanchala-antivirus {status|scan [PATH]|quick|full|quarantine FILE|update}" ;;
esac
