#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0
# Sanchala Password Health - Password Security Analyzer
set -euo pipefail

VERSION="1.0.0"
STATE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/sanchala/password-health"
HIBP_API="https://api.pwnedpasswords.com/range"

RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[1;33m' BLUE='\033[0;34m' NC='\033[0m'

mkdir -p "$STATE_DIR"

check_strength() {
    local pass="$1" score=0 feedback=""
    local len=${#pass}
    
    ((len >= 8)) && ((score+=1))
    ((len >= 12)) && ((score+=1))
    ((len >= 16)) && ((score+=2))
    [[ "$pass" =~ [a-z] ]] && ((score+=1))
    [[ "$pass" =~ [A-Z] ]] && ((score+=1))
    [[ "$pass" =~ [0-9] ]] && ((score+=1))
    [[ "$pass" =~ [^a-zA-Z0-9] ]] && ((score+=2))
    
    # Check common patterns
    [[ "$pass" =~ (123|abc|qwerty|password|admin) ]] && ((score-=2)) && feedback+="Contains common pattern. "
    [[ "$pass" =~ (.)\1{2,} ]] && ((score-=1)) && feedback+="Repeated characters. "
    
    echo "$score|$feedback"
}

check_breach() {
    local pass="$1"
    local sha1=$(echo -n "$pass" | openssl dgst -sha1 | cut -d' ' -f2 | tr 'a-f' 'A-F')
    local prefix="${sha1:0:5}" suffix="${sha1:5}"
    
    local response=$(curl -s "${HIBP_API}/${prefix}" 2>/dev/null || echo "")
    [[ -z "$response" ]] && { echo "0|API unavailable"; return; }
    
    local count=$(echo "$response" | grep -i "^${suffix}:" | cut -d: -f2 | tr -d '\r' || echo "0")
    echo "${count:-0}"
}

cmd_analyze() {
    read -rsp "Enter password to analyze: " pass; echo
    echo -e "\n${BLUE}Password Analysis${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━"
    
    local result=$(check_strength "$pass")
    local score=$(echo "$result" | cut -d'|' -f1)
    local feedback=$(echo "$result" | cut -d'|' -f2)
    
    echo -n "Strength: "
    if ((score >= 8)); then echo -e "${GREEN}Excellent ($score/10)${NC}"
    elif ((score >= 6)); then echo -e "${GREEN}Good ($score/10)${NC}"
    elif ((score >= 4)); then echo -e "${YELLOW}Fair ($score/10)${NC}"
    else echo -e "${RED}Weak ($score/10)${NC}"; fi
    
    [[ -n "$feedback" ]] && echo -e "Issues: ${YELLOW}$feedback${NC}"
    
    echo -n "Breach check: "
    local breach=$(check_breach "$pass")
    if [[ "$breach" == "0" ]]; then
        echo -e "${GREEN}Not found in breaches${NC}"
    elif [[ "$breach" == *"unavailable"* ]]; then
        echo -e "${YELLOW}Could not check (offline)${NC}"
    else
        echo -e "${RED}Found in $breach breaches!${NC}"
    fi
}

cmd_generate() {
    local len="${1:-20}" charset='A-Za-z0-9!@#$%^&*'
    local pass=$(tr -dc "$charset" < /dev/urandom | head -c "$len")
    echo -e "${GREEN}Generated:${NC} $pass"
    local result=$(check_strength "$pass")
    echo "Strength: $(echo "$result" | cut -d'|' -f1)/10"
}

case "${1:-help}" in
    analyze|check) cmd_analyze ;;
    generate) cmd_generate "${2:-20}" ;;
    *) echo "Usage: sanchala-password-health {analyze|generate [LENGTH]}" ;;
esac
