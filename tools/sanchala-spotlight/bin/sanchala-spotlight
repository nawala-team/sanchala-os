#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0
# Sanchala Spotlight - macOS-style universal search
"""Fast, intelligent search for apps, files, calculations, and more"""

import sys, json, argparse, subprocess, os, re
from pathlib import Path
from datetime import datetime

VERSION = "1.0.0"
CONFIG_DIR = Path.home() / ".config" / "sanchala" / "spotlight"
CACHE_DIR = Path.home() / ".cache" / "sanchala" / "spotlight"

class SpotlightSearch:
    def __init__(self):
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
    
    def search_apps(self, query: str):
        results = []
        app_dirs = ["/usr/share/applications", Path.home() / ".local/share/applications"]
        for d in app_dirs:
            if not Path(d).exists(): continue
            for f in Path(d).glob("*.desktop"):
                try:
                    content = f.read_text()
                    name = re.search(r'^Name=(.+)$', content, re.M)
                    if name and query.lower() in name.group(1).lower():
                        exec_cmd = re.search(r'^Exec=(.+)$', content, re.M)
                        icon = re.search(r'^Icon=(.+)$', content, re.M)
                        results.append({
                            "type": "app", "name": name.group(1),
                            "exec": exec_cmd.group(1) if exec_cmd else "",
                            "icon": icon.group(1) if icon else "application"
                        })
                except: continue
        return results[:10]
    
    def search_files(self, query: str):
        results = []
        try:
            proc = subprocess.run(
                ["locate", "-i", "-l", "20", query],
                capture_output=True, text=True, timeout=5
            )
            for line in proc.stdout.strip().split('\n'):
                if line and Path(line).exists():
                    results.append({"type": "file", "path": line, "name": Path(line).name})
        except: pass
        return results[:10]
    
    def search_calc(self, query: str):
        # Simple calculator
        try:
            # Safe eval for math
            allowed = set('0123456789+-*/().% ')
            if all(c in allowed for c in query):
                result = eval(query)
                return [{"type": "calc", "query": query, "result": str(result)}]
        except: pass
        return []
    
    def search_web(self, query: str):
        return [{"type": "web", "query": query, 
                 "url": f"https://duckduckgo.com/?q={query.replace(' ', '+')}"}]
    
    def search(self, query: str):
        results = []
        
        # Check if it's a calculation
        if re.match(r'^[\d\s+\-*/().%]+$', query):
            results.extend(self.search_calc(query))
        
        # Search apps
        results.extend(self.search_apps(query))
        
        # Search files
        results.extend(self.search_files(query))
        
        # Add web search option
        results.extend(self.search_web(query))
        
        return results

def cmd_search(args):
    spotlight = SpotlightSearch()
    results = spotlight.search(args.query)
    
    print(f"\n🔍 Spotlight: '{args.query}'\n" + "━"*50)
    
    for i, r in enumerate(results, 1):
        if r["type"] == "app":
            print(f"  {i}. 📱 {r['name']}")
        elif r["type"] == "file":
            print(f"  {i}. 📄 {r['name']}\n        {r['path']}")
        elif r["type"] == "calc":
            print(f"  {i}. 🧮 {r['query']} = {r['result']}")
        elif r["type"] == "web":
            print(f"  {i}. 🌐 Search web for '{r['query']}'")
    
    print()
    return 0

def cmd_open(args):
    spotlight = SpotlightSearch()
    results = spotlight.search(args.query)
    
    if not results:
        print("No results found")
        return 1
    
    r = results[0]
    if r["type"] == "app":
        subprocess.Popen(r["exec"].split()[0], shell=True)
        print(f"Opened: {r['name']}")
    elif r["type"] == "file":
        subprocess.run(["xdg-open", r["path"]])
    elif r["type"] == "web":
        subprocess.run(["xdg-open", r["url"]])
    
    return 0

def cmd_gui(args):
    # Launch KRunner or similar
    cmds = ["krunner", "rofi -show drun", "dmenu_run", "wofi --show drun"]
    for cmd in cmds:
        try:
            subprocess.Popen(cmd.split())
            return 0
        except: continue
    print("No launcher found. Install: krunner, rofi, or wofi")
    return 1

def main():
    p = argparse.ArgumentParser(prog="sanchala-spotlight", description="🔍 Spotlight Search")
    p.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    sub = p.add_subparsers(dest="cmd")
    
    s = sub.add_parser("search", help="Search")
    s.add_argument("query", nargs="+")
    
    s = sub.add_parser("open", help="Search and open")
    s.add_argument("query", nargs="+")
    
    sub.add_parser("gui", help="Open GUI launcher")
    
    # Direct query
    p.add_argument("query", nargs="*")
    
    args = p.parse_args()
    
    if args.cmd == "search":
        args.query = " ".join(args.query)
        return cmd_search(args)
    if args.cmd == "open":
        args.query = " ".join(args.query)
        return cmd_open(args)
    if args.cmd == "gui":
        return cmd_gui(args)
    if args.query:
        args.query = " ".join(args.query)
        return cmd_search(args)
    
    return cmd_gui(args)

if __name__ == "__main__": sys.exit(main())
