#!/usr/bin/env python3
"""Sanchala OCR - Text extraction from images using Tesseract"""

import sys
import json
import argparse
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent / "lib"))

def main():
    parser = argparse.ArgumentParser(prog="sanchala-ocr", description="Extract text from images")
    parser.add_argument("image", help="Image file to scan")
    parser.add_argument("-l", "--lang", default="eng", help="OCR language (default: eng)")
    parser.add_argument("-o", "--output", help="Save text to file")
    parser.add_argument("--pdf", help="Create searchable PDF")
    parser.add_argument("--json", action="store_true", help="JSON output")
    parser.add_argument("--list-langs", action="store_true", help="List available languages")
    args = parser.parse_args()
    
    from sanchala_aid import TesseractOCR, Config
    ocr = TesseractOCR(Config())
    
    if args.list_langs:
        for lang in ocr.list_languages():
            print(lang)
        return
    
    if not ocr.is_available():
        print("Error: Tesseract not installed. Run: sudo pacman -S tesseract", file=sys.stderr)
        sys.exit(1)
    
    if not Path(args.image).exists():
        print(f"Error: File not found: {args.image}", file=sys.stderr)
        sys.exit(1)
    
    if args.pdf:
        result = ocr.to_searchable_pdf(args.image, args.pdf, args.lang)
        if args.json:
            print(json.dumps(result, indent=2))
        elif result.get("success"):
            print(f"Created: {result['output']}")
        else:
            print(f"Error: {result.get('error')}", file=sys.stderr)
            sys.exit(1)
    else:
        result = ocr.extract_text(args.image, args.lang)
        if args.json:
            print(json.dumps(result, indent=2))
        elif result.get("error"):
            print(f"Error: {result['error']}", file=sys.stderr)
            sys.exit(1)
        else:
            text = result.get("text", "")
            if args.output:
                Path(args.output).write_text(text)
                print(f"Saved to: {args.output}")
            else:
                print(text)

if __name__ == "__main__":
    main()
