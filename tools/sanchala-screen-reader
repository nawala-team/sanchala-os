#!/bin/bash
# SANCHALA-SCREEN-READER - Advanced Screen Reader for Sanchala OS
# WCAG 2.1 AAA Compliant | Copyright (c) 2025 Sanchala OS Project
set -euo pipefail

VERSION="1.0.0"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/sanchala/accessibility"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/sanchala/screen-reader"
PID_FILE="/tmp/sanchala-screen-reader.pid"

declare -A SPEECH=([rate]=175 [pitch]=50 [volume]=80 [lang]=en-US [punctuation]=some)
declare -A NAV=([unit]=line [auto_read]=true [verbosity]=medium [braille]=false)

mkdir -p "$CONFIG_DIR" "$DATA_DIR"

detect_tts() {
    for e in espeak-ng espeak festival flite say; do
        command -v "$e" &>/dev/null && echo "$e" && return
    done; echo "none"
}

speak() {
    local text="$1" pri="${2:-normal}" eng=$(detect_tts)
    [[ -z "$text" ]] && return
    case "$eng" in
        espeak-ng|espeak) [[ "$pri" == "interrupt" ]] && pkill -f espeak 2>/dev/null ||:
            $eng -s "${SPEECH[rate]}" -p "${SPEECH[pitch]}" -a "$((SPEECH[volume]*2))" "$text" & ;;
        festival) echo "$text" | festival --tts & ;;
        flite) flite -t "$text" & ;;
        say) say -r "${SPEECH[rate]}" "$text" & ;;
        *) echo "[SPEAK] $text" ;;
    esac
}

stop_speech() { pkill -f "espeak\|festival\|flite" 2>/dev/null ||:; }

read_focus() {
    python3 -c "
import gi; gi.require_version('Atspi','2.0')
from gi.repository import Atspi
f=Atspi.get_focused_object()
print(f'{f.get_role_name()}: {f.get_name()}' if f else 'No focus')" 2>/dev/null || echo "AT-SPI unavailable"
}

start_service() {
    [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null && echo "Already running" && exit 1
    echo $$ > "$PID_FILE"; speak "Screen Reader active" "interrupt"
    trap 'rm -f "$PID_FILE"; exit' SIGTERM SIGINT; while :; do sleep 1; done
}

stop_service() { [[ -f "$PID_FILE" ]] && kill "$(cat "$PID_FILE")" 2>/dev/null; rm -f "$PID_FILE"; echo "Stopped"; }

status() {
    if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        echo "● Screen Reader running (PID: $(cat "$PID_FILE")) | Engine: $(detect_tts)"
    else echo "○ Screen Reader not running"; fi
}

case "${1:-status}" in
    start) start_service ;; stop) stop_service ;; status) status ;;
    toggle) [[ -f "$PID_FILE" ]] && stop_service || start_service & ;;
    --speak) shift; speak "$*" ;; --stop) stop_speech ;;
    --rate) SPEECH[rate]="$2"; speak "Rate $2" ;;
    --volume) SPEECH[volume]="$2"; speak "Volume $2" ;;
    --read-focus) speak "$(read_focus)" ;;
    --help|-h) echo "Usage: sanchala-screen-reader {start|stop|status|--speak TEXT|--rate N|--volume N}" ;;
    --version|-v) echo "v$VERSION" ;; *) echo "Unknown: $1"; exit 1 ;;
esac
