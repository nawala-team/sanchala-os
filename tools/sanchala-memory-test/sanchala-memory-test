#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0
# Sanchala Memory Test - RAM Diagnostics
set -euo pipefail
VERSION="1.0.0"
PROGRAM_NAME="sanchala-memory-test"
RED="\033[0;31m" GREEN="\033[0;32m" YELLOW="\033[1;33m" BLUE="\033[0;34m" NC="\033[0m" BOLD="\033[1m"
print_info() { echo -e "${BLUE}i $1${NC}"; }
print_success() { echo -e "${GREEN}ok $1${NC}"; }
print_warning() { echo -e "${YELLOW}! $1${NC}"; }
print_error() { echo -e "${RED}x $1${NC}"; }
check_root() { [[ $EUID -eq 0 ]] || { print_error "Root required"; exit 1; }; }
show_help() {
cat << HELP
SANCHALA MEMORY TEST - RAM Diagnostics
USAGE: sanchala-memory-test <COMMAND>
COMMANDS:
  quick             Quick memory test (~1 min)
  standard          Standard test (~5 min)
  extended          Extended test (~30 min)
  stress <MINS>     Stress test for N minutes
  status            Show memory status
  info              Show memory hardware info
  errors            Check for memory errors
  configure-boot    Add memtest to boot menu
OPTIONS:
  --size <MB>       Test specific amount of RAM
  -h, --help        Show this help
HELP
}
cmd_quick() {
    print_info "Quick memory test..."
    local size=${1:-256}
    if command -v memtester &>/dev/null; then
        memtester "${size}M" 1
    else
        print_info "Using built-in test..."
        local tmp=$(mktemp)
        dd if=/dev/urandom of="$tmp" bs=1M count="$size" 2>/dev/null
        local sum1=$(md5sum "$tmp" | cut -d' ' -f1)
        sync; echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
        local sum2=$(md5sum "$tmp" | cut -d' ' -f1)
        rm -f "$tmp"
        [[ "$sum1" == "$sum2" ]] && print_success "Memory OK" || print_error "Memory error!"
    fi
}
cmd_standard() {
    print_info "Standard memory test..."
    if command -v memtester &>/dev/null; then
        local free=$(awk '/MemAvailable/{print int($2/1024/2)}' /proc/meminfo)
        memtester "${free}M" 1
    else
        cmd_quick 512
    fi
}
cmd_extended() {
    print_info "Extended memory test..."
    if command -v memtester &>/dev/null; then
        local free=$(awk '/MemAvailable/{print int($2/1024*0.8)}' /proc/meminfo)
        memtester "${free}M" 3
    else
        for i in 1 2 3; do print_info "Pass $i/3"; cmd_quick 1024; done
    fi
}
cmd_stress() {
    local mins="${1:-5}"
    print_info "Stress test for $mins minutes..."
    if command -v stress-ng &>/dev/null; then
        stress-ng --vm 2 --vm-bytes 75% --timeout "${mins}m" --metrics-brief
    elif command -v stress &>/dev/null; then
        stress --vm 2 --vm-bytes 512M --timeout "${mins}m"
    else
        print_warning "stress-ng not found, using basic test"
        local end=$((SECONDS + mins*60))
        while [[ $SECONDS -lt $end ]]; do cmd_quick 256; done
    fi
    print_success "Stress test complete"
}
cmd_status() {
    echo -e "${BOLD}Memory Status:${NC}"
    free -h
    echo ""
    echo -e "${BOLD}Top Memory Users:${NC}"
    ps aux --sort=-%mem | head -6
}
cmd_info() {
    echo -e "${BOLD}Memory Hardware:${NC}"
    if command -v dmidecode &>/dev/null; then
        dmidecode -t memory 2>/dev/null | grep -E "Size|Type|Speed" | head -20
    else
        cat /proc/meminfo | head -10
    fi
}
cmd_errors() {
    echo -e "${BOLD}Memory Errors:${NC}"
    if [[ -d /sys/devices/system/edac/mc ]]; then
        for mc in /sys/devices/system/edac/mc/mc*; do
            [[ -d "$mc" ]] || continue
            echo "$(basename $mc): CE=$(cat $mc/ce_count 2>/dev/null||echo 0) UE=$(cat $mc/ue_count 2>/dev/null||echo 0)"
        done
    else
        print_info "EDAC not available"
    fi
    dmesg 2>/dev/null | grep -iE "memory|ram" | grep -iE "error|fail" | tail -5 || echo "No errors"
}
cmd_configure_boot() {
    print_info "Adding memtest to boot menu..."
    if [[ -f /boot/memtest86+.bin ]]; then
        update-grub 2>/dev/null || grub-mkconfig -o /boot/grub/grub.cfg
        print_success "Memtest added"
    else
        print_warning "memtest86+ not installed"
    fi
}
main() {
    case "${1:-help}" in
        quick) check_root; shift; cmd_quick "$@";; standard) check_root; cmd_standard;;
        extended) check_root; cmd_extended;; stress) check_root; shift; cmd_stress "$@";;
        status) cmd_status;; info) cmd_info;; errors) cmd_errors;;
        configure-boot) check_root; cmd_configure_boot;;
        -h|--help|help) show_help;; --version) echo "$PROGRAM_NAME $VERSION";; *) print_error "Unknown: $1"; exit 1;;
    esac
}
main "$@"
