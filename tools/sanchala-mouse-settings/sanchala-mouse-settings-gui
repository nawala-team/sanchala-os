#!/usr/bin/env python3
"""Sanchala Mouse Settings GUI"""
import sys, subprocess
from PyQt6.QtWidgets import *
from PyQt6.QtCore import *
from PyQt6.QtGui import *

class MouseSettings(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Sanchala Mouse Settings")
        self.setMinimumSize(450, 400)
        self.init_ui()
    
    def init_ui(self):
        w = QWidget()
        self.setCentralWidget(w)
        layout = QVBoxLayout(w)
        
        # Mouse section
        mouse_grp = QGroupBox("Mouse")
        mouse_l = QFormLayout(mouse_grp)
        self.speed = QSlider(Qt.Orientation.Horizontal)
        self.speed.setRange(-10, 10)
        self.speed.setValue(0)
        mouse_l.addRow("Speed:", self.speed)
        self.accel = QSlider(Qt.Orientation.Horizontal)
        self.accel.setRange(0, 10)
        self.accel.setValue(5)
        mouse_l.addRow("Acceleration:", self.accel)
        self.left_handed = QCheckBox("Left-handed mode")
        mouse_l.addRow("", self.left_handed)
        self.natural_scroll = QCheckBox("Natural scrolling")
        mouse_l.addRow("", self.natural_scroll)
        layout.addWidget(mouse_grp)
        
        # Touchpad section
        tp_grp = QGroupBox("Touchpad")
        tp_l = QVBoxLayout(tp_grp)
        self.tap_click = QCheckBox("Tap to click")
        self.tap_click.setChecked(True)
        self.two_finger = QCheckBox("Two-finger scrolling")
        self.two_finger.setChecked(True)
        self.disable_typing = QCheckBox("Disable while typing")
        self.disable_typing.setChecked(True)
        self.tp_enabled = QCheckBox("Touchpad enabled")
        self.tp_enabled.setChecked(True)
        tp_l.addWidget(self.tap_click)
        tp_l.addWidget(self.two_finger)
        tp_l.addWidget(self.disable_typing)
        tp_l.addWidget(self.tp_enabled)
        layout.addWidget(tp_grp)
        
        # Double-click
        dc_row = QHBoxLayout()
        dc_row.addWidget(QLabel("Double-click speed:"))
        self.dclick = QSlider(Qt.Orientation.Horizontal)
        self.dclick.setRange(100, 800)
        self.dclick.setValue(400)
        dc_row.addWidget(self.dclick)
        layout.addLayout(dc_row)
        
        layout.addStretch()
        
        apply_btn = QPushButton("Apply")
        apply_btn.clicked.connect(self.apply_settings)
        layout.addWidget(apply_btn)
    
    def apply_settings(self):
        # Apply via xinput
        speed = self.speed.value() / 10.0
        try:
            devices = subprocess.check_output(["xinput", "list", "--name-only"], text=True).split("\n")
            for dev in devices:
                if "mouse" in dev.lower() or "touchpad" in dev.lower():
                    subprocess.run(["xinput", "set-prop", dev, "libinput Accel Speed", str(speed)], stderr=subprocess.DEVNULL)
                    if self.natural_scroll.isChecked():
                        subprocess.run(["xinput", "set-prop", dev, "libinput Natural Scrolling Enabled", "1"], stderr=subprocess.DEVNULL)
        except: pass
        QMessageBox.information(self, "Applied", "Mouse settings applied.")

if __name__ == "__main__":
    app = QApplication(sys.argv)
    w = MouseSettings()
    w.show()
    sys.exit(app.exec())
