#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0
# Sanchala USB Guard - USB Device Security Manager
set -euo pipefail

VERSION="1.0.0"
CONFIG_DIR="/etc/sanchala/usb-guard"
RULES_FILE="$CONFIG_DIR/rules.conf"
AUDIT_LOG="/var/log/sanchala/usb-guard-audit.log"

RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[1;33m' BLUE='\033[0;34m' NC='\033[0m'

log_audit() { echo "[$(date -Iseconds)] $1: ${2:-}" >> "$AUDIT_LOG" 2>/dev/null || true; }
check_root() { [[ $EUID -eq 0 ]] || { echo -e "${RED}✗ Root required${NC}"; exit 1; }; }
init_config() { mkdir -p "$CONFIG_DIR"; [[ -f "$RULES_FILE" ]] || echo "# USB Guard Rules" > "$RULES_FILE"; }

cmd_status() {
    echo -e "${BLUE}USB Guard Status${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "Connected USB devices:"
    lsusb 2>/dev/null | while read -r line; do echo "  $line"; done
}

cmd_list() {
    echo -e "${BLUE}Connected USB Devices:${NC}"
    lsusb 2>/dev/null | while read -r line; do
        local id name status
        id=$(echo "$line" | grep -oP 'ID \K[0-9a-f:]+')
        name=$(echo "$line" | sed 's/.*ID [0-9a-f:]* //')
        status="${GREEN}allowed${NC}"
        grep -q "block.*$id" "$RULES_FILE" 2>/dev/null && status="${RED}blocked${NC}"
        echo -e "  [$status] $id - $name"
    done
}

cmd_allow() {
    check_root; init_config
    sed -i "/block.*$1/d" "$RULES_FILE" 2>/dev/null || true
    echo "allow $1" >> "$RULES_FILE"
    log_audit "ALLOW" "$1"; echo -e "${GREEN}✓ Allowed: $1${NC}"
}

cmd_block() {
    check_root; init_config
    sed -i "/allow.*$1/d" "$RULES_FILE" 2>/dev/null || true
    echo "block $1" >> "$RULES_FILE"
    log_audit "BLOCK" "$1"; echo -e "${RED}✓ Blocked: $1${NC}"
}

cmd_lockdown() {
    check_root
    echo 0 > /sys/bus/usb/drivers_autoprobe 2>/dev/null || true
    log_audit "LOCKDOWN" "enabled"; echo -e "${GREEN}✓ USB lockdown active${NC}"
}

cmd_unlock() {
    check_root
    echo 1 > /sys/bus/usb/drivers_autoprobe 2>/dev/null || true
    log_audit "UNLOCK" "disabled"; echo -e "${GREEN}✓ USB devices enabled${NC}"
}

case "${1:-status}" in
    status) cmd_status ;; list|ls) cmd_list ;; allow) cmd_allow "$2" ;;
    block) cmd_block "$2" ;; lockdown) cmd_lockdown ;; unlock) cmd_unlock ;;
    rules) cat "$RULES_FILE" 2>/dev/null || echo "No rules" ;;
    *) echo "Usage: sanchala-usb-guard {status|list|allow ID|block ID|lockdown|unlock|rules}" ;;
esac
