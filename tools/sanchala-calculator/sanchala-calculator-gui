#!/usr/bin/env python3
"""Sanchala Calculator - Scientific Calculator GUI"""
import sys, math
from PyQt6.QtWidgets import *
from PyQt6.QtCore import *
from PyQt6.QtGui import *

class Calculator(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Sanchala Calculator")
        self.setFixedSize(320, 450)
        self.expression = ""
        self.init_ui()
    
    def init_ui(self):
        w = QWidget()
        self.setCentralWidget(w)
        layout = QVBoxLayout(w)
        layout.setSpacing(5)
        
        # Display
        self.display = QLineEdit("0")
        self.display.setReadOnly(True)
        self.display.setAlignment(Qt.AlignmentFlag.AlignRight)
        self.display.setStyleSheet("font-size: 28px; padding: 15px; background: #2c3e50; color: white; border-radius: 8px;")
        layout.addWidget(self.display)
        
        # Buttons
        buttons = [
            ["C", "(", ")", "/"],
            ["7", "8", "9", "*"],
            ["4", "5", "6", "-"],
            ["1", "2", "3", "+"],
            ["0", ".", "±", "="],
        ]
        
        for row in buttons:
            h = QHBoxLayout()
            for txt in row:
                btn = QPushButton(txt)
                btn.setFixedSize(70, 55)
                btn.setStyleSheet("""
                    QPushButton { font-size: 20px; border-radius: 8px; background: #34495e; color: white; }
                    QPushButton:hover { background: #4a6fa5; }
                    QPushButton:pressed { background: #2c3e50; }
                """)
                if txt in "+-*/=":
                    btn.setStyleSheet(btn.styleSheet().replace("#34495e", "#e67e22"))
                elif txt == "C":
                    btn.setStyleSheet(btn.styleSheet().replace("#34495e", "#e74c3c"))
                btn.clicked.connect(lambda _, t=txt: self.on_click(t))
                h.addWidget(btn)
            layout.addLayout(h)
    
    def on_click(self, txt):
        if txt == "C":
            self.expression = ""
            self.display.setText("0")
        elif txt == "=":
            try:
                result = eval(self.expression)
                self.display.setText(str(result))
                self.expression = str(result)
            except:
                self.display.setText("Error")
                self.expression = ""
        elif txt == "±":
            if self.expression and self.expression[0] == "-":
                self.expression = self.expression[1:]
            elif self.expression:
                self.expression = "-" + self.expression
            self.display.setText(self.expression or "0")
        else:
            self.expression += txt
            self.display.setText(self.expression)

if __name__ == "__main__":
    app = QApplication(sys.argv)
    w = Calculator()
    w.show()
    sys.exit(app.exec())
