#!/usr/bin/env python3
"""Sanchala Reminders - Task and Reminder Management"""
import sys, json
from datetime import datetime
from pathlib import Path
from PyQt6.QtWidgets import *
from PyQt6.QtCore import *
from PyQt6.QtGui import *

class RemindersApp(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Sanchala Reminders")
        self.setMinimumSize(700, 500)
        self.data_dir = Path.home() / ".local/share/sanchala/reminders"
        self.data_dir.mkdir(parents=True, exist_ok=True)
        self.data = self.load()
        self.init_ui()
    
    def init_ui(self):
        self.setStyleSheet("QMainWindow{background:#1e1e2e;}QLabel{color:#cdd6f4;}QPushButton{background:#313244;color:#cdd6f4;border:none;padding:10px;border-radius:6px;}QPushButton:hover{background:#45475a;}QListWidget{background:#313244;color:#cdd6f4;border:none;border-radius:8px;}")
        c = QWidget(); self.setCentralWidget(c); m = QHBoxLayout(c)
        
        # Sidebar - Lists
        side = QVBoxLayout()
        side.addWidget(QLabel("📋 My Lists"))
        self.lists = QListWidget()
        self.lists.addItems(["📥 All", "⭐ Important", "📅 Today", "📆 Scheduled", "✅ Completed"])
        self.lists.currentRowChanged.connect(self.filter_list)
        side.addWidget(self.lists)
        add_list = QPushButton("+ New List"); add_list.clicked.connect(self.new_list)
        side.addWidget(add_list)
        m.addLayout(side, 1)
        
        # Main content
        main = QVBoxLayout()
        top = QHBoxLayout()
        self.title = QLabel("📥 All Reminders"); self.title.setStyleSheet("font-size:20px;font-weight:bold;")
        top.addWidget(self.title); top.addStretch()
        add = QPushButton("+ Add Reminder"); add.setStyleSheet("background:#89b4fa;color:#1e1e2e;")
        add.clicked.connect(self.add_reminder); top.addWidget(add)
        main.addLayout(top)
        
        self.reminders = QListWidget()
        self.reminders.setStyleSheet("QListWidget::item{padding:10px;border-bottom:1px solid #45475a;}")
        main.addWidget(self.reminders)
        m.addLayout(main, 2)
        self.refresh()
    
    def load(self):
        f = self.data_dir / "reminders.json"
        return json.loads(f.read_text()) if f.exists() else {"items": [], "lists": ["Personal", "Work", "Shopping"]}
    
    def save(self):
        (self.data_dir / "reminders.json").write_text(json.dumps(self.data, indent=2))
    
    def refresh(self):
        self.reminders.clear()
        for r in self.data.get("items", []):
            icon = "✅" if r.get("done") else "⭕"
            star = "⭐" if r.get("important") else ""
            item = QListWidgetItem(f"{icon} {star} {r['title']}")
            if r.get("done"): item.setForeground(QColor("#888"))
            self.reminders.addItem(item)
    
    def filter_list(self, idx):
        filters = ["all", "important", "today", "scheduled", "completed"]
        f = filters[idx] if idx < len(filters) else "all"
        self.title.setText(self.lists.currentItem().text() if self.lists.currentItem() else "All")
        self.reminders.clear()
        for r in self.data.get("items", []):
            show = f == "all" or (f == "important" and r.get("important")) or (f == "completed" and r.get("done")) or (f == "today" and r.get("date") == datetime.now().strftime("%Y-%m-%d")) or (f == "scheduled" and r.get("date"))
            if show:
                icon = "✅" if r.get("done") else "⭕"
                self.reminders.addItem(f"{icon} {'⭐' if r.get('important') else ''} {r['title']}")
    
    def add_reminder(self):
        dlg = QDialog(self); dlg.setWindowTitle("Add Reminder"); dlg.setMinimumWidth(350)
        l = QFormLayout(dlg)
        title = QLineEdit(); date = QDateEdit(QDate.currentDate()); time = QTimeEdit()
        important = QCheckBox("Mark as important")
        notes = QTextEdit(); notes.setMaximumHeight(60)
        l.addRow("Title:", title); l.addRow("Date:", date); l.addRow("Time:", time)
        l.addRow("", important); l.addRow("Notes:", notes)
        b = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok|QDialogButtonBox.StandardButton.Cancel)
        b.accepted.connect(dlg.accept); b.rejected.connect(dlg.reject); l.addRow(b)
        if dlg.exec() == QDialog.DialogCode.Accepted and title.text():
            self.data["items"].append({"title": title.text(), "date": date.date().toString("yyyy-MM-dd"), "time": time.time().toString("HH:mm"), "important": important.isChecked(), "notes": notes.toPlainText(), "done": False})
            self.save(); self.refresh()
    
    def new_list(self):
        name, ok = QInputDialog.getText(self, "New List", "List name:")
        if ok and name:
            self.data["lists"].append(name); self.save()
            self.lists.addItem(f"📁 {name}")

if __name__ == "__main__":
    app = QApplication(sys.argv); w = RemindersApp(); w.show(); sys.exit(app.exec())
