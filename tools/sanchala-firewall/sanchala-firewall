# Sanchala Firewall - Advanced Network Security Manager
set -euo pipefail

VERSION="1.0.0"
CONFIG_DIR="/etc/sanchala/firewall"
STATE_DIR="/var/lib/sanchala/firewall"
AUDIT_LOG="/var/log/sanchala/firewall-audit.log"

umask 077
RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[1;33m' BLUE='\033[0;34m' NC='\033[0m' BOLD='\033[1m'

log_audit() { echo "[$(date -Iseconds)] $1: $2" >> "$AUDIT_LOG" 2>/dev/null || true; }
check_root() { [[ $EUID -eq 0 ]] || { echo -e "${RED}✗ Root required${NC}"; exit 1; }; }
init_dirs() { mkdir -p "$CONFIG_DIR" "$STATE_DIR" "$(dirname "$AUDIT_LOG")" 2>/dev/null; }

nft_base() {
    nft -f - << 'NFT'
table inet sanchala_fw {
    set blocked { type ipv4_addr; flags interval; }
    set tcp_allow { type inet_service; elements = { 22 }; }
    chain input {
        type filter hook input priority 0; policy drop;
        ct state established,related accept
        iif lo accept
        ip saddr @blocked drop
        tcp dport @tcp_allow accept
        log prefix "[SANCHALA-FW] " limit rate 5/minute
    }
    chain forward { type filter hook forward priority 0; policy drop; }
    chain output { type filter hook output priority 0; policy accept; }
}
NFT
}

case "${1:-status}" in
    enable) check_root; init_dirs; nft delete table inet sanchala_fw 2>/dev/null||true; nft_base
        echo enabled>"${STATE_DIR}/status"; log_audit ENABLE "Firewall enabled"
        echo -e "${GREEN}✓ Firewall enabled${NC}" ;;
    disable) check_root; nft delete table inet sanchala_fw 2>/dev/null||true
        echo disabled>"${STATE_DIR}/status"; echo -e "${YELLOW}⚠ Firewall disabled${NC}" ;;
    status) echo -e "${BOLD}Sanchala Firewall${NC}"; [[ -f "${STATE_DIR}/status" ]] && cat "${STATE_DIR}/status" || echo disabled ;;
    panic) check_root; nft flush ruleset; nft add table inet panic
        nft 'add chain inet panic i { type filter hook input priority 0; policy drop; }'
        nft 'add chain inet panic o { type filter hook output priority 0; policy drop; }'
        echo -e "${RED}✗ PANIC - All traffic blocked${NC}" ;;
    allow) check_root; nft add element inet sanchala_fw tcp_allow "{ $2 }"; log_audit ALLOW "$2" ;;
    block) check_root; nft add element inet sanchala_fw blocked "{ $2 }"; log_audit BLOCK "$2" ;;
    rules) nft list table inet sanchala_fw 2>/dev/null || echo "No rules" ;;
    *) echo "Usage: sanchala-firewall {enable|disable|status|panic|allow PORT|block IP|rules}" ;;
esac
