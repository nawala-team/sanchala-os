#!/bin/bash
# ============================================================================
# SANCHALA OS - Readahead Replay Script
# ============================================================================
# Version: 1.0 | Prefetch boot-critical files from collected pack
# Usage: readahead-replay <packfile>
# ============================================================================

set -euo pipefail

PACKFILE="${1:-/var/lib/sanchala/readahead.pack}"
PARALLEL_READS=4

if [[ ! -f "$PACKFILE" ]]; then
    echo "Readahead pack not found: $PACKFILE"
    exit 0  # Not an error, just skip prefetching
fi

# Read file list and prefetch in parallel
# Uses dd with direct I/O to populate page cache
prefetch_file() {
    local file="$1"
    if [[ -r "$file" ]]; then
        # Read file into page cache (drop after reading is handled by kernel)
        dd if="$file" of=/dev/null bs=1M 2>/dev/null || true
    fi
}

export -f prefetch_file

# Prefetch files in parallel, with ionice to avoid impacting boot
ionice -c 3 xargs -P "$PARALLEL_READS" -I {} bash -c 'prefetch_file "$@"' _ {} < "$PACKFILE"

echo "Readahead prefetch complete"
