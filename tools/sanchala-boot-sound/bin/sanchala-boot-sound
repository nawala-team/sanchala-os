#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0
# Sanchala Boot Sound - macOS-style startup chime
"""Configure the system startup sound"""

import sys, json, argparse, subprocess, shutil
from pathlib import Path

VERSION = "1.0.0"
CONFIG_DIR = Path.home() / ".config" / "sanchala" / "boot-sound"
SOUND_FILE = Path("/usr/share/sanchala/sounds/boot.oga")
SERVICE_FILE = Path.home() / ".config/systemd/user/sanchala-boot-sound.service"

class BootSoundConfig:
    def __init__(self):
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        self.file = CONFIG_DIR / "config.json"
        self.data = self._load()
    
    def _load(self):
        defaults = {"enabled": True, "sound": "default", "volume": 70, "delay": 2}
        if self.file.exists():
            try: defaults.update(json.load(open(self.file)))
            except: pass
        return defaults
    
    def save(self):
        with open(self.file, 'w') as f: json.dump(self.data, f, indent=2)

SOUNDS = {
    "default": "/usr/share/sanchala/sounds/boot.oga",
    "chime": "/usr/share/sanchala/sounds/chime.oga",
    "subtle": "/usr/share/sanchala/sounds/subtle.oga",
    "classic": "/usr/share/sanchala/sounds/classic.oga",
}

def create_service():
    SERVICE_FILE.parent.mkdir(parents=True, exist_ok=True)
    config = BootSoundConfig()
    sound = SOUNDS.get(config.data["sound"], SOUNDS["default"])
    
    service = f"""[Unit]
Description=Sanchala Boot Sound
After=sound.target pulseaudio.service

[Service]
Type=oneshot
ExecStartPre=/bin/sleep {config.data['delay']}
ExecStart=/usr/bin/paplay --volume={int(config.data['volume'] * 655.35)} {sound}
RemainAfterExit=yes

[Install]
WantedBy=default.target
"""
    SERVICE_FILE.write_text(service)
    subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)

def cmd_enable(args):
    config = BootSoundConfig()
    config.data["enabled"] = True
    config.save()
    create_service()
    subprocess.run(["systemctl", "--user", "enable", "sanchala-boot-sound.service"], capture_output=True)
    print("✅ Boot sound enabled")
    return 0

def cmd_disable(args):
    config = BootSoundConfig()
    config.data["enabled"] = False
    config.save()
    subprocess.run(["systemctl", "--user", "disable", "sanchala-boot-sound.service"], capture_output=True)
    print("✅ Boot sound disabled")
    return 0

def cmd_set(args):
    config = BootSoundConfig()
    if args.sound not in SOUNDS:
        print(f"❌ Unknown sound. Available: {', '.join(SOUNDS.keys())}")
        return 1
    config.data["sound"] = args.sound
    config.save()
    create_service()
    print(f"✅ Boot sound: {args.sound}")
    return 0

def cmd_volume(args):
    config = BootSoundConfig()
    config.data["volume"] = max(0, min(100, args.level))
    config.save()
    create_service()
    print(f"✅ Volume: {config.data['volume']}%")
    return 0

def cmd_test(args):
    config = BootSoundConfig()
    sound = SOUNDS.get(config.data["sound"], SOUNDS["default"])
    print(f"🔊 Playing boot sound...")
    subprocess.run(["paplay", f"--volume={int(config.data['volume'] * 655.35)}", sound])
    return 0

def cmd_list(args):
    config = BootSoundConfig()
    print(f"\n🔔 Available Boot Sounds\n" + "━"*30)
    for name in SOUNDS:
        marker = "●" if name == config.data["sound"] else "○"
        print(f"  {marker} {name}")
    print()
    return 0

def cmd_status(args):
    config = BootSoundConfig()
    print(f"\n🔔 Boot Sound Settings\n" + "━"*30)
    print(f"  Enabled: {'Yes' if config.data['enabled'] else 'No'}")
    print(f"  Sound:   {config.data['sound']}")
    print(f"  Volume:  {config.data['volume']}%")
    print(f"  Delay:   {config.data['delay']}s")
    print()
    return 0

def main():
    p = argparse.ArgumentParser(prog="sanchala-boot-sound", description="🔔 Boot Sound")
    p.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    sub = p.add_subparsers(dest="cmd")
    
    sub.add_parser("enable", help="Enable boot sound")
    sub.add_parser("disable", help="Disable boot sound")
    s = sub.add_parser("set", help="Set sound"); s.add_argument("sound")
    s = sub.add_parser("volume", help="Set volume"); s.add_argument("level", type=int)
    sub.add_parser("test", help="Test sound")
    sub.add_parser("list", help="List sounds")
    sub.add_parser("status", help="Show status")
    
    args = p.parse_args()
    cmds = {"enable": cmd_enable, "disable": cmd_disable, "set": cmd_set,
            "volume": cmd_volume, "test": cmd_test, "list": cmd_list, "status": cmd_status}
    if args.cmd in cmds: return cmds[args.cmd](args)
    return cmd_status(args)

if __name__ == "__main__": sys.exit(main())
