#!/usr/bin/env python3
"""Sanchala Archive Manager GUI"""
import sys, os, subprocess, tarfile, zipfile
from PyQt6.QtWidgets import *
from PyQt6.QtCore import *
from PyQt6.QtGui import *

class ArchiveManager(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Sanchala Archive Manager")
        self.setMinimumSize(600, 400)
        self.current_archive = None
        self.init_ui()
    
    def init_ui(self):
        w = QWidget()
        self.setCentralWidget(w)
        layout = QVBoxLayout(w)
        
        # Toolbar
        tb = QHBoxLayout()
        for name, icon, cb in [("Open", "document-open", self.open_archive),
                                ("Extract", "archive-extract", self.extract_all),
                                ("Create", "archive-insert", self.create_archive)]:
            btn = QPushButton(name)
            btn.setIcon(QIcon.fromTheme(icon))
            btn.clicked.connect(cb)
            tb.addWidget(btn)
        tb.addStretch()
        layout.addLayout(tb)
        
        # File list
        self.file_list = QTreeWidget()
        self.file_list.setHeaderLabels(["Name", "Size", "Modified"])
        self.file_list.setAlternatingRowColors(True)
        layout.addWidget(self.file_list)
        
        # Status
        self.status = QLabel("No archive loaded")
        layout.addWidget(self.status)
    
    def open_archive(self):
        path, _ = QFileDialog.getOpenFileName(self, "Open Archive", "",
            "Archives (*.tar.gz *.tgz *.tar.bz2 *.tar.xz *.tar *.zip *.7z *.rar);;All (*)")
        if path:
            self.load_archive(path)
    
    def load_archive(self, path):
        self.current_archive = path
        self.file_list.clear()
        try:
            if path.endswith((".tar", ".tar.gz", ".tgz", ".tar.bz2", ".tar.xz")):
                with tarfile.open(path) as tf:
                    for m in tf.getmembers():
                        item = QTreeWidgetItem([m.name, str(m.size), ""])
                        self.file_list.addTopLevelItem(item)
            elif path.endswith(".zip"):
                with zipfile.ZipFile(path) as zf:
                    for info in zf.infolist():
                        item = QTreeWidgetItem([info.filename, str(info.file_size), ""])
                        self.file_list.addTopLevelItem(item)
            self.status.setText(f"Loaded: {os.path.basename(path)}")
        except Exception as e:
            QMessageBox.warning(self, "Error", str(e))
    
    def extract_all(self):
        if not self.current_archive:
            QMessageBox.warning(self, "Error", "No archive loaded")
            return
        dest = QFileDialog.getExistingDirectory(self, "Extract to")
        if dest:
            subprocess.run(["sanchala-archive-manager", "extract", self.current_archive, dest])
            QMessageBox.information(self, "Done", f"Extracted to {dest}")
    
    def create_archive(self):
        files, _ = QFileDialog.getOpenFileNames(self, "Select files")
        if files:
            out, _ = QFileDialog.getSaveFileName(self, "Save archive", "", "Tar.gz (*.tar.gz);;Zip (*.zip)")
            if out:
                fmt = "tar.gz" if out.endswith(".tar.gz") else "zip"
                subprocess.run(["sanchala-archive-manager", "compress", fmt, out] + files)
                QMessageBox.information(self, "Done", f"Created: {out}")

if __name__ == "__main__":
    app = QApplication(sys.argv)
    w = ArchiveManager()
    if len(sys.argv) > 1:
        w.load_archive(sys.argv[1])
    w.show()
    sys.exit(app.exec())
