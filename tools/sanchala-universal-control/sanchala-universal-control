#!/usr/bin/env python3
"""Sanchala Universal Control - Control multiple devices with one keyboard/mouse"""
import json,secrets,socket
from datetime import datetime
from pathlib import Path

class UniversalControl:
    def __init__(self):
        self.base=Path(__file__).parent
        self.devices_dir=self.base/"devices";self.devices_dir.mkdir(parents=True,exist_ok=True)
        self.layouts_dir=self.base/"layouts";self.layouts_dir.mkdir(exist_ok=True)
        self.data=self.base/"lib/control.json";self.base.joinpath("lib").mkdir(exist_ok=True)
        self.state=json.load(open(self.data))if self.data.exists()else{"devices":{},"layout":[],"active":False}
    def _save(self):json.dump(self.state,open(self.data,'w'),indent=2)
    def add_device(self,device):
        did=device.get("id")or secrets.token_hex(8)
        self.state["devices"][did]={"id":did,"name":device.get("name",socket.gethostname()),
            "type":device.get("type","desktop"),"resolution":device.get("res","1920x1080"),
            "position":device.get("pos",{"x":0,"y":0}),"added":datetime.now().isoformat(),"connected":True}
        self._save();return{"success":True,"device_id":did}
    def remove_device(self,did):
        if did in self.state["devices"]:del self.state["devices"][did];self._save()
        return{"success":True}
    def set_layout(self,layout):
        """Layout is list of {device_id, position: left/right/above/below, relative_to}"""
        self.state["layout"]=layout;self._save()
        return{"success":True,"devices":len(layout)}
    def auto_arrange(self):
        devices=list(self.state["devices"].values())
        x=0
        for d in devices:
            d["position"]={"x":x,"y":0};x+=int(d["resolution"].split("x")[0])
        self._save();return{"success":True,"arranged":len(devices)}
    def enable(self):
        self.state["active"]=True;self.state["started"]=datetime.now().isoformat()
        self._save();return{"success":True,"devices":len(self.state["devices"])}
    def disable(self):self.state["active"]=False;self._save();return{"success":True}
    def get_status(self):
        return{"active":self.state["active"],"devices":len(self.state["devices"]),
            "device_list":[{"id":d["id"],"name":d["name"],"connected":d["connected"]}for d in self.state["devices"].values()]}
    def cursor_move(self,did,x,y):
        """Handle cursor moving between device boundaries"""
        if did not in self.state["devices"]:return{"device":did}
        d=self.state["devices"][did];res=d["resolution"].split("x")
        w,h=int(res[0]),int(res[1])
        if x>=w:  # Moving right
            for od in self.state["devices"].values():
                if od["id"]!=did and od["position"]["x"]>d["position"]["x"]:
                    return{"switch_to":od["id"],"x":0,"y":y}
        return{"device":did,"x":x,"y":y}

if __name__=="__main__":
    import argparse;p=argparse.ArgumentParser();s=p.add_subparsers(dest="c")
    ad=s.add_parser("add");ad.add_argument("--name",required=True);ad.add_argument("--type",default="desktop")
    rm=s.add_parser("remove");rm.add_argument("--device-id",required=True)
    s.add_parser("arrange");s.add_parser("enable");s.add_parser("disable");s.add_parser("status")
    a=p.parse_args();uc=UniversalControl()
    if a.c=="add":print(json.dumps(uc.add_device({"name":a.name,"type":a.type}),indent=2))
    elif a.c=="remove":print(json.dumps(uc.remove_device(a.device_id),indent=2))
    elif a.c=="arrange":print(json.dumps(uc.auto_arrange(),indent=2))
    elif a.c=="enable":print(json.dumps(uc.enable(),indent=2))
    elif a.c=="disable":print(json.dumps(uc.disable(),indent=2))
    elif a.c=="status":print(json.dumps(uc.get_status(),indent=2))
    else:p.print_help()
