#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0
# Sanchala Screenshot - Advanced Screenshot Tool for Sanchala OS

set -euo pipefail

VERSION="1.0.0"
PROGRAM_NAME="sanchala-screenshot"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/sanchala"
CONFIG_FILE="$CONFIG_DIR/screenshot.conf"
SCREENSHOTS_DIR="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"

RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[1;33m'
BLUE='\033[0;34m' NC='\033[0m'

declare -A CFG=([format]="png" [quality]="95" [delay]="0" [cursor]="false"
    [decorations]="true" [clipboard]="true" [save]="true" [sound]="true" [notify]="true")

print_info() { echo -e "${BLUE}ℹ${NC} $1"; }
print_success() { echo -e "${GREEN}✓${NC} $1"; }
print_error() { echo -e "${RED}✗${NC} $1" >&2; }

show_help() {
    cat << 'EOF'
SANCHALA SCREENSHOT - Advanced Screenshot Tool

USAGE: sanchala-screenshot [MODE] [OPTIONS]

MODES:
    fullscreen, -f    Capture entire screen (default)
    active, -a        Capture active window
    window, -w        Select window to capture
    region, -r        Select rectangular region
    monitor, -m [N]   Capture specific monitor

OPTIONS:
    -d, --delay <S>   Delay before capture (0-60)
    -c, --cursor      Include mouse cursor
    -o, --output <F>  Output filename
    -F, --format      Format: png, jpg, webp
    -q, --quality     JPEG/WebP quality (1-100)
    -C, --clipboard   Copy to clipboard only
    -e, --edit        Open in editor after
    --gui             Launch GUI
    -h, --help        Show this help
EOF
}

init_config() {
    mkdir -p "$CONFIG_DIR" "$SCREENSHOTS_DIR"
    [[ -f "$CONFIG_FILE" ]] || cat > "$CONFIG_FILE" << 'CONF'
[General]
format=png
quality=95
delay=0
cursor=false
save=true
clipboard=true
sound=true
notify=true
CONF
}

load_config() {
    init_config
    while IFS='=' read -r k v; do
        [[ -z "$k" || "$k" =~ ^[#\[] ]] && continue
        CFG[${k// /}]="${v## }"
    done < "$CONFIG_FILE" 2>/dev/null || true
}

detect_display() {
    [[ -n "${WAYLAND_DISPLAY:-}" ]] && echo "wayland" || echo "x11"
}

gen_filename() {
    echo "$SCREENSHOTS_DIR/Screenshot_$(date +%Y-%m-%d_%H-%M-%S).${1:-png}"
}

play_sound() {
    [[ "${CFG[sound]}" == "true" ]] || return
    paplay /usr/share/sounds/freedesktop/stereo/camera-shutter.oga 2>/dev/null &
}

notify() {
    [[ "${CFG[notify]}" == "true" ]] || return
    notify-send "$1" "$2" --icon="${3:-camera-photo}" --app-name="Screenshot" 2>/dev/null
}

copy_clip() {
    [[ "$(detect_display)" == "wayland" ]] && wl-copy < "$1" 2>/dev/null || \
        xclip -selection clipboard -t image/png < "$1" 2>/dev/null
}

capture_wayland() {
    local mode="$1" out="$2" cur=""
    [[ "${CFG[cursor]}" == "true" ]] && cur="-c"
    case "$mode" in
        fullscreen) grim $cur "$out" ;;
        region) grim $cur -g "$(slurp)" "$out" ;;
        active|window) grim $cur -g "$(slurp)" "$out" ;;
        monitor) grim $cur -o "${3:-}" "$out" ;;
    esac
}

capture_x11() {
    local mode="$1" out="$2"
    case "$mode" in
        fullscreen) scrot "$out" 2>/dev/null || import -window root "$out" ;;
        region) scrot -s "$out" 2>/dev/null || import "$out" ;;
        active) scrot -u "$out" ;;
        window) scrot -s "$out" ;;
    esac
}

do_capture() {
    local mode="$1" out="$2"
    [[ "${CFG[delay]}" -gt 0 ]] && { print_info "Capturing in ${CFG[delay]}s..."; sleep "${CFG[delay]}"; }
    mkdir -p "$(dirname "$out")"
    [[ "$(detect_display)" == "wayland" ]] && capture_wayland "$mode" "$out" "${3:-}" || capture_x11 "$mode" "$out"
}

launch_gui() {
    exec "$(dirname "$(readlink -f "$0")")/sanchala-screenshot-gui" "$@"
}

main() {
    load_config
    local mode="fullscreen" out="" clip_only=false do_edit=false mon=""
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            fullscreen|-f) mode="fullscreen"; shift ;;
            active|-a) mode="active"; shift ;;
            window|-w) mode="window"; shift ;;
            region|-r) mode="region"; shift ;;
            monitor|-m) mode="monitor"; mon="${2:-}"; shift; [[ -n "$mon" ]] && shift ;;
            --gui) launch_gui ;;
            -d|--delay) CFG[delay]="$2"; shift 2 ;;
            -c|--cursor) CFG[cursor]="true"; shift ;;
            -o|--output) out="$2"; shift 2 ;;
            -F|--format) CFG[format]="$2"; shift 2 ;;
            -q|--quality) CFG[quality]="$2"; shift 2 ;;
            -C|--clipboard) clip_only=true; shift ;;
            -e|--edit) do_edit=true; shift ;;
            -h|--help) show_help; exit 0 ;;
            -V|--version) echo "$PROGRAM_NAME $VERSION"; exit 0 ;;
            *) print_error "Unknown: $1"; exit 1 ;;
        esac
    done
    
    [[ -z "$out" ]] && out=$(gen_filename "${CFG[format]}")
    
    if do_capture "$mode" "$out" "$mon"; then
        play_sound
        [[ "${CFG[clipboard]}" == "true" ]] && copy_clip "$out"
        if $clip_only; then
            notify "Screenshot Copied" "Copied to clipboard"
            rm -f "$out"
        else
            notify "Screenshot Saved" "$(basename "$out")"
            print_success "Saved: $out"
        fi
        $do_edit && xdg-open "$out" 2>/dev/null &
    else
        print_error "Capture failed"; exit 1
    fi
}

main "$@"
