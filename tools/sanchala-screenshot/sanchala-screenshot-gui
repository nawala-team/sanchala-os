# Sanchala Screenshot GUI

import sys, os, subprocess
from datetime import datetime
from pathlib import Path
from PyQt6.QtWidgets import *
from PyQt6.QtCore import Qt, QTimer
from PyQt6.QtGui import QIcon, QShortcut, QKeySequence

class ScreenshotWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Sanchala Screenshot")
        self.setWindowIcon(QIcon.fromTheme("camera-photo"))
        self.setMinimumSize(450, 380)
        self.setup_ui()
        
    def setup_ui(self):
        central = QWidget()
        self.setCentralWidget(central)
        layout = QVBoxLayout(central)
        
        mode_group = QGroupBox("Capture Mode")
        mode_layout = QVBoxLayout(mode_group)
        self.mode_group = QButtonGroup()
        for i, (label, val) in enumerate([("Fullscreen", "fullscreen"), 
            ("Active Window", "active"), ("Select Region", "region")]):
            rb = QRadioButton(label)
            rb.setProperty("mode", val)
            self.mode_group.addButton(rb, i)
            mode_layout.addWidget(rb)
            if i == 0: rb.setChecked(True)
        layout.addWidget(mode_group)
        
        opts = QGroupBox("Options")
        ol = QVBoxLayout(opts)
        dr = QHBoxLayout()
        dr.addWidget(QLabel("Delay:"))
        self.delay = QSpinBox(); self.delay.setRange(0, 60)
        dr.addWidget(self.delay); dr.addStretch()
        ol.addLayout(dr)
        self.cursor = QCheckBox("Include cursor")
        self.clip = QCheckBox("Copy to clipboard"); self.clip.setChecked(True)
        ol.addWidget(self.cursor); ol.addWidget(self.clip)
        layout.addWidget(opts)
        
        btns = QHBoxLayout()
        cap = QPushButton("Capture"); cap.clicked.connect(self.capture)
        btns.addStretch(); btns.addWidget(cap)
        layout.addLayout(btns)
        QShortcut(QKeySequence("Escape"), self, self.close)
    
    def capture(self):
        self.hide(); QTimer.singleShot(200, self._capture)
    
    def _capture(self):
        mode = self.mode_group.checkedButton().property("mode")
        cmd = ["sanchala-screenshot", mode]
        if self.delay.value() > 0: cmd += ["-d", str(self.delay.value())]
        if self.cursor.isChecked(): cmd.append("-c")
        subprocess.run(cmd); self.close()

if __name__ == "__main__":
    app = QApplication(sys.argv)
    win = ScreenshotWindow(); win.show()
    sys.exit(app.exec())
