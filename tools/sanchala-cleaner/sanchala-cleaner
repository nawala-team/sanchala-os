#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0
# Sanchala Cleaner - macOS Optimize Storage-level System Maintenance

set -euo pipefail

VERSION="1.0.0"
PROGRAM_NAME="sanchala-cleaner"
CONFIG_DIR="/etc/sanchala-cleaner"
CONFIG_FILE="${CONFIG_DIR}/cleaner.conf"
STATE_DIR="/var/lib/sanchala/cleaner"
LOG_FILE="/var/log/sanchala/cleaner.log"

# Colors
RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[1;33m'
BLUE='\033[0;34m' CYAN='\033[0;36m' NC='\033[0m' BOLD='\033[1m'

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
for lib in cache packages logs system; do
    [[ -f "${SCRIPT_DIR}/lib/${lib}.sh" ]] && source "${SCRIPT_DIR}/lib/${lib}.sh"
done

# Load configuration defaults
load_config() {
    AUTO_CLEAN_ENABLED=true
    CLEAN_PACKAGE_CACHE=true
    PACKAGE_CACHE_KEEP=2
    CLEAN_ORPHANS=true
    CLEAN_JOURNAL=true
    JOURNAL_MAX_SIZE="500M"
    JOURNAL_MAX_AGE="30days"
    CLEAN_THUMBNAILS=true
    THUMBNAIL_MAX_AGE=30
    CLEAN_TRASH=true
    TRASH_MAX_AGE=30
    CLEAN_DOWNLOADS=false
    DOWNLOADS_MAX_AGE=90
    CLEAN_BROWSER_CACHE=true
    BROWSER_CACHE_MAX_AGE=7
    STORAGE_THRESHOLD=90
    DRY_RUN=false
    INTERACTIVE=true
    [[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE"
}

print_info() { echo -e "${BLUE}ℹ${NC} $1"; }
print_success() { echo -e "${GREEN}✓${NC} $1"; }
print_warning() { echo -e "${YELLOW}⚠${NC} $1"; }
print_error() { echo -e "${RED}✗${NC} $1" >&2; }
print_header() { echo -e "\n${BOLD}${CYAN}━━━ $1 ━━━${NC}\n"; }

log_action() {
    local ts=$(date '+%Y-%m-%d %H:%M:%S')
    echo "[$ts] $1" >> "$LOG_FILE" 2>/dev/null || true
}

format_size() {
    local size=$1
    if (( size >= 1073741824 )); then
        echo "$(( size / 1073741824 )).$(( (size % 1073741824) * 10 / 1073741824 )) GB"
    elif (( size >= 1048576 )); then
        echo "$(( size / 1048576 )) MB"
    elif (( size >= 1024 )); then
        echo "$(( size / 1024 )) KB"
    else
        echo "$size B"
    fi
}

get_disk_usage() { df / | awk 'NR==2 {gsub(/%/,""); print $5}'; }

show_version() { echo "$PROGRAM_NAME $VERSION - Sanchala OS"; }

check_root() {
    [[ $EUID -eq 0 ]] || { print_error "Root required. Use: sudo $PROGRAM_NAME $*"; exit 1; }
}

ensure_dirs() { mkdir -p "$STATE_DIR" "$(dirname "$LOG_FILE")" 2>/dev/null || true; }

show_help() {
    cat << 'EOF'
SANCHALA CLEANER - Intelligent System Maintenance

USAGE: sanchala-cleaner <COMMAND> [OPTIONS]

CLEANUP COMMANDS:
    clean                   Run smart cleanup (respects config)
    clean --all             Deep clean everything
    clean --quick           Quick cleanup (caches only)
    packages                Clean package cache (paccache)
    orphans                 Remove orphan packages
    journal                 Clean systemd journal logs
    thumbnails              Clean thumbnail cache
    trash                   Empty user trash
    browser                 Clean browser caches
    temp                    Clean temporary files

ANALYSIS COMMANDS:
    analyze                 Analyze disk usage
    duplicates [PATH]       Find duplicate files
    recommendations         Show cleanup recommendations

STORAGE OPTIMIZATION:
    optimize                Optimize storage (macOS-style)

SCHEDULE:
    schedule                Show cleanup schedule
    schedule enable         Enable automatic cleanup
    schedule disable        Disable automatic cleanup

OPTIONS:
    -n, --dry-run           Preview without deleting
    -y, --yes               Skip confirmation prompts
    -v, --verbose           Detailed output
    --json                  JSON output format
    -h, --help              Show this help

EXAMPLES:
    sanchala-cleaner clean              # Smart cleanup
    sanchala-cleaner analyze            # See what's using space
    sanchala-cleaner packages -n        # Preview package cache cleanup
EOF
}

cmd_clean() {
    local mode="smart" dry_run=$DRY_RUN confirm=$INTERACTIVE total_freed=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all) mode="all"; shift ;;
            --quick) mode="quick"; shift ;;
            -n|--dry-run) dry_run=true; shift ;;
            -y|--yes) confirm=false; shift ;;
            *) shift ;;
        esac
    done
    
    print_header "Sanchala Cleaner - ${mode^} Mode"
    print_info "Current disk usage: $(get_disk_usage)%"
    
    $dry_run && print_warning "DRY RUN - No files will be deleted"
    
    if $confirm && ! $dry_run; then
        read -p "Proceed with cleanup? [Y/n] " -n 1 -r
        echo
        [[ $REPLY =~ ^[Nn]$ ]] && { print_info "Cancelled."; exit 0; }
    fi
    
    # Package cache
    if $CLEAN_PACKAGE_CACHE; then
        print_info "Cleaning package cache..."
        total_freed=$((total_freed + $(clean_package_cache "$dry_run" "$PACKAGE_CACHE_KEEP")))
    fi
    
    # Journal logs
    if $CLEAN_JOURNAL; then
        print_info "Cleaning journal logs..."
        total_freed=$((total_freed + $(clean_journal "$dry_run" "$JOURNAL_MAX_SIZE")))
    fi
    
    # Thumbnails
    if $CLEAN_THUMBNAILS; then
        print_info "Cleaning thumbnail cache..."
        total_freed=$((total_freed + $(clean_thumbnails "$dry_run" "$THUMBNAIL_MAX_AGE")))
    fi
    
    # Trash
    if $CLEAN_TRASH && [[ "$mode" != "quick" ]]; then
        print_info "Emptying trash..."
        total_freed=$((total_freed + $(clean_trash "$dry_run" "$TRASH_MAX_AGE")))
    fi
    
    # Browser cache
    if $CLEAN_BROWSER_CACHE; then
        print_info "Cleaning browser caches..."
        total_freed=$((total_freed + $(clean_browser_cache "$dry_run")))
    fi
    
    # Temp files
    print_info "Cleaning temporary files..."
    total_freed=$((total_freed + $(clean_temp "$dry_run")))
    
    # Orphans (all mode only)
    if $CLEAN_ORPHANS && [[ "$mode" == "all" ]]; then
        print_info "Removing orphan packages..."
        clean_orphans "$dry_run"
    fi
    
    print_header "Cleanup Complete"
    print_success "Total space freed: $(format_size $total_freed)"
    print_info "New disk usage: $(get_disk_usage)%"
    
    touch "$STATE_DIR/last_clean" 2>/dev/null || true
    log_action "CLEANUP: mode=$mode freed=$(format_size $total_freed)"
}

cmd_analyze() {
    print_header "Disk Usage Analysis"
    
    echo -e "${BOLD}Filesystem Usage:${NC}"
    df -h / /home 2>/dev/null | awk 'NR==1 || /\/$|\/home$/'
    echo
    
    echo -e "${BOLD}Largest Directories:${NC}"
    du -sh /var/cache/* /var/log/* 2>/dev/null | sort -rh | head -10
    echo
    
    echo -e "${BOLD}Package Cache:${NC}"
    if [[ -d /var/cache/pacman/pkg ]]; then
        local pkg_size=$(du -sh /var/cache/pacman/pkg 2>/dev/null | cut -f1)
        local pkg_count=$(ls /var/cache/pacman/pkg/*.pkg.tar.* 2>/dev/null | wc -l || echo 0)
        echo "  Size: $pkg_size ($pkg_count packages)"
    fi
    
    echo -e "${BOLD}Journal Logs:${NC}"
    journalctl --disk-usage 2>/dev/null || echo "  Not available"
    echo
    
    echo -e "${BOLD}User Caches:${NC}"
    for home in /home/*; do
        [[ -d "$home/.cache" ]] || continue
        echo "  $(basename "$home"): $(du -sh "$home/.cache" 2>/dev/null | cut -f1)"
    done
}

cmd_status() {
    local json=false
    [[ "${1:-}" == "--json" ]] && json=true
    
    local disk_usage=$(get_disk_usage)
    local last_clean="Never"
    [[ -f "$STATE_DIR/last_clean" ]] && last_clean=$(date -r "$STATE_DIR/last_clean" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "Unknown")
    
    if $json; then
        echo "{\"disk_usage\":$disk_usage,\"last_cleanup\":\"$last_clean\",\"auto_clean\":$AUTO_CLEAN_ENABLED}"
    else
        print_header "Sanchala Cleaner Status"
        echo "Disk Usage:    ${disk_usage}%"
        echo "Last Cleanup:  ${last_clean}"
        echo "Auto-Clean:    $($AUTO_CLEAN_ENABLED && echo "Enabled" || echo "Disabled")"
    fi
}

cmd_schedule() {
    local action="${1:-show}"
    case "$action" in
        show)
            print_header "Cleanup Schedule"
            if systemctl is-enabled sanchala-cleaner.timer &>/dev/null; then
                print_success "Automatic cleanup is enabled"
                systemctl status sanchala-cleaner.timer --no-pager 2>/dev/null | head -5
            else
                print_warning "Automatic cleanup is disabled"
            fi
            ;;
        enable) check_root; systemctl enable --now sanchala-cleaner.timer; print_success "Enabled" ;;
        disable) check_root; systemctl disable --now sanchala-cleaner.timer; print_success "Disabled" ;;
    esac
}

cmd_optimize() {
    print_header "Storage Optimization (macOS-style)"
    local total=0
    
    print_info "Phase 1: System caches..."
    total=$((total + $(clean_package_cache false 2)))
    total=$((total + $(clean_journal false "500M")))
    
    print_info "Phase 2: User caches..."
    total=$((total + $(clean_thumbnails false 30)))
    total=$((total + $(clean_browser_cache false)))
    total=$((total + $(clean_trash false 0)))
    
    print_info "Phase 3: Temporary files..."
    total=$((total + $(clean_temp false)))
    
    print_header "Optimization Complete"
    print_success "Total freed: $(format_size $total)"
    log_action "OPTIMIZE: freed=$(format_size $total)"
}

cmd_duplicates() {
    local path="${1:-$HOME}"
    print_header "Finding Duplicates in $path"
    
    if command -v fdupes &>/dev/null; then
        fdupes -r -S "$path" 2>/dev/null | head -50
    else
        print_warning "Install 'fdupes' for duplicate detection"
        echo "Potential duplicates by size:"
        find "$path" -type f -size +1M 2>/dev/null | xargs -I{} ls -l {} 2>/dev/null | \
            awk '{s[$5]++; f[$5]=f[$5]"\n  "$9} END{for(k in s)if(s[k]>1)print k" bytes:"f[k]}' | head -30
    fi
}

main() {
    load_config
    ensure_dirs
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n|--dry-run) DRY_RUN=true; shift ;;
            -y|--yes) INTERACTIVE=false; shift ;;
            -h|--help) show_help; exit 0 ;;
            --version) show_version; exit 0 ;;
            -*) shift ;;
            *) break ;;
        esac
    done
    
    local cmd="${1:-status}"; shift || true
    case "$cmd" in
        clean) check_root; cmd_clean "$@" ;;
        packages) check_root; clean_package_cache "$DRY_RUN" "$PACKAGE_CACHE_KEEP"; print_success "Done" ;;
        orphans) check_root; clean_orphans "$DRY_RUN" ;;
        journal) check_root; clean_journal "$DRY_RUN" "$JOURNAL_MAX_SIZE"; print_success "Done" ;;
        thumbnails) clean_thumbnails "$DRY_RUN" "$THUMBNAIL_MAX_AGE"; print_success "Done" ;;
        trash) clean_trash "$DRY_RUN" "$TRASH_MAX_AGE"; print_success "Done" ;;
        browser) clean_browser_cache "$DRY_RUN"; print_success "Done" ;;
        temp) check_root; clean_temp "$DRY_RUN"; print_success "Done" ;;
        analyze|scan) cmd_analyze ;;
        duplicates) cmd_duplicates "$@" ;;
        optimize) check_root; cmd_optimize ;;
        schedule) cmd_schedule "$@" ;;
        status) cmd_status "$@" ;;
        help) show_help ;;
        *) print_error "Unknown: $cmd"; exit 1 ;;
    esac
}

main "$@"
