# Sanchala Cleaner - Temporary Files Rules
# System temporary directories to clean

# Standard temp directories
/tmp
/var/tmp

# Session temp (clean on logout)
/run/user/*/

# Application temp files
/var/cache/fontconfig
/var/cache/man

# Log temp files
/var/log/*.old
/var/log/*.gz
/var/log/*.[0-9]
