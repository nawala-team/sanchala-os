[Desktop Entry]
Name=System Diagnostics
GenericName=System Monitor
Comment=View system performance, hardware info, and run diagnostics
Exec=sanchala-diagnostics top
Icon=utilities-system-monitor
Terminal=true
Type=Application
Categories=System;Monitor;
Keywords=monitor;system;cpu;memory;disk;network;process;diagnostics;
StartupNotify=false
X-GNOME-UsesNotifications=false
