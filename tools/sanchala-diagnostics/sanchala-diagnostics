#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0
# Sanchala Diagnostics - macOS-style Activity Monitor + System Information
# Comprehensive system diagnostics for Sanchala OS

set -euo pipefail

VERSION="1.0.0"
PROGRAM_NAME="sanchala-diagnostics"
CONFIG_DIR="/etc/sanchala/diagnostics"
DATA_DIR="/var/lib/sanchala/diagnostics"
LOG_FILE="/var/log/sanchala/diagnostics.log"

# Colors
RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[1;33m'
BLUE='\033[0;34m' CYAN='\033[0;36m' MAGENTA='\033[0;35m'
NC='\033[0m' BOLD='\033[1m' DIM='\033[2m'

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
for lib in system disk network hardware process; do
    [[ -f "${SCRIPT_DIR}/lib/${lib}.sh" ]] && source "${SCRIPT_DIR}/lib/${lib}.sh"
done

# Output helpers
print_header() { echo -e "\n${BOLD}${CYAN}═══ $1 ═══${NC}"; }
print_info() { echo -e "${BLUE}ℹ ${NC}$1"; }
print_success() { echo -e "${GREEN}✓ ${NC}$1"; }
print_warning() { echo -e "${YELLOW}⚠ ${NC}$1"; }
print_error() { echo -e "${RED}✗ ${NC}$1"; }
print_metric() { printf "${DIM}%-20s${NC} %s\n" "$1:" "$2"; }

show_version() { echo "$PROGRAM_NAME $VERSION - Sanchala OS"; }

show_help() {
    cat << 'EOF'
SANCHALA DIAGNOSTICS - Activity Monitor + System Information

USAGE: sanchala-diagnostics <COMMAND> [OPTIONS]

SYSTEM OVERVIEW:
    overview              Complete system overview (default)
    summary               Quick system health summary
    report                Generate detailed system report

PROCESS MONITORING (Activity Monitor):
    top                   Real-time process monitor (btop/htop)
    processes             List all processes with resource usage
    kill <PID>            Terminate process
    priority <PID> <N>    Set process priority (nice value)

CPU & MEMORY:
    cpu                   CPU information and usage
    memory                Memory usage details
    swap                  Swap usage and configuration
    load                  System load averages

DISK & STORAGE:
    disk                  Disk usage overview
    smart [DEVICE]        SMART health status (smartctl)
    io                    Disk I/O statistics
    mounts                Mounted filesystems
    partitions            Partition layout

NETWORK:
    network               Network interface status
    connections           Active network connections
    ports                 Open ports and listeners
    ping <HOST>           Connectivity test
    traceroute <HOST>     Network path trace

HARDWARE:
    hardware              Complete hardware information
    pci                   PCI devices
    usb                   USB devices
    sensors               Temperature and fan sensors
    battery               Battery status (laptops)

LOGS & DIAGNOSTICS:
    logs [SERVICE]        System logs viewer
    health                System health check
    benchmark             Quick system benchmark

OPTIONS:
    --json                JSON output format
    --export <FILE>       Export report to file
    -h, --help            Show this help

EXAMPLES:
    sanchala-diagnostics overview
    sanchala-diagnostics smart /dev/sda
    sanchala-diagnostics ping google.com
EOF
}

# Main entry point - dispatches to library functions
main() {
    local json=false export_file=""
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) json=true; shift ;;
            --export) export_file="$2"; shift 2 ;;
            -h|--help) show_help; exit 0 ;;
            --version) show_version; exit 0 ;;
            -*) print_error "Unknown option: $1"; exit 1 ;;
            *) break ;;
        esac
    done
    
    local cmd="${1:-overview}"; shift || true
    
    case "$cmd" in
        overview)     cmd_overview "$json" ;;
        summary)      cmd_summary ;;
        report)       cmd_report "$export_file" ;;
        top)          cmd_top ;;
        processes)    cmd_processes "${1:-cpu}" "$json" ;;
        kill)         cmd_kill_process "$@" ;;
        priority)     cmd_priority "$@" ;;
        cpu)          cmd_cpu ;;
        memory|mem)   cmd_memory ;;
        swap)         cmd_swap ;;
        load)         cmd_load ;;
        disk)         cmd_disk ;;
        smart)        cmd_smart "$@" ;;
        io)           cmd_disk_io ;;
        mounts)       cmd_mounts ;;
        partitions)   cmd_partitions ;;
        network|net)  cmd_network ;;
        connections)  cmd_connections ;;
        ports)        cmd_ports ;;
        ping)         cmd_ping "$@" ;;
        traceroute)   cmd_traceroute "$@" ;;
        hardware|hw)  cmd_hardware ;;
        pci)          cmd_pci ;;
        usb)          cmd_usb ;;
        sensors)      cmd_sensors ;;
        battery)      cmd_battery ;;
        logs)         cmd_logs "$@" ;;
        health)       cmd_health_check ;;
        benchmark)    cmd_benchmark ;;
        help) show_help ;;
        *) print_error "Unknown command: $cmd"; show_help; exit 1 ;;
    esac
}

main "$@"
