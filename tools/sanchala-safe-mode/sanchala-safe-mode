#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0
# Sanchala Safe Mode - Minimal Boot Environment
set -euo pipefail
VERSION="1.0.0"
STATE_DIR="/var/lib/sanchala/safe-mode"
FLAG="/run/sanchala-safe-mode"
RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[1;33m' BLUE='\033[0;34m' NC='\033[0m' BOLD='\033[1m'
info() { echo -e "${BLUE}i${NC} $1"; }
ok() { echo -e "${GREEN}+${NC} $1"; }
warn() { echo -e "${YELLOW}!${NC} $1"; }
err() { echo -e "${RED}x${NC} $1" >&2; }
header() { echo -e "\n${BOLD}=== $1 ===${NC}\n"; }
root_check() { [[ $EUID -eq 0 ]] || { err "Root required"; exit 1; }; }
DISABLE_SVCS=(NetworkManager bluetooth cups gdm sddm lightdm docker)
show_help() { cat << 'EOF'
SANCHALA SAFE MODE
USAGE: sanchala-safe-mode <COMMAND>
COMMANDS:
  enter [--no-network] [--minimal]  Enter safe mode
  exit                Exit safe mode
  now                 Enter immediately
  status              Show status
  services            List running services
  drivers             List modules
  startup             Startup items
  disable <SVC>       Disable service
  enable <SVC>        Enable service
EOF
}
cmd_enter() {
  local no_net=false minimal=false
  while [[ $# -gt 0 ]]; do case "$1" in --no-network) no_net=true;; --minimal) minimal=true;; esac; shift; done
  header "Enter Safe Mode"; mkdir -p "$STATE_DIR"
  systemctl get-default > "$STATE_DIR/prev" 2>/dev/null
  systemctl set-default multi-user.target
  $minimal && for s in "${DISABLE_SVCS[@]}"; do systemctl disable "$s" 2>/dev/null; done
  $no_net && systemctl disable NetworkManager 2>/dev/null
  ok "Configured. Reboot to apply."
}
cmd_now() { header "Safe Mode Now"; touch "$FLAG"; for s in "${DISABLE_SVCS[@]}"; do systemctl stop "$s" 2>/dev/null; done; systemctl isolate multi-user.target; ok "In safe mode"; }
cmd_exit() { [[ -f "$STATE_DIR/prev" ]] && systemctl set-default "$(cat "$STATE_DIR/prev")" || systemctl set-default graphical.target; rm -f "$FLAG"; ok "Normal boot restored"; }
cmd_status() { header "Status"; [[ -f "$FLAG" ]] && warn "SAFE MODE" || ok "Normal"; echo "Target: $(systemctl get-default 2>/dev/null)"; echo "Services: $(systemctl list-units --type=service --state=running --no-legend | wc -l)"; }
cmd_services() { systemctl list-units --type=service --state=running --no-legend | awk '{print $1}'; }
cmd_drivers() { lsmod | head -30; }
cmd_startup() { systemctl list-unit-files --state=enabled --type=service --no-legend | head -20; }
cmd_disable() { systemctl stop "$1" 2>/dev/null; systemctl disable "$1" && ok "Disabled: $1"; }
cmd_enable() { systemctl enable "$1" && ok "Enabled: $1"; systemctl start "$1" 2>/dev/null; }
main() {
  case "${1:-status}" in
    enter) root_check; shift; cmd_enter "$@";; exit) root_check; cmd_exit;; now) root_check; cmd_now;;
    status) cmd_status;; services) cmd_services;; drivers) cmd_drivers;; startup) cmd_startup;;
    disable) root_check; cmd_disable "$2";; enable) root_check; cmd_enable "$2";;
    -h|--help|help) show_help;; --version) echo "$VERSION";; *) err "Unknown: $1";;
  esac
}
main "$@"
