#!/usr/bin/env python3
"""Sanchala Stocks - Stock Market Tracker"""
import sys, json, random
from pathlib import Path
from PyQt6.QtWidgets import *
from PyQt6.QtCore import *
from PyQt6.QtGui import *

class StocksApp(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Sanchala Stocks")
        self.setMinimumSize(800, 600)
        self.data_dir = Path.home() / ".local/share/sanchala/stocks"
        self.data_dir.mkdir(parents=True, exist_ok=True)
        self.watchlist = self.load()
        self.init_ui()
        self.timer = QTimer(); self.timer.timeout.connect(self.refresh); self.timer.start(5000)
    
    def init_ui(self):
        self.setStyleSheet("QMainWindow{background:#0d1117;}QLabel{color:#c9d1d9;}QPushButton{background:#21262d;color:#c9d1d9;border:none;padding:10px;border-radius:6px;}QPushButton:hover{background:#30363d;}")
        c = QWidget(); self.setCentralWidget(c); m = QVBoxLayout(c)
        
        # Header
        h = QHBoxLayout()
        h.addWidget(QLabel("📈 Sanchala Stocks"))
        self.search = QLineEdit(); self.search.setPlaceholderText("🔍 Search symbol...")
        self.search.setStyleSheet("background:#21262d;color:#c9d1d9;border:none;border-radius:15px;padding:8px 15px;")
        self.search.returnPressed.connect(self.add_stock)
        h.addWidget(self.search)
        m.addLayout(h)
        
        # Market indices
        idx = QHBoxLayout()
        for name, val, chg in [("S&P 500", "4,567.80", "+1.2%"), ("NASDAQ", "14,234.56", "+0.8%"), ("DOW", "35,678.90", "+0.5%")]:
            card = QFrame(); card.setStyleSheet("background:#21262d;border-radius:8px;padding:10px;")
            cl = QVBoxLayout(card)
            cl.addWidget(QLabel(name))
            v = QLabel(val); v.setStyleSheet("font-size:18px;font-weight:bold;"); cl.addWidget(v)
            c = QLabel(chg); c.setStyleSheet(f"color:{'#3fb950' if '+' in chg else '#f85149'};"); cl.addWidget(c)
            idx.addWidget(card)
        m.addLayout(idx)
        
        # Watchlist
        m.addWidget(QLabel("⭐ Watchlist"))
        self.table = QTableWidget(0, 5)
        self.table.setHorizontalHeaderLabels(["Symbol", "Price", "Change", "% Change", ""])
        self.table.horizontalHeader().setSectionResizeMode(QHeaderView.ResizeMode.Stretch)
        self.table.setStyleSheet("background:#0d1117;color:#c9d1d9;border:none;gridline-color:#21262d;")
        self.table.verticalHeader().setVisible(False)
        m.addWidget(self.table)
        self.refresh()
    
    def load(self):
        f = self.data_dir / "watchlist.json"
        if f.exists(): return json.loads(f.read_text())
        return [{"sym": "AAPL", "name": "Apple Inc."}, {"sym": "GOOGL", "name": "Alphabet Inc."}, {"sym": "MSFT", "name": "Microsoft"}, {"sym": "AMZN", "name": "Amazon"}]
    
    def save(self):
        (self.data_dir / "watchlist.json").write_text(json.dumps(self.watchlist))
    
    def refresh(self):
        self.table.setRowCount(len(self.watchlist))
        for i, s in enumerate(self.watchlist):
            price = round(random.uniform(100, 500), 2)
            chg = round(random.uniform(-10, 10), 2)
            pct = round(chg / price * 100, 2)
            color = "#3fb950" if chg >= 0 else "#f85149"
            self.table.setItem(i, 0, QTableWidgetItem(s["sym"]))
            self.table.setItem(i, 1, QTableWidgetItem(f"${price}"))
            c = QTableWidgetItem(f"{'+' if chg >= 0 else ''}{chg}"); c.setForeground(QColor(color))
            self.table.setItem(i, 2, c)
            p = QTableWidgetItem(f"{'+' if pct >= 0 else ''}{pct}%"); p.setForeground(QColor(color))
            self.table.setItem(i, 3, p)
            rm = QPushButton("✕"); rm.clicked.connect(lambda _, idx=i: self.remove(idx))
            self.table.setCellWidget(i, 4, rm)
    
    def add_stock(self):
        sym = self.search.text().upper()
        if sym and not any(s["sym"] == sym for s in self.watchlist):
            self.watchlist.append({"sym": sym, "name": sym}); self.save(); self.refresh()
            self.search.clear()
    
    def remove(self, idx):
        if 0 <= idx < len(self.watchlist):
            del self.watchlist[idx]; self.save(); self.refresh()

if __name__ == "__main__":
    app = QApplication(sys.argv); w = StocksApp(); w.show(); sys.exit(app.exec())
