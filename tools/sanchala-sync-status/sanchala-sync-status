#!/usr/bin/env python3
"""Sanchala Sync Status - Monitor all sync services"""
import json
from datetime import datetime
from pathlib import Path

class SyncStatus:
    def __init__(self):
        self.base=Path(__file__).parent
        self.services=self.base/"services";self.services.mkdir(parents=True,exist_ok=True)
        self.logs=self.base/"logs";self.logs.mkdir(exist_ok=True)
        self.data=self.base/"lib/status.json";self.base.joinpath("lib").mkdir(exist_ok=True)
        self.state=json.load(open(self.data))if self.data.exists()else{"services":{},"history":[]}
        self._init_services()
    def _save(self):json.dump(self.state,open(self.data,'w'),indent=2)
    def _init_services(self):
        defaults={"settings":{"name":"Settings Sync","icon":"⚙️"},"files":{"name":"File Sync","icon":"📁"},
            "photos":{"name":"Photos","icon":"📷"},"contacts":{"name":"Contacts","icon":"👤"},
            "calendar":{"name":"Calendar","icon":"📅"},"mail":{"name":"Mail","icon":"✉️"},
            "passwords":{"name":"Passwords","icon":"🔐"},"bookmarks":{"name":"Bookmarks","icon":"🔖"}}
        for k,v in defaults.items():
            if k not in self.state["services"]:
                self.state["services"][k]={**v,"status":"idle","last_sync":None,"enabled":True,"errors":0}
    def update_status(self,service,status,details=None):
        if service not in self.state["services"]:return{"success":False}
        self.state["services"][service]["status"]=status
        if status=="synced":self.state["services"][service]["last_sync"]=datetime.now().isoformat()
        if status=="error":self.state["services"][service]["errors"]+=1
        self.state["history"].append({"service":service,"status":status,"time":datetime.now().isoformat(),"details":details})
        if len(self.state["history"])>100:self.state["history"]=self.state["history"][-100:]
        self._save();return{"success":True}
    def get_status(self,service=None):
        if service:return self.state["services"].get(service)
        return self.state["services"]
    def get_summary(self):
        svcs=self.state["services"].values()
        return{"total":len(svcs),"synced":len([s for s in svcs if s["status"]=="synced"]),
            "syncing":len([s for s in svcs if s["status"]=="syncing"]),
            "errors":len([s for s in svcs if s["status"]=="error"]),
            "idle":len([s for s in svcs if s["status"]=="idle"])}
    def enable_service(self,service,enabled=True):
        if service in self.state["services"]:self.state["services"][service]["enabled"]=enabled;self._save()
        return{"success":True}
    def sync_all(self):
        for s in self.state["services"]:self.update_status(s,"syncing")
        for s in self.state["services"]:self.update_status(s,"synced")
        return{"success":True,"synced":len(self.state["services"])}
    def get_history(self,limit=20):return self.state["history"][-limit:]
    def clear_errors(self):
        for s in self.state["services"].values():s["errors"]=0
        self._save();return{"success":True}

if __name__=="__main__":
    import argparse;p=argparse.ArgumentParser();s=p.add_subparsers(dest="c")
    g=s.add_parser("get");g.add_argument("--service")
    u=s.add_parser("update");u.add_argument("--service",required=True);u.add_argument("--status",required=True)
    e=s.add_parser("enable");e.add_argument("--service",required=True);e.add_argument("--enabled",type=bool,default=True)
    s.add_parser("sync-all");s.add_parser("summary");s.add_parser("history");s.add_parser("status")
    a=p.parse_args();ss=SyncStatus()
    if a.c=="get":print(json.dumps(ss.get_status(getattr(a,"service",None)),indent=2))
    elif a.c=="update":print(json.dumps(ss.update_status(a.service,a.status),indent=2))
    elif a.c=="enable":print(json.dumps(ss.enable_service(a.service,a.enabled),indent=2))
    elif a.c=="sync-all":print(json.dumps(ss.sync_all(),indent=2))
    elif a.c=="summary":print(json.dumps(ss.get_summary(),indent=2))
    elif a.c=="history":print(json.dumps(ss.get_history(),indent=2))
    elif a.c=="status":
        sm=ss.get_summary()
        print(f"Sync Status Dashboard\n{'='*40}")
        for k,v in ss.get_status().items():print(f"{v['icon']} {v['name']}: {v['status']}")
        print(f"{'='*40}\nTotal: {sm['total']} | Synced: {sm['synced']} | Errors: {sm['errors']}")
    else:p.print_help()
