#!/usr/bin/env python3
"""Sanchala Feedback - Send Feedback"""
import sys, json
from datetime import datetime
from pathlib import Path
from PyQt6.QtWidgets import *
from PyQt6.QtCore import *
from PyQt6.QtGui import *

class FeedbackApp(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Sanchala Feedback")
        self.setMinimumSize(550, 500)
        self.data_dir = Path.home() / ".local/share/sanchala/feedback"
        self.data_dir.mkdir(parents=True, exist_ok=True)
        self.init_ui()
    
    def init_ui(self):
        self.setStyleSheet("QMainWindow{background:#f8f9fa;}QLabel{color:#333;}QPushButton{background:#007bff;color:#fff;border:none;padding:12px 24px;border-radius:6px;}QPushButton:hover{background:#0056b3;}QLineEdit,QTextEdit,QComboBox{background:#fff;border:1px solid #ddd;border-radius:6px;padding:10px;}")
        c = QWidget(); self.setCentralWidget(c); m = QVBoxLayout(c)
        m.setContentsMargins(30, 30, 30, 30); m.setSpacing(15)
        
        # Header
        h = QLabel("📣 Send Feedback"); h.setStyleSheet("font-size:24px;font-weight:bold;")
        m.addWidget(h)
        m.addWidget(QLabel("Help us improve SanchalaOS by sharing your thoughts."))
        
        # Type
        m.addWidget(QLabel("Feedback Type:"))
        self.type_combo = QComboBox()
        self.type_combo.addItems(["🐛 Bug Report", "💡 Feature Request", "❓ Question", "👍 Praise", "💬 General Feedback"])
        m.addWidget(self.type_combo)
        
        # Title
        m.addWidget(QLabel("Title:"))
        self.title = QLineEdit(); self.title.setPlaceholderText("Brief summary...")
        m.addWidget(self.title)
        
        # Description
        m.addWidget(QLabel("Description:"))
        self.desc = QTextEdit(); self.desc.setPlaceholderText("Please describe in detail...")
        self.desc.setMinimumHeight(120)
        m.addWidget(self.desc)
        
        # Email
        m.addWidget(QLabel("Email (optional):"))
        self.email = QLineEdit(); self.email.setPlaceholderText("your@email.com")
        m.addWidget(self.email)
        
        # Attachments
        att = QHBoxLayout()
        att.addWidget(QLabel("Attachments:"))
        self.att_btn = QPushButton("📎 Add File"); self.att_btn.setStyleSheet("background:#6c757d;")
        self.att_btn.clicked.connect(self.add_attachment)
        att.addWidget(self.att_btn); att.addStretch()
        m.addLayout(att)
        self.att_list = QListWidget(); self.att_list.setMaximumHeight(60)
        m.addWidget(self.att_list)
        
        # System info
        self.sys_info = QCheckBox("Include system information")
        self.sys_info.setChecked(True)
        m.addWidget(self.sys_info)
        
        # Buttons
        btns = QHBoxLayout()
        btns.addStretch()
        cancel = QPushButton("Cancel"); cancel.setStyleSheet("background:#6c757d;")
        cancel.clicked.connect(self.close)
        submit = QPushButton("📤 Submit Feedback"); submit.clicked.connect(self.submit)
        btns.addWidget(cancel); btns.addWidget(submit)
        m.addLayout(btns)
    
    def add_attachment(self):
        files, _ = QFileDialog.getOpenFileNames(self, "Add Attachments")
        for f in files:
            self.att_list.addItem(Path(f).name)
    
    def submit(self):
        if not self.title.text() or not self.desc.toPlainText():
            QMessageBox.warning(self, "Missing Info", "Please fill in title and description.")
            return
        
        feedback = {
            "type": self.type_combo.currentText(),
            "title": self.title.text(),
            "description": self.desc.toPlainText(),
            "email": self.email.text(),
            "timestamp": datetime.now().isoformat(),
            "include_sys": self.sys_info.isChecked()
        }
        
        f = self.data_dir / f"feedback_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
        f.write_text(json.dumps(feedback, indent=2))
        
        QMessageBox.information(self, "Thank You!", "Your feedback has been submitted.\nWe appreciate your input!")
        self.close()

if __name__ == "__main__":
    app = QApplication(sys.argv); w = FeedbackApp(); w.show(); sys.exit(app.exec())
