#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0
# Sanchala Privacy Dashboard - Privacy Controls Center
set -euo pipefail

VERSION="1.0.0"
STATE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/sanchala/privacy"

RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[1;33m' BLUE='\033[0;34m' NC='\033[0m'

mkdir -p "$STATE_DIR"

cmd_status() {
    echo -e "${BLUE}Privacy Dashboard${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    
    echo -n "Location Services: "
    [[ -f "$STATE_DIR/location_off" ]] && echo -e "${GREEN}OFF${NC}" || echo -e "${YELLOW}ON${NC}"
    
    echo -n "Camera Access: "
    [[ -f "$STATE_DIR/camera_off" ]] && echo -e "${GREEN}Blocked${NC}" || echo -e "${YELLOW}Allowed${NC}"
    
    echo -n "Microphone Access: "
    [[ -f "$STATE_DIR/mic_off" ]] && echo -e "${GREEN}Blocked${NC}" || echo -e "${YELLOW}Allowed${NC}"
    
    echo -n "Telemetry: "
    [[ -f "$STATE_DIR/telemetry_off" ]] && echo -e "${GREEN}Disabled${NC}" || echo -e "${YELLOW}Enabled${NC}"
}

cmd_location() {
    case "${1:-status}" in
        on) rm -f "$STATE_DIR/location_off"; echo -e "${YELLOW}⚠ Location enabled${NC}" ;;
        off) touch "$STATE_DIR/location_off"; echo -e "${GREEN}✓ Location disabled${NC}" ;;
        *) [[ -f "$STATE_DIR/location_off" ]] && echo "OFF" || echo "ON" ;;
    esac
}

cmd_camera() {
    case "${1:-status}" in
        on) rm -f "$STATE_DIR/camera_off"; sudo modprobe uvcvideo 2>/dev/null; echo -e "${YELLOW}⚠ Camera enabled${NC}" ;;
        off) touch "$STATE_DIR/camera_off"; sudo modprobe -r uvcvideo 2>/dev/null; echo -e "${GREEN}✓ Camera disabled${NC}" ;;
        *) [[ -f "$STATE_DIR/camera_off" ]] && echo "Blocked" || echo "Allowed" ;;
    esac
}

cmd_mic() {
    case "${1:-status}" in
        on) rm -f "$STATE_DIR/mic_off"; pactl set-source-mute @DEFAULT_SOURCE@ 0 2>/dev/null; echo -e "${YELLOW}⚠ Mic enabled${NC}" ;;
        off) touch "$STATE_DIR/mic_off"; pactl set-source-mute @DEFAULT_SOURCE@ 1 2>/dev/null; echo -e "${GREEN}✓ Mic muted${NC}" ;;
        *) [[ -f "$STATE_DIR/mic_off" ]] && echo "Muted" || echo "Active" ;;
    esac
}

cmd_telemetry() {
    if [[ "${1:-off}" == "off" ]]; then
        touch "$STATE_DIR/telemetry_off"
        systemctl --user stop tracker-miner-fs-3 2>/dev/null || true
        echo -e "${GREEN}✓ Telemetry disabled${NC}"
    else
        rm -f "$STATE_DIR/telemetry_off"
        echo -e "${YELLOW}⚠ Telemetry enabled${NC}"
    fi
}

case "${1:-status}" in
    status) cmd_status ;; location) cmd_location "${2:-status}" ;;
    camera) cmd_camera "${2:-status}" ;; mic|microphone) cmd_mic "${2:-status}" ;;
    telemetry) cmd_telemetry "${2:-off}" ;;
    lockdown) cmd_camera off; cmd_mic off; cmd_location off; cmd_telemetry off ;;
    *) echo "Usage: sanchala-privacy-dashboard {status|location|camera|mic|telemetry} [on|off]" ;;
esac
