#!/bin/bash
# SANCHALA-COLOR-BLIND - Color Vision Accessibility for Sanchala OS
# WCAG 2.1 AAA Compliant | Copyright (c) 2025 Sanchala OS Project
set -euo pipefail

VERSION="1.0.0"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/sanchala/accessibility"
CONFIG_FILE="$CONFIG_DIR/color-blind.conf"

declare -A CVD=([enabled]=false [type]=deuteranopia [intensity]=100 [filter]=simulate)

mkdir -p "$CONFIG_DIR"

load_config() { [[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE"; }
save_config() { declare -p CVD > "$CONFIG_FILE"; }

# Color transformation matrices for different CVD types
get_matrix() {
    local type="$1" mode="$2"
    case "$type" in
        protanopia)  # Red-blind
            [[ "$mode" == "simulate" ]] && echo "0.567,0.433,0,0,0.558,0.442,0,0,0,0.242,0.758,0,0,0,0,1" || \
            echo "0.817,0.183,0,0,0.333,0.667,0,0,0,0.125,0.875,0,0,0,0,1" ;;
        deuteranopia)  # Green-blind
            [[ "$mode" == "simulate" ]] && echo "0.625,0.375,0,0,0.7,0.3,0,0,0,0.3,0.7,0,0,0,0,1" || \
            echo "0.8,0.2,0,0,0.258,0.742,0,0,0,0.142,0.858,0,0,0,0,1" ;;
        tritanopia)  # Blue-blind
            [[ "$mode" == "simulate" ]] && echo "0.95,0.05,0,0,0,0.433,0.567,0,0,0.475,0.525,0,0,0,0,1" || \
            echo "0.967,0.033,0,0,0,0.733,0.267,0,0,0.183,0.817,0,0,0,0,1" ;;
        achromatopsia)  # Total color blindness
            echo "0.299,0.587,0.114,0,0.299,0.587,0.114,0,0.299,0.587,0.114,0,0,0,0,1" ;;
    esac
}

apply_gnome_filter() {
    local type="${CVD[type]}" filter="${CVD[filter]}"
    
    # Enable color filters in GNOME
    gsettings set org.gnome.desktop.a11y.interface colorblind-filter-type "$type" 2>/dev/null ||:
    gsettings set org.gnome.desktop.a11y.interface colorblind-filter-enabled true 2>/dev/null ||:
}

apply_kde_filter() {
    local type="${CVD[type]}"
    kwriteconfig5 --file kwinrc --group Effect-ColorCorrection --key Enabled true 2>/dev/null ||:
    kwriteconfig5 --file kwinrc --group Effect-ColorCorrection --key Mode "$type" 2>/dev/null ||:
    qdbus org.kde.KWin /KWin reconfigure 2>/dev/null ||:
}

apply_compiz_filter() {
    local matrix=$(get_matrix "${CVD[type]}" "${CVD[filter]}")
    # For compiz negative/color filter plugin
    dconf write /org/compiz/profiles/unity/plugins/colorfilter/enabled true 2>/dev/null ||:
}

apply_xrandr_gamma() {
    # Basic gamma adjustment as fallback
    local output=$(xrandr | grep " connected" | head -1 | cut -d' ' -f1)
    case "${CVD[type]}" in
        protanopia) xrandr --output "$output" --gamma 0.8:1:1 2>/dev/null ||: ;;
        deuteranopia) xrandr --output "$output" --gamma 1:0.8:1 2>/dev/null ||: ;;
        tritanopia) xrandr --output "$output" --gamma 1:1:0.8 2>/dev/null ||: ;;
    esac
}

enable_filter() {
    load_config
    CVD[enabled]="true"; save_config
    
    echo "Enabling ${CVD[type]} ${CVD[filter]} filter..."
    
    # Try multiple backends
    apply_gnome_filter || apply_kde_filter || apply_xrandr_gamma
    
    echo "Color blind filter enabled: ${CVD[type]} (${CVD[filter]} mode)"
}

disable_filter() {
    CVD[enabled]="false"; save_config
    
    gsettings set org.gnome.desktop.a11y.interface colorblind-filter-enabled false 2>/dev/null ||:
    kwriteconfig5 --file kwinrc --group Effect-ColorCorrection --key Enabled false 2>/dev/null ||:
    
    local output=$(xrandr | grep " connected" | head -1 | cut -d' ' -f1)
    xrandr --output "$output" --gamma 1:1:1 2>/dev/null ||:
    
    echo "Color blind filter disabled"
}

set_type() {
    case "$1" in
        protanopia|deuteranopia|tritanopia|achromatopsia|protanomaly|deuteranomaly|tritanomaly)
            CVD[type]="$1"; save_config; [[ "${CVD[enabled]}" == "true" ]] && enable_filter ;;
        *) echo "Types: protanopia, deuteranopia, tritanopia, achromatopsia"; return 1 ;;
    esac
}

status() {
    load_config
    echo "Color Blind Mode: ${CVD[enabled]}"
    echo "  Type: ${CVD[type]} | Filter: ${CVD[filter]} | Intensity: ${CVD[intensity]}%"
}

case "${1:-status}" in
    enable|on) enable_filter ;; disable|off) disable_filter ;; status) status ;;
    toggle) [[ "${CVD[enabled]}" == "true" ]] && disable_filter || enable_filter ;;
    --type|-t) set_type "$2" ;;
    --filter) CVD[filter]="$2"; save_config ;;
    --intensity) CVD[intensity]="$2"; save_config ;;
    --help|-h) echo "Usage: sanchala-color-blind {enable|disable|toggle|--type protanopia|deuteranopia|tritanopia}" ;;
    --version|-v) echo "v$VERSION" ;; *) echo "Unknown: $1"; exit 1 ;;
esac
