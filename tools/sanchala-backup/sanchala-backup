#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0
# Sanchala Backup - Time Machine-like Backup Tool for Sanchala OS

set -euo pipefail

VERSION="1.0.0"
PROGRAM_NAME="sanchala-backup"
CONFIG_FILE="/etc/sanchala/backup.toml"
STATE_DIR="/var/lib/sanchala/backup"
LOG_FILE="/var/log/sanchala/backup.log"

# Colors
RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[1;33m'
BLUE='\033[0;34m' CYAN='\033[0;36m' NC='\033[0m' BOLD='\033[1m'

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
for lib in config snapshot restore remote utils; do
    [[ -f "${SCRIPT_DIR}/lib/${lib}.sh" ]] && source "${SCRIPT_DIR}/lib/${lib}.sh"
done

print_info() { echo -e "${BLUE}ℹ $1${NC}"; }
print_success() { echo -e "${GREEN}✓ $1${NC}"; }
print_warning() { echo -e "${YELLOW}⚠ $1${NC}"; }
print_error() { echo -e "${RED}✗ $1${NC}"; }

show_version() { echo "$PROGRAM_NAME $VERSION - Sanchala OS"; }

show_help() {
    cat << 'EOF'
SANCHALA BACKUP - Time Machine-like Backup for Sanchala OS

USAGE: sanchala-backup <COMMAND> [OPTIONS]

SNAPSHOT COMMANDS:
    list                    List all snapshots
    create [DESC]           Create manual snapshot
    delete <ID>             Delete snapshot
    info <ID>               Show snapshot details
    compare <ID1> <ID2>     Compare two snapshots
    browse <ID> [PATH]      Browse snapshot contents

RECOVERY COMMANDS:
    restore <ID> [PATH]     Restore file/directory from snapshot
    rollback <ID>           Schedule full system rollback (reboot required)
    boot-entry <ID>         Add snapshot to GRUB boot menu

REMOTE BACKUP:
    remote list             List configured remote targets
    remote add              Add new remote backup target
    remote backup [NAME]    Run backup to remote target
    remote status           Show remote backup status

CLOUD SYNC (rclone):
    cloud setup             Configure cloud backup
    cloud sync              Sync to cloud storage
    cloud status            Show cloud sync status

SYSTEM:
    status                  Show backup system status
    schedule                Show/configure backup schedule
    cleanup                 Clean old snapshots
    verify                  Verify snapshot integrity

OPTIONS:
    -c, --config <NAME>     Snapper config (root, home)
    -d, --description       Snapshot description
    --json                  JSON output format
    -h, --help              Show this help

EXAMPLES:
    sanchala-backup create "Before update"
    sanchala-backup restore 42 /etc/fstab
    sanchala-backup rollback 35
    sanchala-backup cloud setup gdrive
EOF
}

check_root() {
    [[ $EUID -eq 0 ]] || { print_error "Root required. Use: sudo $PROGRAM_NAME $*"; exit 1; }
}

main() {
    local config="root" json=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -c|--config) config="$2"; shift 2 ;;
            --json) json=true; shift ;;
            -h|--help) show_help; exit 0 ;;
            --version) show_version; exit 0 ;;
            -*) print_error "Unknown: $1"; exit 1 ;;
            *) break ;;
        esac
    done

    local cmd="${1:-help}"; shift || true
    case "$cmd" in
        list) cmd_list_snapshots "$config" "$json" "$@" ;;
        create|snapshot) check_root; cmd_create_snapshot "$config" "$@" ;;
        delete) check_root; cmd_delete_snapshot "$config" "$@" ;;
        info) cmd_snapshot_info "$config" "$@" ;;
        compare) cmd_compare_snapshots "$config" "$@" ;;
        browse) cmd_browse_snapshot "$config" "$@" ;;
        restore) check_root; cmd_restore "$config" "$@" ;;
        rollback) check_root; cmd_rollback "$config" "$@" ;;
        boot-entry) check_root; cmd_boot_entry "$@" ;;
        remote) cmd_remote "$@" ;;
        cloud) cmd_cloud "$@" ;;
        status) cmd_status "$json" ;;
        schedule) cmd_schedule "$@" ;;
        cleanup) check_root; cmd_cleanup "$config" "$@" ;;
        verify) cmd_verify "$config" "$@" ;;
        help) show_help ;;
        *) print_error "Unknown: $cmd"; show_help; exit 1 ;;
    esac
}

main "$@"
