[Protocol]
exec=kio_dropbox
protocol=dropbox
input=none
output=filesystem
listing=Name,Type,Size,Date,AccessDate,MimeType
reading=true
writing=true
makedir=true
deleting=true
moving=true
linking=false
Icon=dropbox
maxInstances=10
maxInstancesPerHost=10
defaultMimetype=inode/directory
Class=:internet
ProxiedBy=dropbox
X-Plasma-Protocol=true
Description=Dropbox
Description[id]=Dropbox
