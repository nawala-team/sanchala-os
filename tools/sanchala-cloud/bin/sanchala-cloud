#!/usr/bin/env bash
# Sanchala Cloud - Main CLI Tool
# Native cloud storage management for Sanchala OS

set -euo pipefail

VERSION="1.0.0"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/sanchala-cloud"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/sanchala-cloud"
CLOUD_ROOT="$HOME/Cloud"
RCLONE_CONFIG="$CONFIG_DIR/rclone.conf"

RED='\033[0;31m'; GREEN='\033[0;32m'; BLUE='\033[0;34m'; NC='\033[0m'
log_info() { echo -e "${BLUE}[INFO]${NC} $*"; }
log_success() { echo -e "${GREEN}[OK]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

show_help() {
    cat << 'EOF'
Sanchala Cloud - Native Cloud Storage Integration

USAGE: sanchala-cloud <COMMAND> [OPTIONS]

COMMANDS:
    add <provider>    Add cloud account (gdrive|dropbox|onedrive|nextcloud|mega|s3|webdav|sftp)
    remove <name>     Remove a cloud account
    list              List configured accounts
    sync [name]       Force sync (all or specific account)
    status [name]     Show sync status
    mount <name>      Mount cloud storage via FUSE
    unmount <name>    Unmount cloud storage
    pin <path>        Pin file/folder for offline access
    unpin <path>      Remove offline pin

EXAMPLES:
    sanchala-cloud add gdrive
    sanchala-cloud sync "Google_Drive"
    sanchala-cloud pin ~/Cloud/GoogleDrive/Documents

OPTIONS:
    -h, --help      Show this help
    -v, --version   Show version
EOF
}

init_dirs() { mkdir -p "$CONFIG_DIR" "$DATA_DIR" "$CLOUD_ROOT"; chmod 700 "$CONFIG_DIR"; }

get_provider() {
    case "$1" in
        gdrive)    echo "Google Drive|drive" ;;
        dropbox)   echo "Dropbox|dropbox" ;;
        onedrive)  echo "OneDrive|onedrive" ;;
        nextcloud) echo "Nextcloud|webdav" ;;
        mega)      echo "MEGA|mega" ;;
        s3)        echo "Amazon S3|s3" ;;
        webdav)    echo "WebDAV|webdav" ;;
        sftp)      echo "SFTP|sftp" ;;
        *) log_error "Unknown provider: $1"; exit 1 ;;
    esac
}

cmd_add() {
    [[ -z "${1:-}" ]] && { log_error "Usage: sanchala-cloud add <provider>"; exit 1; }
    local info; info=$(get_provider "$1")
    local name rtype; IFS='|' read -r name rtype <<< "$info"
    local remote; remote=$(echo "$name" | tr ' ' '_')
    
    log_info "Adding $name account..."
    rclone config create "$remote" "$rtype" --config "$RCLONE_CONFIG"
    
    if rclone listremotes --config "$RCLONE_CONFIG" | grep -q "^${remote}:$"; then
        mkdir -p "$CLOUD_ROOT/$remote"
        log_success "$name added! Mount: $CLOUD_ROOT/$remote"
    else
        log_error "Failed to add account"; exit 1
    fi
}

cmd_list() {
    [[ ! -f "$RCLONE_CONFIG" ]] && { echo "No accounts. Use 'sanchala-cloud add'"; return; }
    printf "%-20s %-12s %-10s\n" "NAME" "TYPE" "STATUS"
    rclone listremotes --config "$RCLONE_CONFIG" | while read -r r; do
        r="${r%:}"
        local t; t=$(rclone config show "$r" --config "$RCLONE_CONFIG" | grep "^type" | cut -d= -f2)
        printf "%-20s %-12s %-10s\n" "$r" "$t" "ready"
    done
}

cmd_sync() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        rclone listremotes --config "$RCLONE_CONFIG" | while read -r r; do
            r="${r%:}"; log_info "Syncing $r..."
            rclone bisync "$r:" "$CLOUD_ROOT/$r" --config "$RCLONE_CONFIG" --resilient
        done
    else
        rclone bisync "$name:" "$CLOUD_ROOT/$name" --config "$RCLONE_CONFIG" --resilient
    fi
    log_success "Sync complete"
}

cmd_mount() {
    [[ -z "${1:-}" ]] && { log_error "Usage: sanchala-cloud mount <name>"; exit 1; }
    mkdir -p "$CLOUD_ROOT/$1"
    rclone mount "$1:" "$CLOUD_ROOT/$1" --config "$RCLONE_CONFIG" --vfs-cache-mode full --daemon
    log_success "Mounted $1 at $CLOUD_ROOT/$1"
}

cmd_unmount() {
    [[ -z "${1:-}" ]] && { log_error "Usage: sanchala-cloud unmount <name>"; exit 1; }
    fusermount -u "$CLOUD_ROOT/$1" && log_success "Unmounted $1"
}

cmd_status() {
    systemctl --user is-active sanchala-cloudd &>/dev/null && echo "Daemon: Running" || echo "Daemon: Stopped"
    cmd_list
}

main() {
    init_dirs
    case "${1:-}" in
        add)     shift; cmd_add "$@" ;;
        remove)  shift; rclone config delete "$1" --config "$RCLONE_CONFIG" ;;
        list|ls) cmd_list ;;
        sync)    shift; cmd_sync "$@" ;;
        status)  cmd_status ;;
        mount)   shift; cmd_mount "$@" ;;
        unmount) shift; cmd_unmount "$@" ;;
        pin)     shift; setfattr -n user.sanchala.pinned -v "true" "$1" ;;
        unpin)   shift; setfattr -x user.sanchala.pinned "$1" ;;
        -v|--version) echo "sanchala-cloud $VERSION" ;;
        *) show_help ;;
    esac
}

main "$@"
